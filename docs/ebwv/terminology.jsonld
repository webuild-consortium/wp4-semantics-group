            },
            "skos:prefLabel": {
                "@id": "urn:uuid:a8cf56c9-f1f4-43a9-bcbb-a6d113086ecb"
            },
            "skos:note": {
                "@language": "en",
                "@value": "Postal addresses are usually formed according to a specific postal addressing system, which tends to be nationally specified and unique."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "an addresss to which mail can be sent"
            },
            "skos:broader": {
                "@id": "webuild:concept-4"
            },
            "http://purl.org/termed/properties/id": "c3e1393d-a6e1-451f-a9f4-a84a7ddc7cda",
