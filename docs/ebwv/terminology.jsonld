            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "site of work"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "urn:uuid:974c0a4a-840a-458f-971b-8ff4c98eb2d7",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "work location"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "urn:uuid:ab4596a9-c0b1-4217-96b8-84a37c80c6de",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "workplace"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "webuild:placeofwork",
            "term:orderedSynonym": {
                "@list": [
                    {
                        "@id": "urn:uuid:ab4596a9-c0b1-4217-96b8-84a37c80c6de"
                    },
                    {
                        "@id": "urn:uuid:974c0a4a-840a-458f-971b-8ff4c98eb2d7"
                    },
                    {
                        "@id": "urn:uuid:6e3c6430-a1df-4998-8eff-4c20826bc035"
                    },
                    {
                        "@id": "urn:uuid:d936318b-ae72-4c8b-8486-270260979c68"
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "In the Posted Worker Notification context, place of work denotes the location in the host country where the posted worker will carry out the posted work. It may be a construction site, office, factory, vessel, service location, client premises, branch, establishment or another identifiable work site. The concept should be distinguished from the worker’s domicile or residence, the employer’s registered address, the host entity’s registered address, and the administrative address used for correspondence. Where the work is performed at several locations, the notification may need to list multiple places of work or describe the area or route of work."
                    }
                ]
            },
            "@type": "skos:Concept",
            "dcterms:created": {
                "@value": "2026-04-28T14:44:57.898Z",
                "@type": "xsd:dateTime"
            },
            "dcterms:modified": {
                "@value": "2026-04-28T14:44:57.898Z",
                "@type": "xsd:dateTime"
            },
            "skos:altLabel": [
                {
                    "@id": "urn:uuid:d936318b-ae72-4c8b-8486-270260979c68"
                },
                {
                    "@id": "urn:uuid:6e3c6430-a1df-4998-8eff-4c20826bc035"
                },
                {
                    "@id": "urn:uuid:974c0a4a-840a-458f-971b-8ff4c98eb2d7"
                },
                {
                    "@id": "urn:uuid:ab4596a9-c0b1-4217-96b8-84a37c80c6de"
                }
            ],
            "skos:definition": {
                "@language": "en",
                "@value": "the location where a worker performs, is expected to perform, or is assigned to perform work during an employment, posting or work assignment"
            },
            "skos:example": {
                "@language": "en",
                "@value": "A Posted Worker Notification states that the worker’s place of work is a construction site operated by the host entity in Antwerp, Belgium."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:note": {
                "@language": "en",
                "@value": "In the Posted Worker Notification context, place of work denotes the location in the host country where the posted worker will carry out the posted work. It may be a construction site, office, factory, vessel, service location, client premises, branch, establishment or another identifiable work site. The concept should be distinguished from the worker’s domicile or residence, the employer’s registered address, the host entity’s registered address, and the administrative address used for correspondence. Where the work is performed at several locations, the notification may need to list multiple places of work or describe the area or route of work."
            },
            "skos:prefLabel": {
                "@id": "urn:uuid:a22da038-f911-47fc-95b7-79be7d7ef8ea"
            },
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "term:orderedExample": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "A Posted Worker Notification states that the worker’s place of work is a construction site operated by the host entity in Antwerp, Belgium."
                    }
                ]
            }
        },
        {
            "@id": "urn:uuid:a22da038-f911-47fc-95b7-79be7d7ef8ea",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "place of work"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "webuild:placeofbirth",
            "term:orderedSynonym": {
                "@list": [
                    {
                        "@id": "urn:uuid:20283923-7f34-45f9-9c3c-4f3a6841cf79"
                    },
                    {
                        "@id": "urn:uuid:b26c663e-9861-4d63-ad24-cad6cc7802b1"
                    },
                    {
                        "@id": "urn:uuid:85bd8c78-7c60-4ec8-b460-f2677767225e"
                    },
                    {
                        "@id": "urn:uuid:53cfd7af-d6ad-4e90-97ef-bcec9052e0b3"
                    }
                ]
            },
            "term:orderedRelated": {
                "@list": [
                    {
                        "@id": "webuild:person"
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "In the EBWV context, place of birth should be used for the officially recorded or attested location of a person’s birth. The value may be represented as a structured location, such as a municipality, city, region or other named place, and may be supported by a geographic identifier. It should be distinguished from country of birth, which identifies only the country, and from domicile, residence or address, which describe where the person lives or is treated as living."
                    }
                ]
            },
            "term:orderedExample": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "A person identification attestation states that the person’s place of birth is Helsinki, Finland."
                    }
                ]
            },
            "@type": "skos:Concept",
            "dcterms:created": {
                "@value": "2026-04-28T14:41:22.938Z",
                "@type": "xsd:dateTime"
            },
            "dcterms:modified": {
                "@value": "2026-04-28T14:41:42.981Z",
                "@type": "xsd:dateTime"
            },
            "skos:altLabel": [
                {
                    "@id": "urn:uuid:53cfd7af-d6ad-4e90-97ef-bcec9052e0b3"
                },
                {
                    "@id": "urn:uuid:20283923-7f34-45f9-9c3c-4f3a6841cf79"
                },
                {
                    "@id": "urn:uuid:b26c663e-9861-4d63-ad24-cad6cc7802b1"
                },
                {
                    "@id": "urn:uuid:85bd8c78-7c60-4ec8-b460-f2677767225e"
                }
            ],
            "skos:definition": {
                "@language": "en",
                "@value": "the location where a person was born"
            },
            "skos:example": {
                "@language": "en",
                "@value": "A person identification attestation states that the person’s place of birth is Helsinki, Finland."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:note": {
                "@language": "en",
                "@value": "In the EBWV context, place of birth should be used for the officially recorded or attested location of a person’s birth. The value may be represented as a structured location, such as a municipality, city, region or other named place, and may be supported by a geographic identifier. It should be distinguished from country of birth, which identifies only the country, and from domicile, residence or address, which describe where the person lives or is treated as living."
            },
            "skos:prefLabel": {
                "@id": "urn:uuid:94efcb37-30a1-45df-9c85-c30cb900adfd"
            },
            "skos:related": {
                "@id": "webuild:person"
            },
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            }
        },
        {
            "@id": "webuild:placeofdeath",
            "term:orderedRelated": {
                "@list": [
                    {
                        "@id": "webuild:placeofbirth"
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "The place of death may be expressed as an address, geographic location, administrative area, healthcare facility, or other identifiable place. It should be distinguished from the place where the death was registered and from the deceased person’s residence or domicile at the time of death."
                    }
                ]
            },
            "term:orderedBroader": {
                "@list": [
                    {
                        "@id": "webuild:concept-86"
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:related": {
                "@id": "webuild:placeofbirth"
            },
            "skos:prefLabel": {
                "@id": "urn:uuid:78420860-61d1-48b2-8fc0-e0aa224d03f7"
            },
            "skos:note": {
                "@language": "en",
                "@value": "The place of death may be expressed as an address, geographic location, administrative area, healthcare facility, or other identifiable place. It should be distinguished from the place where the death was registered and from the deceased person’s residence or domicile at the time of death."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "the location where a natural person’s death occurred"
            },
            "skos:broader": {
                "@id": "webuild:concept-86"
            },
