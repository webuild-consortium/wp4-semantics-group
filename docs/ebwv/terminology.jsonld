            "@type": "skos:Concept"
        },
        {
            "@id": "webuild:vessel",
            "term:orderedSynonym": {
                "@list": [
                    {
                        "@id": "urn:uuid:487252f7-64f0-4ea9-9ea9-14b6561a16b6"
                    }
                ]
            },
            "term:orderedRelated": {
                "@list": [
                    {
                        "@id": "webuild:flagstate"
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "A vessel may include a ship, boat, barge or other navigable craft, irrespective of its purpose, propulsion method or whether it operates at sea or on inland waterways. In the EBWV context, a vessel may constitute a workplace or place of employment and may be identified by attributes such as its name, registration or IMO number and flag state. Whether offshore installations, floating platforms or permanently moored structures are treated as vessels depends on the applicable legislation or application profile."
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:related": {
                "@id": "webuild:flagstate"
            },
            "skos:prefLabel": {
                "@id": "urn:uuid:b48c907e-8e00-49a7-b03c-6addd121647b"
            },
            "skos:note": {
                "@language": "en",
                "@value": "A vessel may include a ship, boat, barge or other navigable craft, irrespective of its purpose, propulsion method or whether it operates at sea or on inland waterways. In the EBWV context, a vessel may constitute a workplace or place of employment and may be identified by attributes such as its name, registration or IMO number and flag state. Whether offshore installations, floating platforms or permanently moored structures are treated as vessels depends on the applicable legislation or application profile."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "a watercraft used or capable of being used for navigation, transport, work or other operations on water"
            },
            "skos:altLabel": {
                "@id": "urn:uuid:487252f7-64f0-4ea9-9ea9-14b6561a16b6"
            },
