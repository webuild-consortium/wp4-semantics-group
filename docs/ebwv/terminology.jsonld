            "@type": "skos:Concept"
        },
        {
            "@id": "urn:uuid:37e77d0d-ad8c-438a-8b3a-8683e2a4cd85",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "Legal Person Identification Data"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "webuild:legalPersonIdentificationData",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "f7193db9-3c93-4d56-9d57-d5c3f1132fe9",
            "suomi-meta:creator": "f7193db9-3c93-4d56-9d57-d5c3f1132fe9",
            "skos:prefLabel": {
                "@id": "urn:uuid:37e77d0d-ad8c-438a-8b3a-8683e2a4cd85"
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "a set of data that enables the establishment of the identity of a legal person and that is issued by a LPID provider. The LPID is the credential subject of an LPID-Credential. A LPID credential allows a legal person to authenticate against a relying party."
            },
            "dcterms:modified": {
                "@value": "2026-01-12T16:28:32.455Z",
                "@type": "xsd:dateTime"
            },
            "dcterms:created": {
                "@value": "2026-01-12T16:28:32.455Z",
                "@type": "xsd:dateTime"
            },
            "@type": "skos:Concept"
        },
        {
            "@id": "webuild:concept-100",
            "term:orderedSynonym": {
                "@list": [
                    {
                        "@id": "urn:uuid:38d50945-6756-45eb-966b-e8668571d25d"
                    }
                ]
            },
            "term:orderedRelated": {
                "@list": [
                    {
                        "@id": "webuild:concept-7"
                    },
                    {
                        "@id": "webuild:concept-14"
                    },
                    {
                        "@id": "webuild:concept-98"
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "At minimum, the \"EBWOID\" includes legal name + one or more legal identifiers (e.g., EUID or national identifier), and may include additional matching attributes under policy."
                    }
                ]
            },
            "@type": "skos:Concept",
            "dcterms:created": {
                "@value": "2025-12-04T13:05:46.444Z",
                "@type": "xsd:dateTime"
            },
            "dcterms:modified": {
                "@value": "2026-01-23T14:58:21.848Z",
                "@type": "xsd:dateTime"
            },
            "skos:altLabel": {
                "@id": "urn:uuid:38d50945-6756-45eb-966b-e8668571d25d"
            },
            "skos:broader": {
                "@id": "webuild:concept-93"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "a set of data that enables the establishment of the identity of a European Business Wallet owner and that is issued by a provider of European Business Wallet owner identification data"
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:note": {
                "@language": "en",
                "@value": "At minimum, the \"EBWOID\" includes legal name + one or more legal identifiers (e.g., EUID or national identifier), and may include additional matching attributes under policy."
            },
            "skos:prefLabel": {
                "@id": "urn:uuid:346cac64-695d-436e-a8b4-daba8723e44d"
            },
            "skos:related": [
                {
                    "@id": "webuild:concept-98"
                },
                {
                    "@id": "webuild:concept-7"
                },
                {
                    "@id": "webuild:concept-14"
                }
            ],
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "term:orderedBroader": {
                "@list": [
                    {
                        "@id": "webuild:concept-93"
                    }
                ]
            }
        },
        {
            "@id": "webuild:concept-98",
            "term:orderedRelated": {
                "@list": [
                    {
                        "@id": "webuild:concept-94"
                    },
                    {
                        "@id": "webuild:concept-96"
                    },
                    {
                        "@id": "webuild:concept-100"
                    },
                    {
                        "@id": "webuild:concept-6006"
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "It is important to notice that this concept does not refer to the ultimate beneficial owner of the economic operator but only to the economic operator entity that controls the instance of the wallet."
                    }
                ]
            },
            "@type": "skos:Concept",
            "dcterms:created": {
                "@value": "2025-12-04T12:57:50.496Z",
                "@type": "xsd:dateTime"
            },
            "dcterms:modified": {
                "@value": "2026-01-23T15:10:44.566Z",
                "@type": "xsd:dateTime"
            },
            "skos:broader": {
                "@id": "webuild:concept-6006"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "an economic operator or public sector body that owns, or has a right of use of, a European Business Wallet under the regulation"
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:note": {
                "@language": "en",
                "@value": "It is important to notice that this concept does not refer to the ultimate beneficial owner of the economic operator but only to the economic operator entity that controls the instance of the wallet."
            },
            "skos:prefLabel": {
                "@id": "urn:uuid:e734dc6d-3e88-41e8-8b77-620971460acc"
            },
            "skos:related": [
