        {
            "@id": "webuild:buyer",
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "Buyer is a transaction-specific role that may be performed by a person or organisation. The buyer is not necessarily the same party as the customer, order originator, invoicee, payer, consignee or end user."
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:prefLabel": {
                "@id": "urn:uuid:1e64db4d-db40-43e1-a8c3-a4cbe7b155c9"
            },
            "skos:note": {
                "@language": "en",
                "@value": "Buyer is a transaction-specific role that may be performed by a person or organisation. The buyer is not necessarily the same party as the customer, order originator, invoicee, payer, consignee or end user."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "the role of a party that purchases or is responsible for purchasing goods, services or works, either for itself or on behalf of another party"
            },
            "dcterms:modified": {
                "@value": "2026-08-10T09:30:12.222Z",
