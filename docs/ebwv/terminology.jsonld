        },
        {
            "@id": "webuild:reportingmonth",
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "The reporting month identifies the reference period of the reported facts or activities and should be distinguished from the month in which the report was created, submitted, or received. It is commonly expressed as a year-and-month value."
                    }
