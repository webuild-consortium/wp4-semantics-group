            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "authorization scope"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "urn:uuid:bd63d2bd-5e7f-465f-a199-d43e829665a8",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "scope of authority"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "urn:uuid:2c715e4f-6c4b-420e-ba14-aca2f41ed64c",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "extent of authorization"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "urn:uuid:4d47342e-7130-42a5-b99e-84ae01af651c",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "mandate scope"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "urn:uuid:6c756406-dc7f-4227-b9b8-d61c223b744e",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "representation scope"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "webuild:scopeofauthorization",
            "term:orderedSynonym": {
                "@list": [
                    {
                        "@id": "urn:uuid:81e79908-5f43-4514-86e6-a57c87cba339"
                    },
                    {
                        "@id": "urn:uuid:bd63d2bd-5e7f-465f-a199-d43e829665a8"
                    },
                    {
                        "@id": "urn:uuid:2c715e4f-6c4b-420e-ba14-aca2f41ed64c"
                    },
                    {
                        "@id": "urn:uuid:4d47342e-7130-42a5-b99e-84ae01af651c"
                    },
                    {
                        "@id": "urn:uuid:6c756406-dc7f-4227-b9b8-d61c223b744e"
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "In the EBWV context, scope of authorization should be used to describe the limits of an authorisation, mandate, power of attorney, representation right, access right or consent. It may specify what the authorised party may do, for whom, in which role, in relation to which subject matter, and under what conditions. The scope may be general or limited, and may be restricted by time, jurisdiction, transaction type, service, value threshold, document type, credential type or required joint action with another representative.\n\nIt should be distinguished from the authorised person or representative, who is the agent receiving the authority; the authorising party, who grants or is represented by the authority; and the legal basis, which explains why the authority exists."
                    }
                ]
            },
            "term:orderedExample": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "A power of attorney attestation states that the representative’s scope of authorization is limited to submitting VAT returns and receiving tax-related notifications on behalf of the company."
                    }
                ]
            },
            "@type": "skos:Concept",
            "dcterms:created": {
                "@value": "2026-04-28T14:54:50.304Z",
                "@type": "xsd:dateTime"
            },
            "dcterms:modified": {
                "@value": "2026-04-28T14:55:57.693Z",
                "@type": "xsd:dateTime"
            },
            "skos:altLabel": [
                {
                    "@id": "urn:uuid:6c756406-dc7f-4227-b9b8-d61c223b744e"
                },
                {
                    "@id": "urn:uuid:4d47342e-7130-42a5-b99e-84ae01af651c"
                },
                {
                    "@id": "urn:uuid:2c715e4f-6c4b-420e-ba14-aca2f41ed64c"
                },
                {
                    "@id": "urn:uuid:bd63d2bd-5e7f-465f-a199-d43e829665a8"
                },
                {
                    "@id": "urn:uuid:81e79908-5f43-4514-86e6-a57c87cba339"
                }
            ],
            "skos:definition": {
                "@language": "en",
                "@value": "the actions, matters, transactions, roles or circumstances for which an agent is authorised to act on behalf of another person or entity"
            },
            "skos:example": {
                "@language": "en",
                "@value": "A power of attorney attestation states that the representative’s scope of authorization is limited to submitting VAT returns and receiving tax-related notifications on behalf of the company."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:note": {
                "@language": "en",
                "@value": "In the EBWV context, scope of authorization should be used to describe the limits of an authorisation, mandate, power of attorney, representation right, access right or consent. It may specify what the authorised party may do, for whom, in which role, in relation to which subject matter, and under what conditions. The scope may be general or limited, and may be restricted by time, jurisdiction, transaction type, service, value threshold, document type, credential type or required joint action with another representative.\n\nIt should be distinguished from the authorised person or representative, who is the agent receiving the authority; the authorising party, who grants or is represented by the authority; and the legal basis, which explains why the authority exists."
            },
            "skos:prefLabel": {
                "@id": "urn:uuid:7b893c19-8b10-498a-a402-3d1bce8c3be2"
            },
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            }
        },
        {
            "@id": "urn:uuid:049ffcfe-48d1-43be-930a-3af889bbb412",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "jurisdiction of residence"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "urn:uuid:36edeff8-d162-4a0a-8041-507eadff3446",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "place of official residence"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "urn:uuid:82673e05-b0ef-4ebb-806e-6176b899c171",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "legal residence"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "urn:uuid:94049a93-dad2-4171-ab1a-af40f3db90a8",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "country of residence"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "urn:uuid:7c8172e4-c222-473b-b4c4-1318dd6386e8",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "residency"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "urn:uuid:8d5ed253-0eee-4e45-a7b5-699433c26e74",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "residence jurisdiction"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "webuild:jurisdiction",
            "term:orderedSynonym": {
                "@list": [
                    {
                        "@id": "urn:uuid:5bbb6c28-e049-4db9-8737-8856ae889934"
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "A jurisdiction may be supranational, national, regional, local or defined by subject matter rather than territory. In the EBWV context, it may identify the legal or administrative framework relevant to matters such as business registration, establishment, taxation, employment, social security or regulatory supervision. Although a jurisdiction may be associated with a geographic area or public authority, it denotes legal competence rather than merely a location. Where jurisdictions overlap, identifying one jurisdiction does not necessarily determine the applicable law."
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:prefLabel": {
                "@id": "urn:uuid:51e14407-4bda-4017-9b6c-16bb5c229bc5"
            },
            "skos:note": {
                "@language": "en",
                "@value": "A jurisdiction may be supranational, national, regional, local or defined by subject matter rather than territory. In the EBWV context, it may identify the legal or administrative framework relevant to matters such as business registration, establishment, taxation, employment, social security or regulatory supervision. Although a jurisdiction may be associated with a geographic area or public authority, it denotes legal competence rather than merely a location. Where jurisdictions overlap, identifying one jurisdiction does not necessarily determine the applicable law."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "a territory, legal system or sphere of competence within which an authority is empowered to make, apply or enforce law"
            },
            "skos:altLabel": {
                "@id": "urn:uuid:5bbb6c28-e049-4db9-8737-8856ae889934"
            },
            "dcterms:modified": {
                "@value": "2026-08-10T15:10:14.878Z",
                "@type": "xsd:dateTime"
            },
            "dcterms:created": {
                "@value": "2026-04-28T14:03:12.656Z",
                "@type": "xsd:dateTime"
            },
            "@type": "skos:Concept"
        },
        {
            "@id": "webuild:residency",
            "term:orderedSynonym": {
                "@list": [
                    {
                        "@id": "urn:uuid:94049a93-dad2-4171-ab1a-af40f3db90a8"
                    },
                    {
                        "@id": "urn:uuid:82673e05-b0ef-4ebb-806e-6176b899c171"
                    },
                    {
                        "@id": "urn:uuid:36edeff8-d162-4a0a-8041-507eadff3446"
                    },
                    {
                        "@id": "urn:uuid:049ffcfe-48d1-43be-930a-3af889bbb412"
                    },
                    {
                        "@id": "urn:uuid:8d5ed253-0eee-4e45-a7b5-699433c26e74"
                    }
                ]
            },
            "term:orderedRelated": {
                "@list": [
                    {
                        "@id": "webuild:jurisdiction"
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "In the EBWV context, residency should be used for a person’s legally or administratively relevant jurisdiction of residence. It should not be modelled as a postal address or physical address field. It should be distinguished from domicile, which the EU Core Person Vocabulary defines as the place the person treats as their permanent home and models with range Address; residency, by contrast, is linked to a Jurisdiction."
                    }
                ]
            },
            "term:orderedExample": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "A person identity attestation states that the person’s residency is Finland, represented as a jurisdiction rather than as a street address."
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "@type": "skos:Concept",
            "dcterms:created": {
                "@value": "2026-04-28T14:51:03.792Z",
                "@type": "xsd:dateTime"
            },
            "dcterms:modified": {
                "@value": "2026-04-28T14:52:50.651Z",
                "@type": "xsd:dateTime"
            },
            "skos:altLabel": [
                {
                    "@id": "urn:uuid:8d5ed253-0eee-4e45-a7b5-699433c26e74"
                },
                {
                    "@id": "urn:uuid:94049a93-dad2-4171-ab1a-af40f3db90a8"
                },
                {
                    "@id": "urn:uuid:82673e05-b0ef-4ebb-806e-6176b899c171"
                },
                {
                    "@id": "urn:uuid:36edeff8-d162-4a0a-8041-507eadff3446"
                },
                {
                    "@id": "urn:uuid:049ffcfe-48d1-43be-930a-3af889bbb412"
                }
            ],
            "skos:definition": {
                "@language": "en",
                "@value": "a jurisdiction in which a person has their dwelling or is officially regarded as living or residing"
            },
            "skos:example": {
                "@language": "en",
                "@value": "A person identity attestation states that the person’s residency is Finland, represented as a jurisdiction rather than as a street address."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:note": {
                "@language": "en",
                "@value": "In the EBWV context, residency should be used for a person’s legally or administratively relevant jurisdiction of residence. It should not be modelled as a postal address or physical address field. It should be distinguished from domicile, which the EU Core Person Vocabulary defines as the place the person treats as their permanent home and models with range Address; residency, by contrast, is linked to a Jurisdiction."
            },
            "skos:prefLabel": {
                "@id": "urn:uuid:7c8172e4-c222-473b-b4c4-1318dd6386e8"
            },
            "skos:related": {
                "@id": "webuild:jurisdiction"
            },
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8"
        },
        {
            "@id": "urn:uuid:f2bdb766-80ff-4054-9b87-62473b764aab",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "payment service provider"
            },
            "@type": "skos-xl:Label"
        },
        {
