            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "LEI last update date"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "urn:uuid:7fb3600f-a4fe-4899-b6a2-c2506c33e7dc",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "LEI record last update"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "webuild:leilastupdate",
            "term:orderedSynonym": {
                "@list": [
                    {
                        "@id": "urn:uuid:7fb3600f-a4fe-4899-b6a2-c2506c33e7dc"
                    },
                    {
                        "@id": "urn:uuid:09788dcb-beaf-4655-a98e-d64c6c7bbe79"
                    }
                ]
            },
            "term:orderedRelated": {
                "@list": [
                    {
                        "@id": "webuild:lei"
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "The LEI last update concerns the LEI record maintained in the Global LEI System, rather than the time at which the legal entity itself last changed or the LEI data was retrieved for an EBWV attestation. It does not identify which data element changed or the effective date of an underlying legal entity event. The value should be expressed as an ISO 8601 date and time, including the time zone. It is distinct from the LEI initial registration date, next renewal date and the issuance date of an attestation containing the LEI data."
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:related": {
                "@id": "webuild:lei"
            },
            "skos:prefLabel": {
                "@id": "urn:uuid:ca888b32-1fa5-486e-bfb6-b0b88453a62d"
            },
            "skos:note": {
                "@language": "en",
                "@value": "The LEI last update concerns the LEI record maintained in the Global LEI System, rather than the time at which the legal entity itself last changed or the LEI data was retrieved for an EBWV attestation. It does not identify which data element changed or the effective date of an underlying legal entity event. The value should be expressed as an ISO 8601 date and time, including the time zone. It is distinct from the LEI initial registration date, next renewal date and the issuance date of an attestation containing the LEI data."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "date and time at which the information contained in an LEI record was most recently updated by the managing LEI issuing organization"
            },
