        {
            "@id": "webuild:accountname",
            "term:orderedSynonym": {
                "@list": [
                    {
                        "@id": "urn:uuid:6f12a2d2-59d5-4a25-902f-fa02c3b659a5"
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "An account name is distinct from a bank account identifier, such as an IBAN, and from the legal name of the account owner."
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:prefLabel": {
                "@id": "urn:uuid:0f44f7d8-40d0-4923-b048-3b44c98eddad"
            },
            "skos:note": {
                "@language": "en",
                "@value": "An account name is distinct from a bank account identifier, such as an IBAN, and from the legal name of the account owner."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "a human-readable designation assigned to a bank account by the account-servicing financial institution or chosen by the account owner"
            },
