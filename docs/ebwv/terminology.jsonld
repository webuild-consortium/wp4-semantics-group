        {
            "@id": "webuild:employer",
            "term:orderedRelated": {
                "@list": [
                    {
                        "@id": "webuild:employee"
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:related": {
                "@id": "webuild:employee"
            },
            "skos:prefLabel": {
                "@id": "urn:uuid:df903aaf-4125-4bc0-932d-282529638f0d"
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "a party that engages a person to perform work under an employment relationship, with associated rights, duties, reporting obligations, or liabilities"
            },
            "dcterms:modified": {
                "@value": "2026-08-10T14:29:22.727Z",
                "@type": "xsd:dateTime"
            },
            "dcterms:created": {
                "@value": "2026-04-28T11:57:35.962Z",
                "@type": "xsd:dateTime"
            },
            "@type": "skos:Concept"
        },
        {
            "@id": "webuild:employee",
            "term:orderedSynonym": {
                "@list": [
                    {
                        "@id": "urn:uuid:fa63b1d4-a7df-45e4-85d8-41d87494eca5"
                    }
                ]
            },
            "term:orderedRelated": {
                "@list": [
                    {
                        "@id": "webuild:employer"
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "Employee is a role held in relation to a particular employer and is distinct from an independent contractor or self-employed person. In a posting context, a posted worker is an employee temporarily assigned to work in a state other than the state in which the employee normally works."
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:related": {
                "@id": "webuild:employer"
            },
            "skos:prefLabel": {
                "@id": "urn:uuid:d1246ebe-90b0-4b36-94fe-29a2135e0cce"
            },
            "skos:note": {
                "@language": "en",
                "@value": "Employee is a role held in relation to a particular employer and is distinct from an independent contractor or self-employed person. In a posting context, a posted worker is an employee temporarily assigned to work in a state other than the state in which the employee normally works."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "a role of a person who is engaged by an employer to perform work under an employment relationship, with the associated rights and obligations"
            },
            "skos:altLabel": {
                "@id": "urn:uuid:fa63b1d4-a7df-45e4-85d8-41d87494eca5"
            },
