        {
            "@id": "webuild:paymentdue",
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "Distinguish payment due from the payment due date, which specifies when the obligation becomes due, and from the amount due, which specifies the monetary amount payable."
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:prefLabel": {
                "@id": "urn:uuid:f3fea0f9-5782-4aca-928a-0f317ad1553d"
            },
            "skos:note": {
                "@language": "en",
                "@value": "Distinguish payment due from the payment due date, which specifies when the obligation becomes due, and from the amount due, which specifies the monetary amount payable."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "the state of a monetary obligation for which the agreed or legally prescribed time for payment has been reached, making the outstanding amount payable"
            },
