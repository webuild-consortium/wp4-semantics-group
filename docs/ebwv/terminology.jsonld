            },
            "skos:note": {
                "@language": "en",
                "@value": "An email is associated with a contact point and provides an address for sending electronic messages to the entity represented by that contact point. It may be a personal, organizational, functional or service-specific address. Its presence does not imply that the address is verified, preferred or actively monitored. Formatting and cardinality requirements should be specified in the applicable SHACL application profile."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "an electronic mail address through which an entity can be contacted"
            },
