        },
        {
            "@id": "urn:uuid:9626e98a-d6b2-44e8-8ec3-45a7b75e32eb",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "rulebook hash"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "webuild:hash",
            "term:orderedSynonym": {
                "@list": [
                    {
                        "@id": "urn:uuid:9626e98a-d6b2-44e8-8ec3-45a7b75e32eb"
                    },
                    {
                        "@id": "urn:uuid:dd95b250-3ad6-4bdf-96b1-47446c16ef9f"
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "The hash is a fixed-length value derived from the rulebook content. Two hashes can be compared to determine efficiently whether the hashed representations are the same. The specification must define the exact content, serialization, character encoding and encoding of the resulting hash value, such as hexadecimal or Base64. A hash supports integrity checking but does not by itself establish the origin, authenticity or legal validity of the rulebook; these require a digital signature or another trust mechanism."
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:prefLabel": {
                "@id": "urn:uuid:55636c56-f258-414a-81cc-3a64547024c6"
            },
            "skos:note": {
                "@language": "en",
                "@value": "The hash is a fixed-length value derived from the rulebook content. Two hashes can be compared to determine efficiently whether the hashed representations are the same. The specification must define the exact content, serialization, character encoding and encoding of the resulting hash value, such as hexadecimal or Base64. A hash supports integrity checking but does not by itself establish the origin, authenticity or legal validity of the rulebook; these require a digital signature or another trust mechanism."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "a SHA-256 digest calculated from a defined digital representation of a rulebook to enable efficient comparison and detection of changes"
            },
            "skos:altLabel": [
                {
                    "@id": "urn:uuid:9626e98a-d6b2-44e8-8ec3-45a7b75e32eb"
