            "@id": "urn:uuid:2b3ecebe-c3ea-4b6c-bf25-d050f2bf0b7a",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "transitional provisions"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "webuild:transitionalrules",
            "term:orderedSynonym": {
                "@list": [
                    {
                        "@id": "urn:uuid:2b3ecebe-c3ea-4b6c-bf25-d050f2bf0b7a"
                    },
                    {
                        "@id": "urn:uuid:9b423958-0b5e-43a1-8cbe-b0103d561712"
                    },
                    {
                        "@id": "urn:uuid:f5a2677d-bf6c-40d7-926d-dd4d0c672c27"
                    },
                    {
                        "@id": "urn:uuid:32f55e34-aaba-46a0-87c4-499237ff43d7"
                    }
                ]
            },
            "@type": "skos:Concept",
            "dcterms:created": {
                "@value": "2026-05-12T09:06:15.726Z",
                "@type": "xsd:dateTime"
            },
            "dcterms:modified": {
                "@value": "2026-05-12T09:06:15.726Z",
                "@type": "xsd:dateTime"
            },
            "skos:altLabel": [
                {
                    "@id": "urn:uuid:32f55e34-aaba-46a0-87c4-499237ff43d7"
                },
                {
                    "@id": "urn:uuid:f5a2677d-bf6c-40d7-926d-dd4d0c672c27"
                },
                {
                    "@id": "urn:uuid:9b423958-0b5e-43a1-8cbe-b0103d561712"
                },
                {
                    "@id": "urn:uuid:2b3ecebe-c3ea-4b6c-bf25-d050f2bf0b7a"
                }
            ],
            "skos:definition": {
                "@language": "en",
                "@value": "a temporary legal or administrative rule set that applies to a case because the relevant situation falls within a transition from one regime, framework, or procedure to another"
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:note": [
                {
                    "@language": "en",
                    "@value": "In the general EBWV context, this concept can be used to qualify any status, entitlement, obligation, authorisation, determination, or certificate where the applicable legal or administrative basis is a temporary transition regime."
                },
                {
                    "@language": "en",
                    "@value": "In the PD A1 context, this concept indicates that the determination of the applicable social security legislation is based on transitional provisions rather than only on the ordinary rules in force at the time of the activity. Such provisions may apply, for example, when legal amendments, withdrawal agreements, bilateral arrangements, or implementation periods affect how cross-border social security coordination rules are applied."
                }
            ],
            "skos:prefLabel": {
                "@id": "urn:uuid:930c0929-42c0-4969-a4bd-143faef1866b"
            },
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "In the PD A1 context, this concept indicates that the determination of the applicable social security legislation is based on transitional provisions rather than only on the ordinary rules in force at the time of the activity. Such provisions may apply, for example, when legal amendments, withdrawal agreements, bilateral arrangements, or implementation periods affect how cross-border social security coordination rules are applied."
                    },
                    {
                        "@language": "en",
                        "@value": "In the general EBWV context, this concept can be used to qualify any status, entitlement, obligation, authorisation, determination, or certificate where the applicable legal or administrative basis is a temporary transition regime."
                    }
                ]
            }
        },
        {
            "@id": "urn:uuid:930c0929-42c0-4969-a4bd-143faef1866b",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "transitional rules"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "urn:uuid:05fc770b-9bb1-45fd-b293-53e06b634867",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "provisional determination"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "urn:uuid:afc609ea-9b38-4094-b31d-15073b4dbed7",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "determination is provisional"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "urn:uuid:9c8802e8-5adc-4c6d-ad91-edab010c5594",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "preliminary determination"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "urn:uuid:3a94e9e4-0e22-4291-b053-d54f11633144",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "non-final determination"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "webuild:provisionaldetermination",
            "term:orderedSynonym": {
                "@list": [
                    {
                        "@id": "urn:uuid:afc609ea-9b38-4094-b31d-15073b4dbed7"
                    },
                    {
                        "@id": "urn:uuid:9c8802e8-5adc-4c6d-ad91-edab010c5594"
                    },
                    {
                        "@id": "urn:uuid:3a94e9e4-0e22-4291-b053-d54f11633144"
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "In the PD A1 context, this concept indicates that the determination of the applicable social security legislation is not yet final. It may apply where the competent institution has issued or recorded an initial position pending further verification, coordination between institutions, or expiry of a period during which the determination can be contested."
                    },
                    {
                        "@language": "en",
                        "@value": "In the general EBWV context, this concept can be used to qualify any administrative, legal, or procedural determination whose status is temporary or not yet final."
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:prefLabel": {
                "@id": "urn:uuid:05fc770b-9bb1-45fd-b293-53e06b634867"
            },
            "skos:note": [
                {
                    "@language": "en",
                    "@value": "In the PD A1 context, this concept indicates that the determination of the applicable social security legislation is not yet final. It may apply where the competent institution has issued or recorded an initial position pending further verification, coordination between institutions, or expiry of a period during which the determination can be contested."
                },
                {
                    "@language": "en",
                    "@value": "In the general EBWV context, this concept can be used to qualify any administrative, legal, or procedural determination whose status is temporary or not yet final."
                }
            ],
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "A determination that has legal or administrative effect on a provisional basis and remains subject to confirmation, amendment, or withdrawal under the applicable procedure."
            },
            "skos:altLabel": [
                {
                    "@id": "urn:uuid:afc609ea-9b38-4094-b31d-15073b4dbed7"
                },
                {
                    "@id": "urn:uuid:9c8802e8-5adc-4c6d-ad91-edab010c5594"
                },
                {
                    "@id": "urn:uuid:3a94e9e4-0e22-4291-b053-d54f11633144"
                }
            ],
            "dcterms:modified": {
                "@value": "2026-05-12T09:01:17.481Z",
                "@type": "xsd:dateTime"
            },
            "dcterms:created": {
                "@value": "2026-05-12T09:00:19.864Z",
                "@type": "xsd:dateTime"
            },
            "@type": "skos:Concept"
        },
        {
            "@id": "urn:uuid:10c00395-fc21-4252-bc22-bf636126cdf7",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "certificate applies for the duration of the activity"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "urn:uuid:3e7cc834-667b-4f3b-8101-9e3a0e52cb69",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "activity period fully covered"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "webuild:fullperiodcovered",
            "term:orderedSynonym": {
                "@list": [
                    {
                        "@id": "urn:uuid:3e7cc834-667b-4f3b-8101-9e3a0e52cb69"
                    },
                    {
                        "@id": "urn:uuid:10c00395-fc21-4252-bc22-bf636126cdf7"
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "This concept is used to express that there is no uncovered part of the declared activity period: the validity or applicability of the certificate covers the activity from its start date to its end date. It should not be interpreted as defining the activity period itself, but as qualifying the relationship between the certificate coverage and the activity duration."
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:prefLabel": {
                "@id": "urn:uuid:d79bc065-b6b8-4d72-a199-ca2c01ef5034"
            },
            "skos:note": {
                "@language": "en",
                "@value": "This concept is used to express that there is no uncovered part of the declared activity period: the validity or applicability of the certificate covers the activity from its start date to its end date. It should not be interpreted as defining the activity period itself, but as qualifying the relationship between the certificate coverage and the activity duration."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "indicates that the PD A1 certificate applies for the entire duration of the cross-border work activity or posting for which the certificate is issued"
            },
            "skos:altLabel": [
                {
                    "@id": "urn:uuid:3e7cc834-667b-4f3b-8101-9e3a0e52cb69"
                },
                {
                    "@id": "urn:uuid:10c00395-fc21-4252-bc22-bf636126cdf7"
                }
            ],
            "dcterms:modified": {
                "@value": "2026-05-12T08:56:59.691Z",
                "@type": "xsd:dateTime"
            },
            "dcterms:created": {
                "@value": "2026-05-12T08:56:59.691Z",
                "@type": "xsd:dateTime"
            },
            "@type": "skos:Concept"
        },
        {
            "@id": "urn:uuid:d79bc065-b6b8-4d72-a199-ca2c01ef5034",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "full period covered"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "urn:uuid:782efa4d-40a8-4931-be9a-37b98f96ca4c",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "form of employment"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "urn:uuid:45d9582e-10e8-40ef-b67d-53ce26ec2506",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "employment relationship type"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "urn:uuid:0e2d5b67-58ce-4e12-b359-c6b3121b1b62",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "employment category"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "urn:uuid:edaa44ed-13c7-44ac-ba65-f86d21618e43",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "employment type"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "webuild:postedworker",
            "term:orderedSynonym": {
                "@list": [
                    {
                        "@id": "urn:uuid:a9171cc2-39cc-4310-a26f-b208893f4acf"
                    },
                    {
                        "@id": "urn:uuid:71913d2d-1455-4b11-9fdd-8a4e9c84977f"
                    },
                    {
                        "@id": "urn:uuid:cd779356-62e9-48f1-a572-35ad9b0af95a"
                    }
                ]
            },
            "@type": "skos:Concept",
            "dcterms:created": {
                "@value": "2026-04-28T14:47:17.976Z",
                "@type": "xsd:dateTime"
            },
            "dcterms:modified": {
                "@value": "2026-04-28T14:47:17.976Z",
                "@type": "xsd:dateTime"
            },
            "skos:altLabel": [
                {
                    "@id": "urn:uuid:cd779356-62e9-48f1-a572-35ad9b0af95a"
                },
                {
                    "@id": "urn:uuid:71913d2d-1455-4b11-9fdd-8a4e9c84977f"
                },
                {
                    "@id": "urn:uuid:a9171cc2-39cc-4310-a26f-b208893f4acf"
                }
            ],
            "skos:definition": {
                "@language": "en",
                "@value": "a worker who is sent by an employer to perform work temporarily in a country other than the country in which the worker normally works"
            },
            "skos:example": {
                "@language": "en",
                "@value": "A Finnish employer submits a Posted Worker Notification stating that a named employee is a posted worker assigned to a construction site in Belgium for three months."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:note": {
                "@language": "en",
                "@value": "In the EBWV context, and especially in a Posted Worker Notification, posted worker denotes the person whose cross-border posting is being notified to the competent authority of the host country. The concept should be used for the worker subject to the posting arrangement, not for the posting employer, host entity, local contact person, legal representative, or service recipient. A posted worker normally remains employed by, or otherwise contractually connected to, the sending employer during the posting period."
            },
            "skos:prefLabel": {
                "@id": "urn:uuid:1a54f59d-de99-4734-b22b-25592d936381"
            },
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "term:orderedExample": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "A Finnish employer submits a Posted Worker Notification stating that a named employee is a posted worker assigned to a construction site in Belgium for three months."
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "In the EBWV context, and especially in a Posted Worker Notification, posted worker denotes the person whose cross-border posting is being notified to the competent authority of the host country. The concept should be used for the worker subject to the posting arrangement, not for the posting employer, host entity, local contact person, legal representative, or service recipient. A posted worker normally remains employed by, or otherwise contractually connected to, the sending employer during the posting period."
                    }
                ]
            }
        },
        {
            "@id": "webuild:typeofemployment",
            "term:orderedSynonym": {
                "@list": [
                    {
                        "@id": "urn:uuid:edaa44ed-13c7-44ac-ba65-f86d21618e43"
                    },
                    {
                        "@id": "urn:uuid:0e2d5b67-58ce-4e12-b359-c6b3121b1b62"
                    },
                    {
                        "@id": "urn:uuid:45d9582e-10e8-40ef-b67d-53ce26ec2506"
                    },
                    {
                        "@id": "urn:uuid:782efa4d-40a8-4931-be9a-37b98f96ca4c"
                    }
                ]
            },
            "term:orderedRelated": {
                "@list": [
                    {
                        "@id": "webuild:postedworker"
                    },
                    {
                        "@id": "webuild:employer"
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "In the EBWV context, type of employment should be used as a generic property of an employment relationship. It may describe whether the employment is permanent, fixed-term, temporary, seasonal, part-time, full-time, agency-based, apprenticeship-based, probationary or another recognised employment form.\n\nIn the Posted Worker Notification context, this concept helps describe the employment arrangement under which the posted worker is employed by the sending employer during the posting period. It should be distinguished from job title, which names the worker’s role or position; employment status, which may describe whether a person is employed, self-employed, unemployed or otherwise active; and working time, which describes the hours or pattern of work."
                    }
                ]
            },
            "term:orderedExample": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "A Posted Worker Notification states that the posted worker’s type of employment is “fixed-term employment”."
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "@type": "skos:Concept",
            "dcterms:created": {
                "@value": "2026-04-28T15:04:07.672Z",
                "@type": "xsd:dateTime"
            },
            "dcterms:modified": {
                "@value": "2026-04-28T15:04:07.672Z",
                "@type": "xsd:dateTime"
            },
            "skos:altLabel": [
                {
                    "@id": "urn:uuid:782efa4d-40a8-4931-be9a-37b98f96ca4c"
                },
                {
                    "@id": "urn:uuid:45d9582e-10e8-40ef-b67d-53ce26ec2506"
                },
                {
                    "@id": "urn:uuid:0e2d5b67-58ce-4e12-b359-c6b3121b1b62"
                },
                {
                    "@id": "urn:uuid:edaa44ed-13c7-44ac-ba65-f86d21618e43"
                }
            ],
            "skos:definition": {
                "@language": "en",
                "@value": "the category or form of an employment relationship, indicating how a worker is employed or engaged by an employer"
            },
            "skos:example": {
                "@language": "en",
                "@value": "A Posted Worker Notification states that the posted worker’s type of employment is “fixed-term employment”."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:note": {
                "@language": "en",
                "@value": "In the EBWV context, type of employment should be used as a generic property of an employment relationship. It may describe whether the employment is permanent, fixed-term, temporary, seasonal, part-time, full-time, agency-based, apprenticeship-based, probationary or another recognised employment form.\n\nIn the Posted Worker Notification context, this concept helps describe the employment arrangement under which the posted worker is employed by the sending employer during the posting period. It should be distinguished from job title, which names the worker’s role or position; employment status, which may describe whether a person is employed, self-employed, unemployed or otherwise active; and working time, which describes the hours or pattern of work."
            },
            "skos:prefLabel": {
                "@id": "urn:uuid:90d215a5-19dc-49eb-80ee-9abd063d94c2"
            },
            "skos:related": [
                {
                    "@id": "webuild:employer"
                },
                {
                    "@id": "webuild:postedworker"
                }
            ],
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8"
        },
        {
            "@id": "urn:uuid:90d215a5-19dc-49eb-80ee-9abd063d94c2",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "type of employment"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "urn:uuid:d460c34c-abb0-4508-a7b5-ab134bd1d998",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "address during stay"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "urn:uuid:aa7bffd5-55f9-49d1-8ed6-303a0a5f747a",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
