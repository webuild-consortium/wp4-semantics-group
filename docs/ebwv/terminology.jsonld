            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "webuild:concept-86",
            "term:orderedSynonym": {
                "@list": [
                    {
                        "@id": "urn:uuid:a6565663-5d7b-4ac0-b18b-1ca150f5f832"
                    }
                ]
            },
            "term:orderedRelated": {
                "@list": [
                    {
                        "@id": "webuild:geographicidentifier"
                    },
                    {
                        "@id": "webuild:geographicname"
                    }
                ]
            },
            "@type": "skos:Concept",
            "dcterms:created": {
                "@value": "2025-10-06T08:38:16.293Z",
                "@type": "xsd:dateTime"
            },
            "dcterms:modified": {
                "@value": "2026-08-10T15:01:00.333Z",
                "@type": "xsd:dateTime"
            },
            "skos:altLabel": {
                "@id": "urn:uuid:a6565663-5d7b-4ac0-b18b-1ca150f5f832"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "a identifiable geographic place, area or position, including natural, administrative and constructed places"
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:narrower": {
                "@id": "webuild:deliverylocation"
            },
            "skos:note": {
                "@language": "en",
                "@value": "A location may be described by a geographic name, identifier, address, geometry, coordinates or its relationship to another location. Examples include a country, region, city, property, building, facility, terminal or designated point. A location may have an address, but not every location is addressable."
            },
            "skos:prefLabel": {
                "@id": "urn:uuid:4dd0eea6-1e19-4944-b159-597dd41d6e27"
            },
            "skos:related": [
                {
                    "@id": "webuild:geographicidentifier"
                },
                {
                    "@id": "webuild:geographicname"
                }
            ],
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "term:orderedNarrower": {
                "@list": [
                    {
                        "@id": "webuild:deliverylocation"
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "A location may be described by a geographic name, identifier, address, geometry, coordinates or its relationship to another location. Examples include a country, region, city, property, building, facility, terminal or designated point. A location may have an address, but not every location is addressable."
                    }
                ]
            }
        },
        {
            "@id": "webuild:geographicidentifier",
            "term:orderedRelated": {
                "@list": [
                    {
                        "@id": "webuild:concept-86"
                    },
                    {
                        "@id": "webuild:geographicname"
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "A geographic identifier identifies the location itself and is distinct from its geographic name, address, coordinates or geometry. Consistent with INSPIRE identifier management, the identifier should be globally unique and remain stable throughout the lifecycle of the identified location. An INSPIRE identifier may combine a namespace and a locally unique identifier, with an optional version identifier. In the EU Core Location Vocabulary, the geographic identifier is represented as a URI, preferably originating from an authoritative and maintained geographic identification system."
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:related": [
                {
                    "@id": "webuild:geographicname"
                },
                {
                    "@id": "webuild:concept-86"
                }
            ],
            "skos:prefLabel": {
                "@id": "urn:uuid:9491f690-6932-4d62-a68b-b92ea85264fb"
            },
            "skos:note": {
                "@language": "en",
                "@value": "A geographic identifier identifies the location itself and is distinct from its geographic name, address, coordinates or geometry. Consistent with INSPIRE identifier management, the identifier should be globally unique and remain stable throughout the lifecycle of the identified location. An INSPIRE identifier may combine a namespace and a locally unique identifier, with an optional version identifier. In the EU Core Location Vocabulary, the geographic identifier is represented as a URI, preferably originating from an authoritative and maintained geographic identification system."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "a reference in the form of a Uniform Resource Identifier that uniquely identifies a location"
            },
            "dcterms:modified": {
                "@value": "2026-08-10T15:00:36.821Z",
                "@type": "xsd:dateTime"
            },
            "dcterms:created": {
                "@value": "2026-08-10T14:54:33.54Z",
                "@type": "xsd:dateTime"
            },
            "@type": "skos:Concept"
        },
        {
            "@id": "webuild:geographicname",
            "term:orderedSynonym": {
                "@list": [
                    {
                        "@id": "urn:uuid:22541cd3-d5c4-42a2-995e-68cd044286f2"
                    }
                ]
            },
            "term:orderedRelated": {
                "@list": [
                    {
                        "@id": "webuild:geographicidentifier"
                    },
                    {
                        "@id": "webuild:concept-86"
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "A geographic name may designate an area, region, locality, settlement or geographic or topographic feature. A location may have several geographic names reflecting different languages, scripts, spelling conventions, endonyms, exonyms, historical names or official statuses. In the EU Core Location Vocabulary, standardized geographic codes, such as country codes, may also be represented as geographic names. A geographic name is distinct from a geographic identifier expressed as a URI and from an address, geometry or geographic coordinates."
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:related": [
                {
                    "@id": "webuild:geographicidentifier"
                },
                {
                    "@id": "webuild:concept-86"
                }
            ],
            "skos:prefLabel": {
                "@id": "urn:uuid:a9d84db8-f4d8-43b3-b770-f30898931433"
            },
            "skos:note": {
                "@language": "en",
                "@value": "A geographic name may designate an area, region, locality, settlement or geographic or topographic feature. A location may have several geographic names reflecting different languages, scripts, spelling conventions, endonyms, exonyms, historical names or official statuses. In the EU Core Location Vocabulary, standardized geographic codes, such as country codes, may also be represented as geographic names. A geographic name is distinct from a geographic identifier expressed as a URI and from an address, geometry or geographic coordinates."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "a proper noun applied to a location or spatial object"
            },
            "skos:altLabel": {
                "@id": "urn:uuid:22541cd3-d5c4-42a2-995e-68cd044286f2"
            },
