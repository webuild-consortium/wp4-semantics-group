            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "place of delivery"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "webuild:deliverylocation",
            "term:orderedSynonym": {
                "@list": [
                    {
                        "@id": "urn:uuid:b0c87238-f023-44f8-bc86-60b5e4698a22"
                    },
                    {
                        "@id": "urn:uuid:f45f3dab-5771-46ab-8251-c7fefb1f43b5"
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "A delivery location may be identified by a postal address, geographic identifier, geographic name, site, facility, terminal or another designated delivery point. It does not necessarily identify the consignee or the goods’ final destination. Under applicable trade terms, it may indicate the place at which the supplier’s delivery obligation is fulfilled."
                    }
                ]
            },
            "term:orderedBroader": {
                "@list": [
                    {
                        "@id": "webuild:concept-86"
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:prefLabel": {
                "@id": "urn:uuid:7c56e78d-ff9b-4048-be67-dd1ee657ed18"
            },
            "skos:note": {
                "@language": "en",
                "@value": "A delivery location may be identified by a postal address, geographic identifier, geographic name, site, facility, terminal or another designated delivery point. It does not necessarily identify the consignee or the goods’ final destination. Under applicable trade terms, it may indicate the place at which the supplier’s delivery obligation is fulfilled."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "a place specified in a transaction or agreement at which goods are to be delivered or a service is to be performed"
            },
            "skos:broader": {
                "@id": "webuild:concept-86"
            },
