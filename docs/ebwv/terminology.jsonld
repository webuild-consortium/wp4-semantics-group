        },
        {
            "@id": "webuild:gs1companyprefix",
            "term:orderedSynonym": {
                "@list": [
                    {
                        "@id": "urn:uuid:3f136bb2-a5e4-4ee3-8f27-3da1423d81e2"
                    },
                    {
                        "@id": "urn:uuid:92925ff6-d2b2-4f7a-9e92-1dd3562fd20c"
                    },
                    {
                        "@id": "urn:uuid:a18bdd51-7645-4cb7-a841-04c9b4a9d7c8"
                    }
                ]
            },
            "@type": "skos:Concept",
            "dcterms:created": {
                "@value": "2026-08-10T15:39:37.336Z",
                "@type": "xsd:dateTime"
            },
            "dcterms:modified": {
                "@value": "2026-08-10T15:39:37.336Z",
                "@type": "xsd:dateTime"
            },
            "skos:altLabel": [
                {
                    "@id": "urn:uuid:a18bdd51-7645-4cb7-a841-04c9b4a9d7c8"
                },
                {
                    "@id": "urn:uuid:92925ff6-d2b2-4f7a-9e92-1dd3562fd20c"
                },
                {
                    "@id": "urn:uuid:3f136bb2-a5e4-4ee3-8f27-3da1423d81e2"
                }
            ],
            "skos:definition": {
                "@language": "en",
                "@value": "a GS1 Company Prefix licensed to an organization by GS1 for use as the basis for creating GS1 identification keys"
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:note": {
                "@language": "en",
                "@value": "A GS1 Company Prefix is a numeric prefix from which an authorized organization can create GS1 identification keys, such as GTINs, GLNs and SSCCs. In the EBWV GLN context, it corresponds to the licenseValue contained in a GS1CompanyPrefixLicenseCredential and may be obtained by resolving the GS1 digital licence credential chain. It is not a complete GS1 identification key, a cryptographic key or a software licence key. Possession of the value alone does not demonstrate a current right to use the prefix; that right should be established through a valid GS1 licence or verifiable licence credential."
            },
            "skos:prefLabel": {
                "@id": "urn:uuid:feda81ef-6712-4d10-9e35-f683384d7e49"
            },
            "skos:related": {
                "@id": "webuild:licensekey"
            },
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "A GS1 Company Prefix is a numeric prefix from which an authorized organization can create GS1 identification keys, such as GTINs, GLNs and SSCCs. In the EBWV GLN context, it corresponds to the licenseValue contained in a GS1CompanyPrefixLicenseCredential and may be obtained by resolving the GS1 digital licence credential chain. It is not a complete GS1 identification key, a cryptographic key or a software licence key. Possession of the value alone does not demonstrate a current right to use the prefix; that right should be established through a valid GS1 licence or verifiable licence credential."
                    }
                ]
            },
            "term:orderedRelated": {
                "@list": [
                    {
                        "@id": "webuild:licensekey"
                    }
                ]
            }
        },
        {
            "@id": "urn:uuid:feda81ef-6712-4d10-9e35-f683384d7e49",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "GS1 Company Prefix"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "urn:uuid:3a4e507e-e6d9-4cc4-9e6f-4fc7dfa774ed",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "limited partner liability or contribution amount"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "webuild:liabilityorcontribution",
            "term:orderedSynonym": {
                "@list": [
                    {
                        "@id": "urn:uuid:3a4e507e-e6d9-4cc4-9e6f-4fc7dfa774ed"
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "This is a cross-jurisdictional umbrella concept corresponding to the wording of Directive (EU) 2025/25. Depending on the applicable national company law and the information maintained in the national register, the recorded amount may represent maximum liability or contribution. Because these alternatives have different legal meanings, the amount should be qualified using a more specific concept or property."
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:prefLabel": {
                "@id": "urn:uuid:7e20eb00-9e59-4209-a18c-6ed83a7f311b"
            },
            "skos:note": {
                "@language": "en",
                "@value": "This is a cross-jurisdictional umbrella concept corresponding to the wording of Directive (EU) 2025/25. Depending on the applicable national company law and the information maintained in the national register, the recorded amount may represent maximum liability or contribution. Because these alternatives have different legal meanings, the amount should be qualified using a more specific concept or property."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "a monetary amount recorded for a limited partner that represents either the partner’s maximum liability for the obligations of the partnership or the partner’s contribution to the partnership"
            },
            "skos:altLabel": {
                "@id": "urn:uuid:3a4e507e-e6d9-4cc4-9e6f-4fc7dfa774ed"
            },
            "dcterms:modified": {
                "@value": "2026-08-10T15:32:59.786Z",
                "@type": "xsd:dateTime"
            },
            "dcterms:created": {
                "@value": "2026-08-10T15:32:59.786Z",
                "@type": "xsd:dateTime"
            },
            "@type": "skos:Concept"
        },
        {
            "@id": "urn:uuid:7e20eb00-9e59-4209-a18c-6ed83a7f311b",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "liability or contribution"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "webuild:lei",
            "term:orderedSynonym": {
                "@list": [
                    {
                        "@id": "urn:uuid:427d3424-d925-4b76-b6ef-47af9b8eb768"
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "In the EBWV context, LEI denotes the identifier issued through the Global LEI System and maintained under the governance of GLEIF-accredited Local Operating Units. It identifies a legal entity, not a natural person acting in a private capacity, and should be used as an identifier value for an LEI-eligible entity. The LEI is especially relevant for cross-border business identification, financial reporting, procurement, trade, sanctions screening and regulatory verification."
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:prefLabel": {
                "@id": "urn:uuid:643b36a8-4c6b-4682-af25-9f2f4568de6b"
            },
            "skos:note": {
                "@language": "en",
                "@value": "In the EBWV context, LEI denotes the identifier issued through the Global LEI System and maintained under the governance of GLEIF-accredited Local Operating Units. It identifies a legal entity, not a natural person acting in a private capacity, and should be used as an identifier value for an LEI-eligible entity. The LEI is especially relevant for cross-border business identification, financial reporting, procurement, trade, sanctions screening and regulatory verification."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "a globally unique reference code assigned under the Global LEI System to identify a legal entity participating in financial, business or regulatory transactions"
            },
            "skos:altLabel": {
                "@id": "urn:uuid:427d3424-d925-4b76-b6ef-47af9b8eb768"
            },
            "dcterms:modified": {
                "@value": "2026-04-28T14:25:13.054Z",
                "@type": "xsd:dateTime"
            },
            "dcterms:created": {
                "@value": "2026-04-28T14:25:13.054Z",
                "@type": "xsd:dateTime"
            },
            "@type": "skos:Concept"
        },
        {
            "@id": "webuild:leiregistrationstatus",
            "term:orderedRelated": {
                "@list": [
                    {
                        "@id": "webuild:lei"
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "The LEI registration status describes the administrative and lifecycle state of an LEI registration. Its value should be selected from the GLEIF RegistrationStatusEnum, which includes statuses such as PENDING_VALIDATION, ISSUED, LAPSED, DUPLICATE, RETIRED, ANNULLED, CANCELLED, TRANSFERRED, PENDING_TRANSFER and PENDING_ARCHIVAL. The status applies to the LEI registration record and should not be treated as equivalent to the legal or operational status of the identified entity. In particular, a LAPSED status indicates that renewal is overdue but does not make the LEI code invalid as an identifier."
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:related": {
                "@id": "webuild:lei"
            },
            "skos:prefLabel": {
                "@id": "urn:uuid:3ba120a5-ab6e-4ee9-86df-074debf3b6d7"
            },
            "skos:note": {
                "@language": "en",
                "@value": "The LEI registration status describes the administrative and lifecycle state of an LEI registration. Its value should be selected from the GLEIF RegistrationStatusEnum, which includes statuses such as PENDING_VALIDATION, ISSUED, LAPSED, DUPLICATE, RETIRED, ANNULLED, CANCELLED, TRANSFERRED, PENDING_TRANSFER and PENDING_ARCHIVAL. The status applies to the LEI registration record and should not be treated as equivalent to the legal or operational status of the identified entity. In particular, a LAPSED status indicates that renewal is overdue but does not make the LEI code invalid as an identifier."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "a status assigned to an LEI registration by its managing LEI issuing organization within the Global LEI System"
            },
            "dcterms:modified": {
                "@value": "2026-08-10T15:22:50.882Z",
                "@type": "xsd:dateTime"
            },
            "dcterms:created": {
                "@value": "2026-08-10T15:22:50.882Z",
                "@type": "xsd:dateTime"
            },
            "@type": "skos:Concept"
        },
        {
            "@id": "urn:uuid:3ba120a5-ab6e-4ee9-86df-074debf3b6d7",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "LEI registration status"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "urn:uuid:8e3d4b8c-a95f-45e5-bd2f-b741364b211a",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "initial LEI registration date"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "urn:uuid:144cba80-9886-455d-ab43-887a5a313486",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "LEI initial registration date"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "webuild:leiregistrationdate",
            "term:orderedSynonym": {
                "@list": [
                    {
                        "@id": "urn:uuid:144cba80-9886-455d-ab43-887a5a313486"
                    },
                    {
                        "@id": "urn:uuid:8e3d4b8c-a95f-45e5-bd2f-b741364b211a"
                    }
                ]
            },
            "term:orderedRelated": {
                "@list": [
                    {
                        "@id": "webuild:lei"
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "The LEI registration date marks the beginning of the LEI registration record in the Global LEI System. It does not represent the date on which the legal entity was established, incorporated or entered in a business register, nor the issuance date of an EBWV attestation containing the LEI data. The value should be expressed as an ISO 8601 date and time, including the time zone, and normally remains unchanged when the LEI record is renewed, updated or transferred to another LEI issuing organization."
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:related": {
                "@id": "webuild:lei"
            },
            "skos:prefLabel": {
                "@id": "urn:uuid:08ac17ed-8a1b-4512-8c4e-985298a11bdd"
            },
            "skos:note": {
                "@language": "en",
                "@value": "The LEI registration date marks the beginning of the LEI registration record in the Global LEI System. It does not represent the date on which the legal entity was established, incorporated or entered in a business register, nor the issuance date of an EBWV attestation containing the LEI data. The value should be expressed as an ISO 8601 date and time, including the time zone, and normally remains unchanged when the LEI record is renewed, updated or transferred to another LEI issuing organization."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "date and time at which the information for an LEI registration was first collected by the managing LEI issuing organization"
            },
            "skos:altLabel": [
                {
                    "@id": "urn:uuid:144cba80-9886-455d-ab43-887a5a313486"
                },
                {
                    "@id": "urn:uuid:8e3d4b8c-a95f-45e5-bd2f-b741364b211a"
                }
            ],
            "dcterms:modified": {
                "@value": "2026-08-10T15:21:10.259Z",
                "@type": "xsd:dateTime"
            },
            "dcterms:created": {
                "@value": "2026-08-10T15:21:10.259Z",
                "@type": "xsd:dateTime"
            },
            "@type": "skos:Concept"
        },
        {
            "@id": "urn:uuid:08ac17ed-8a1b-4512-8c4e-985298a11bdd",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "LEI registration date"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "urn:uuid:6331e42f-3e01-408a-846c-404d92ac418b",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "LEI registration record"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "webuild:leiregistration",
            "term:orderedSynonym": {
                "@list": [
                    {
                        "@id": "urn:uuid:6331e42f-3e01-408a-846c-404d92ac418b"
                    }
                ]
            },
            "term:orderedRelated": {
                "@list": [
                    {
                        "@id": "webuild:lei"
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "A LEI registration describes the lifecycle and administrative status of an LEI within the Global LEI System. It may contain the initial registration date, last update, next renewal, registration status, managing LEI issuing organization and information about the validation of the associated reference data. It is distinct from the LEI code, the legal entity identified by that code and the reference data describing the entity. Consequently, the status of an LEI registration should not be interpreted as the legal or operational status of the entity itself."
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:related": {
                "@id": "webuild:lei"
            },
            "skos:prefLabel": {
                "@id": "urn:uuid:7920a8c0-2261-4789-ae50-646d9c578dcd"
            },
            "skos:note": {
                "@language": "en",
                "@value": "A LEI registration describes the lifecycle and administrative status of an LEI within the Global LEI System. It may contain the initial registration date, last update, next renewal, registration status, managing LEI issuing organization and information about the validation of the associated reference data. It is distinct from the LEI code, the legal entity identified by that code and the reference data describing the entity. Consequently, the status of an LEI registration should not be interpreted as the legal or operational status of the entity itself."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "a registration record containing information about the administration of a Legal Entity Identifier by its managing LEI issuing organization"
            },
            "skos:altLabel": {
                "@id": "urn:uuid:6331e42f-3e01-408a-846c-404d92ac418b"
            },
            "dcterms:modified": {
                "@value": "2026-08-10T15:19:25.098Z",
                "@type": "xsd:dateTime"
            },
            "dcterms:created": {
                "@value": "2026-08-10T15:19:25.098Z",
                "@type": "xsd:dateTime"
            },
            "@type": "skos:Concept"
        },
        {
            "@id": "urn:uuid:7920a8c0-2261-4789-ae50-646d9c578dcd",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "LEI registration"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "urn:uuid:b88071cd-1127-451e-ac43-05d943b31ac7",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "next LEI renewal"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "urn:uuid:142afb8f-f945-4c25-a497-4e96d594fa39",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "LEI next renewal date"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "webuild:leinextrenewal",
            "term:orderedSynonym": {
                "@list": [
                    {
                        "@id": "urn:uuid:142afb8f-f945-4c25-a497-4e96d594fa39"
                    },
                    {
                        "@id": "urn:uuid:b88071cd-1127-451e-ac43-05d943b31ac7"
                    }
                ]
            },
            "term:orderedRelated": {
                "@list": [
                    {
                        "@id": "webuild:lei"
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "The LEI next renewal indicates the renewal deadline recorded for an LEI registration in the Global LEI System. Renewal involves confirming and, where necessary, updating the LEI reference data so that it can be revalidated by the managing LEI issuing organization. Passing this date without renewal may cause the LEI registration status to become LAPSED; it does not mean that the LEI code ceases to identify the entity. The value is distinct from the LEI initial registration date, LEI last update, an entity’s dissolution date, and the validity period of an EBWV attestation containing the LEI data."
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:related": {
                "@id": "webuild:lei"
            },
            "skos:prefLabel": {
                "@id": "urn:uuid:a3343d25-c030-455a-b0c3-e066807b6285"
            },
            "skos:note": {
                "@language": "en",
                "@value": "The LEI next renewal indicates the renewal deadline recorded for an LEI registration in the Global LEI System. Renewal involves confirming and, where necessary, updating the LEI reference data so that it can be revalidated by the managing LEI issuing organization. Passing this date without renewal may cause the LEI registration status to become LAPSED; it does not mean that the LEI code ceases to identify the entity. The value is distinct from the LEI initial registration date, LEI last update, an entity’s dissolution date, and the validity period of an EBWV attestation containing the LEI data."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "date and time by which the LEI information must next be renewed and re-certified by the legal entity"
            },
            "skos:altLabel": [
                {
                    "@id": "urn:uuid:142afb8f-f945-4c25-a497-4e96d594fa39"
                },
                {
                    "@id": "urn:uuid:b88071cd-1127-451e-ac43-05d943b31ac7"
                }
            ],
            "dcterms:modified": {
                "@value": "2026-08-10T15:17:45.663Z",
                "@type": "xsd:dateTime"
            },
            "dcterms:created": {
                "@value": "2026-08-10T15:17:45.663Z",
                "@type": "xsd:dateTime"
            },
            "@type": "skos:Concept"
        },
        {
            "@id": "urn:uuid:a3343d25-c030-455a-b0c3-e066807b6285",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "LEI next renewal"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "urn:uuid:db8e3f2a-96ea-4848-bfe8-915bcf9bd988",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "LEI legal entity"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "webuild:leilegalentity",
            "term:orderedRelated": {
                "@list": [
                    {
                        "@id": "webuild:lei"
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "An LEI legal entity is the subject identified by the LEI, rather than the LEI code, LEI record, registration entry or LEI issuing organization. It may be incorporated or constituted in another manner and may include, subject to Global LEI System eligibility rules, companies, partnerships, trusts, funds, governmental organizations, supranational organizations and certain branches or sole proprietors acting in a business capacity. It does not ordinarily include a natural person acting solely in a private capacity. The status of the LEI registration should be represented separately and may, for example, indicate that the registration is issued, lapsed, retired or annulled."
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:related": {
                "@id": "webuild:lei"
            },
            "skos:prefLabel": {
                "@id": "urn:uuid:db8e3f2a-96ea-4848-bfe8-915bcf9bd988"
            },
            "skos:note": {
                "@language": "en",
                "@value": "An LEI legal entity is the subject identified by the LEI, rather than the LEI code, LEI record, registration entry or LEI issuing organization. It may be incorporated or constituted in another manner and may include, subject to Global LEI System eligibility rules, companies, partnerships, trusts, funds, governmental organizations, supranational organizations and certain branches or sole proprietors acting in a business capacity. It does not ordinarily include a natural person acting solely in a private capacity. The status of the LEI registration should be represented separately and may, for example, indicate that the registration is issued, lapsed, retired or annulled."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "an entity described by an LEI record and uniquely identified within the Global LEI System by a Legal Entity Identifier"
            },
            "dcterms:modified": {
                "@value": "2026-08-10T15:15:36.584Z",
                "@type": "xsd:dateTime"
            },
            "dcterms:created": {
                "@value": "2026-08-10T15:15:18.464Z",
                "@type": "xsd:dateTime"
            },
            "@type": "skos:Concept"
        },
        {
            "@id": "urn:uuid:09788dcb-beaf-4655-a98e-d64c6c7bbe79",
            "suomi-meta:publicationStatus": {
