                "@value": "2026-04-28T11:45:50.776Z",
                "@type": "xsd:dateTime"
            },
            "@type": "skos:Concept"
        },
        {
            "@id": "webuild:registeredaddress",
            "term:orderedSynonym": {
                "@list": [
                    {
                        "@id": "urn:uuid:16c46f66-6bb9-4be9-b352-171d64eb6bdc"
                    }
                ]
            },
            "@type": "skos:Concept",
            "dcterms:created": {
                "@value": "2026-02-03T15:18:48.614Z",
                "@type": "xsd:dateTime"
            },
            "dcterms:modified": {
                "@value": "2026-08-17T14:14:26.112Z",
                "@type": "xsd:dateTime"
            },
            "dcterms:source": "https://semiceu.github.io/Core-Business-Vocabulary/releases/2.2.0/#LegalEntity.registeredaddress",
            "skos:altLabel": {
                "@id": "urn:uuid:16c46f66-6bb9-4be9-b352-171d64eb6bdc"
            },
            "skos:broader": {
                "@id": "webuild:address"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "the address at which the legal entity is legally registered"
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:note": {
                "@language": "en",
                "@value": "In almost all jurisdictions, Legal Entities must register a public address. This may or may not be the actual address at which the Legal Entity does its business, it is commonly the address of their lawyer or accountant, but it is the address to which formal communications can be sent. The registered address property points to the Address of the Registered Site. This property can be seen as a shorthand for this property path."
            },
            "skos:prefLabel": {
                "@id": "urn:uuid:b8a430a1-8ace-46ec-9c47-483967e840c8"
            },
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "term:orderedBroader": {
                "@list": [
                    {
                        "@id": "webuild:address"
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "In almost all jurisdictions, Legal Entities must register a public address. This may or may not be the actual address at which the Legal Entity does its business, it is commonly the address of their lawyer or accountant, but it is the address to which formal communications can be sent. The registered address property points to the Address of the Registered Site. This property can be seen as a shorthand for this property path."
                    }
                ]
            },
            "term:orderedSource": {
                "@list": [
                    "https://semiceu.github.io/Core-Business-Vocabulary/releases/2.2.0/#LegalEntity.registeredaddress"
                ]
            }
        },
        {
            "@id": "webuild:activity",
            "term:orderedSynonym": {
                "@list": [
                    {
                        "@id": "urn:uuid:8425ef72-a782-4413-86e7-19c41413e5c1"
                    },
                    {
                        "@id": "urn:uuid:64abbb6a-818b-48d7-a70d-d9acc42aa6c2"
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "Broad neutral concept. Use when the activity does not specifically need to be classified as economic, regulatory, administrative or other specialised activity.\n\nOR \n\nA more narrower concept that is anchored clearly in business, economic operators, and contextual purpose, rather than generic human action."
                    }
                ]
            },
            "term:orderedNarrower": {
                "@list": [
                    {
                        "@id": "webuild:economicactivity"
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:prefLabel": {
                "@id": "urn:uuid:760b4be2-8c0d-46e2-be0e-30d77cb2a146"
            },
            "skos:note": {
                "@language": "en",
                "@value": "Broad neutral concept. Use when the activity does not specifically need to be classified as economic, regulatory, administrative or other specialised activity.\n\nOR \n\nA more narrower concept that is anchored clearly in business, economic operators, and contextual purpose, rather than generic human action."
            },
            "skos:narrower": {
                "@id": "webuild:economicactivity"
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "organised doing, operation or process carried out for a purpose or result\n\nOR\n\na business-related undertaking, operation, or process carried out by a party or economic operator for a defined purpose within an economic, administrative, or regulatory context"
            },
