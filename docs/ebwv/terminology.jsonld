            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "temporary work agency"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "webuild:supplier",
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "A supplier may act as a seller, service provider, contractor, producer, distributor, or other provider, depending on the transaction. The role does not by itself imply that the supplier is the manufacturer, exporter, consignor, invoice issuer, or ultimate seller unless the same agent also performs those roles."
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:prefLabel": {
                "@id": "urn:uuid:ae548c2e-96f7-4fe8-91d2-97b6085b3a00"
            },
            "skos:note": {
                "@language": "en",
                "@value": "A supplier may act as a seller, service provider, contractor, producer, distributor, or other provider, depending on the transaction. The role does not by itself imply that the supplier is the manufacturer, exporter, consignor, invoice issuer, or ultimate seller unless the same agent also performs those roles."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "an agent that provides or undertakes to provide goods, services, works, or other deliverables to another agent within a business relationship or transaction"
            },
            "dcterms:modified": {
                "@value": "2026-08-17T14:30:07.731Z",
                "@type": "xsd:dateTime"
            },
            "dcterms:created": {
                "@value": "2026-08-17T14:30:07.731Z",
                "@type": "xsd:dateTime"
            },
            "@type": "skos:Concept"
        },
        {
            "@id": "urn:uuid:ae548c2e-96f7-4fe8-91d2-97b6085b3a00",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "supplier"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "webuild:statusconfirmation",
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "A status confirmation concerns the verification or formal acknowledgement of a status, rather than the status itself. It may be expressed as data, a statement, or an attestation and should identify the confirmed status, its subject, the confirming agent and, where relevant, its temporal validity. It should also be distinguished from the status of the confirmation process."
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:prefLabel": {
                "@id": "urn:uuid:ced0df0d-4963-47c4-a3a3-2273b9bd8b6e"
            },
            "skos:note": {
                "@language": "en",
                "@value": "A status confirmation concerns the verification or formal acknowledgement of a status, rather than the status itself. It may be expressed as data, a statement, or an attestation and should identify the confirmed status, its subject, the confirming agent and, where relevant, its temporal validity. It should also be distinguished from the status of the confirmation process."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "an assertion by a competent agent confirming that a particular status applies to an entity, relationship, process, right, or obligation at a specified time or during a specified period"
            },
            "dcterms:modified": {
                "@value": "2026-08-17T14:28:16.528Z",
                "@type": "xsd:dateTime"
            },
            "dcterms:created": {
                "@value": "2026-08-17T14:28:16.528Z",
                "@type": "xsd:dateTime"
            },
            "@type": "skos:Concept"
        },
        {
            "@id": "urn:uuid:ced0df0d-4963-47c4-a3a3-2273b9bd8b6e",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "status confirmation"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "webuild:stateofinsurance",
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "In the A1 and Posted Worker Notification contexts, the state of insurance is generally the State identified by the A1 certificate as having applicable social security legislation. It may differ from the person’s State of residence, nationality, employer establishment, or temporary place of work."
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:prefLabel": {
                "@id": "urn:uuid:85798cb4-b6c0-4179-849d-81b77ef38b49"
            },
            "skos:note": {
                "@language": "en",
                "@value": "In the A1 and Posted Worker Notification contexts, the state of insurance is generally the State identified by the A1 certificate as having applicable social security legislation. It may differ from the person’s State of residence, nationality, employer establishment, or temporary place of work."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "the state whose social security legislation applies to a person and under whose social security system the person is insured or otherwise covered during a specified period or activity"
            },
            "dcterms:modified": {
                "@value": "2026-08-17T14:26:28.307Z",
                "@type": "xsd:dateTime"
            },
            "dcterms:created": {
                "@value": "2026-08-17T14:26:28.307Z",
                "@type": "xsd:dateTime"
            },
            "@type": "skos:Concept"
        },
        {
            "@id": "urn:uuid:85798cb4-b6c0-4179-849d-81b77ef38b49",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "state of insurance"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "urn:uuid:3f0fd494-e98a-4d29-b99d-9399f3eb017b",
            "suomi-meta:publicationStatus": {
