        {
            "@id": "webuild:identifier",
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "An identifier may identify a person, organization, location, object, document, attestation or other entity. It may be represented by a string, number, code or URI, or as a structured resource containing the identifier value, identification scheme, issuing authority and validity information. An identifier is not necessarily globally unique; its uniqueness depends on the identification scheme and relevant context. Specific types of identifiers should be represented as narrower concepts or classified using an identifier type."
                    }
                ]
            },
            "term:orderedNarrower": {
                "@list": [
                    {
                        "@id": "webuild:legalidentifier"
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:prefLabel": {
                "@id": "urn:uuid:5c30f025-89ac-4fd8-96e4-ff61dab1db9e"
            },
            "skos:note": {
                "@language": "en",
                "@value": "An identifier may identify a person, organization, location, object, document, attestation or other entity. It may be represented by a string, number, code or URI, or as a structured resource containing the identifier value, identification scheme, issuing authority and validity information. An identifier is not necessarily globally unique; its uniqueness depends on the identification scheme and relevant context. Specific types of identifiers should be represented as narrower concepts or classified using an identifier type."
            },
            "skos:narrower": {
                "@id": "webuild:legalidentifier"
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "a reference assigned to an entity to distinguish it from other entities within a specified identification scheme or context"
            },
            "dcterms:modified": {
                "@value": "2026-08-10T15:08:31.398Z",
