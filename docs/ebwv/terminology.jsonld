            "@type": "skos:Concept"
        },
        {
            "@id": "webuild:correspondenceaddress",
            "term:orderedSynonym": {
                "@list": [
                    {
                        "@id": "urn:uuid:7a8e8b92-283b-4504-9917-80bc419d8339"
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "A correspondence address may differ from a registered address, residential address, domicile or principal place of business. Its designation does not necessarily indicate legal registration, residence or physical presence at that address."
                    }
                ]
            },
            "term:orderedBroader": {
                "@list": [
                    {
                        "@id": "webuild:address"
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:prefLabel": {
                "@id": "urn:uuid:89a93934-b3a9-49bc-bacb-13b3bf3f8bf3"
            },
            "skos:note": {
                "@language": "en",
                "@value": "A correspondence address may differ from a registered address, residential address, domicile or principal place of business. Its designation does not necessarily indicate legal registration, residence or physical presence at that address."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "a postal address designated by a person or organisation for receiving correspondence"
            },
            "skos:broader": {
                "@id": "webuild:address"
            },
            "skos:altLabel": {
                "@id": "urn:uuid:7a8e8b92-283b-4504-9917-80bc419d8339"
            },
