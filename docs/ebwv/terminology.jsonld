            "dcterms:modified": {
                "@value": "2026-04-14T05:49:17.855Z",
                "@type": "xsd:dateTime"
            },
            "http://purl.org/termed/properties/id": "ede07a51-68db-42a3-9713-ab618f5fbe66",
            "skos:broader": {
                "@id": "webuild:concept-7"
            },
            "skos:changeNote": "alternative definition:\n\"an identifier that is given to a legal entity at registration\"",
            "skos:definition": {
                "@language": "en",
                "@value": "an unambiguous structured identifier assigned to a legal entity by the competent authority that registered or recognised it"
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:note": {
                "@language": "en",
                "@value": "EU Core Business Vocabulary definition for \"legal identifier\" = The unambiguous structured reference assigned to the Legal Entity by the legal authority that registered it."
            },
            "skos:prefLabel": {
                "@id": "urn:uuid:ef3c5907-744c-4daa-a74d-0b881ee267d3"
            },
            "skos:related": [
