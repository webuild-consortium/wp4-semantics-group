            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "social security contributor"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "webuild:contributor",
            "term:orderedSynonym": {
                "@list": [
                    {
                        "@id": "urn:uuid:f7e1f96b-2579-4bec-8bad-fbe0932dad2a"
                    },
                    {
                        "@id": "urn:uuid:49cdb1af-5913-418a-a151-53384f08d9bb"
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "In an employment context, the contributor is normally the employer liable for contributions arising from the employment of workers. The concept may also cover a self-employed economic operator where applicable. The contributor is distinct from the authority issuing the attestation and from a third party that merely submits declarations or transmits payments on its behalf."
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:prefLabel": {
                "@id": "urn:uuid:7399d50e-ecdd-4269-86b9-8037475bf432"
            },
            "skos:note": {
                "@language": "en",
                "@value": "In an employment context, the contributor is normally the employer liable for contributions arising from the employment of workers. The concept may also cover a self-employed economic operator where applicable. The contributor is distinct from the authority issuing the attestation and from a third party that merely submits declarations or transmits payments on its behalf."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "the role of an economic operator whose fulfilment of legal obligations to declare and pay social security contributions is the subject of a social security contribution attestation"
            },
            "skos:altLabel": [
                {
                    "@id": "urn:uuid:f7e1f96b-2579-4bec-8bad-fbe0932dad2a"
                },
                {
                    "@id": "urn:uuid:49cdb1af-5913-418a-a151-53384f08d9bb"
                }
            ],
