        {
            "@id": "webuild:flagstate",
            "term:orderedSynonym": {
                "@list": [
                    {
                        "@id": "urn:uuid:241421a3-d980-417e-be2e-480892645055"
                    },
                    {
                        "@id": "urn:uuid:13c961ea-0795-4ee8-87de-7660e96b094b"
                    }
                ]
            },
            "term:orderedRelated": {
                "@list": [
                    {
                        "@id": "webuild:vessel"
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "The flag state is normally the state in whose ship register the vessel is registered. It is responsible for exercising jurisdiction and control over the vessel in administrative, technical and social matters. In maritime employment contexts, the flag state may be relevant to labour conditions, occupational safety, vessel certification and social-security obligations. It is distinct from the port state, coastal state and the states associated with the vessel owner, employer or crew member."
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:related": {
                "@id": "webuild:vessel"
            },
            "skos:prefLabel": {
                "@id": "urn:uuid:ae0011ac-ae17-499a-b6d9-58e96649345a"
            },
            "skos:note": {
                "@language": "en",
                "@value": "The flag state is normally the state in whose ship register the vessel is registered. It is responsible for exercising jurisdiction and control over the vessel in administrative, technical and social matters. In maritime employment contexts, the flag state may be relevant to labour conditions, occupational safety, vessel certification and social-security obligations. It is distinct from the port state, coastal state and the states associated with the vessel owner, employer or crew member."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "a state that has granted its nationality to a vessel and authorised the vessel to fly its flag"
            },
            "skos:altLabel": [
                {
                    "@id": "urn:uuid:241421a3-d980-417e-be2e-480892645055"
                },
                {
                    "@id": "urn:uuid:13c961ea-0795-4ee8-87de-7660e96b094b"
                }
            ],
