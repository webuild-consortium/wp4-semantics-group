        {
            "@id": "webuild:staffaverage",
            "term:orderedSynonym": {
                "@list": [
                    {
                        "@id": "urn:uuid:aa492878-153a-4824-b7c5-ac561ce9a473"
                    },
                    {
                        "@id": "urn:uuid:5fdb8334-fee3-4209-8f31-33b863b6db2c"
                    },
                    {
                        "@id": "urn:uuid:112c021f-35d1-4880-928a-d0fe03ff413f"
                    },
                    {
                        "@id": "urn:uuid:b62adc8a-9355-4aa7-83d0-4c15b065691c"
                    },
                    {
                        "@id": "urn:uuid:648f1370-0b4e-4748-b1dd-ccf3c2ecdbdf"
                    }
                ]
            },
            "@type": "skos:Concept",
            "dcterms:created": {
                "@value": "2026-08-17T14:22:30.152Z",
                "@type": "xsd:dateTime"
            },
            "dcterms:modified": {
                "@value": "2026-08-17T14:22:30.152Z",
                "@type": "xsd:dateTime"
            },
            "skos:altLabel": [
                {
                    "@id": "urn:uuid:648f1370-0b4e-4748-b1dd-ccf3c2ecdbdf"
                },
                {
                    "@id": "urn:uuid:b62adc8a-9355-4aa7-83d0-4c15b065691c"
                },
                {
                    "@id": "urn:uuid:112c021f-35d1-4880-928a-d0fe03ff413f"
                },
                {
                    "@id": "urn:uuid:5fdb8334-fee3-4209-8f31-33b863b6db2c"
                },
                {
                    "@id": "urn:uuid:aa492878-153a-4824-b7c5-ac561ce9a473"
                }
            ],
            "skos:definition": {
                "@language": "en",
                "@value": "the average number of persons employed by an employer during a specified reporting period, calculated in accordance with the applicable rules for reporting or determining social security contributions"
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:note": {
                "@language": "en",
                "@value": "The applicable legislation or reporting scheme determines the reference period, averaging method and categories of persons included. The measure should not be interpreted as a full-time-equivalent figure unless the relevant rules explicitly require an FTE calculation. For EU-wide use, average number of employees is the clearest preferred label when only employees are counted."
            },
            "skos:prefLabel": {
                "@id": "urn:uuid:bacc4ce4-18b2-4b11-be02-2c2c26affb87"
            },
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "The applicable legislation or reporting scheme determines the reference period, averaging method and categories of persons included. The measure should not be interpreted as a full-time-equivalent figure unless the relevant rules explicitly require an FTE calculation. For EU-wide use, average number of employees is the clearest preferred label when only employees are counted."
                    }
                ]
            }
        },
        {
            "@id": "urn:uuid:bacc4ce4-18b2-4b11-be02-2c2c26affb87",
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "skos-xl:literalForm": {
                "@language": "en",
                "@value": "staff average"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "webuild:role",
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "A role is context-dependent and may be limited to a particular period or activity. The same agent may hold several roles simultaneously, such as issuer, holder, representative, employer, buyer, or seller. A role should be distinguished from the agent’s inherent type, occupation, legal status, or organisational position."
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:prefLabel": {
                "@id": "urn:uuid:b57b9057-77eb-42d2-8b1b-0dd793208aa2"
            },
            "skos:note": {
                "@language": "en",
                "@value": "A role is context-dependent and may be limited to a particular period or activity. The same agent may hold several roles simultaneously, such as issuer, holder, representative, employer, buyer, or seller. A role should be distinguished from the agent’s inherent type, occupation, legal status, or organisational position."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "a function, capacity, or position assumed by or assigned to an agent within a particular context, relationship, or process"
            },
            "dcterms:modified": {
                "@value": "2026-08-17T14:18:18.282Z",
