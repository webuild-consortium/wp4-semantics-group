            "skos:definition": {
                "@language": "en",
                "@value": "a word, phrase or structured set of name components used to identify, designate or refer to an entity"
            },
            "skos:example": {
                "@language": "en",
                "@value": "A business identity attestation includes the registered legal name of the company, while a person identification attestation includes the person’s given name and family name."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            }
        },
        {
            "@id": "webuild:fullname",
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "A full name may comprise given names, family names and other name components, arranged according to the relevant linguistic, cultural or administrative convention. It should not be assumed to be a mechanical concatenation of structured name fields. The concept does not necessarily mean a person’s legal or officially registered name unless this is required by the applicable context or application profile."
                    }
                ]
            },
            "term:orderedBroader": {
                "@list": [
                    {
                        "@id": "webuild:name"
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:prefLabel": {
                "@id": "urn:uuid:10736405-a046-4be9-b565-1182fae02cfe"
            },
            "skos:note": {
                "@language": "en",
                "@value": "A full name may comprise given names, family names and other name components, arranged according to the relevant linguistic, cultural or administrative convention. It should not be assumed to be a mechanical concatenation of structured name fields. The concept does not necessarily mean a person’s legal or officially registered name unless this is required by the applicable context or application profile."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "the name of a person expressed as a single textual value rather than as separately represented name components"
            },
            "skos:broader": {
                "@id": "webuild:name"
            },
