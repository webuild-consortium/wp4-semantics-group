        {
            "@id": "webuild:temporaryworkagency",
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "The temporary-work agency remains the worker’s employer while the user undertaking directs the worker’s day-to-day work. In a PWN context, the agency may act as the posting undertaking when it assigns a worker across borders. It should be distinguished from a recruitment or placement agency that only introduces workers to employers."
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:prefLabel": {
                "@id": "urn:uuid:aef4ea02-1d91-4023-b069-d7cfd263bb73"
            },
            "skos:note": {
                "@language": "en",
                "@value": "The temporary-work agency remains the worker’s employer while the user undertaking directs the worker’s day-to-day work. In a PWN context, the agency may act as the posting undertaking when it assigns a worker across borders. It should be distinguished from a recruitment or placement agency that only introduces workers to employers."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "an agent that employs temporary agency workers for the purpose of assigning them to user undertakings, where they work temporarily under the supervision and direction of those undertakings"
            },
            "dcterms:modified": {
                "@value": "2026-08-17T14:32:03.408Z",
                "@type": "xsd:dateTime"
            },
            "dcterms:created": {
                "@value": "2026-08-17T14:32:03.408Z",
                "@type": "xsd:dateTime"
            },
            "@type": "skos:Concept"
        },
        {
            "@id": "urn:uuid:aef4ea02-1d91-4023-b069-d7cfd263bb73",
            "suomi-meta:publicationStatus": {
