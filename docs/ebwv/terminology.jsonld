            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:prefLabel": {
                "@id": "urn:uuid:846f3541-0f10-4020-b2c3-3a1decc4bbc2"
            },
            "skos:narrower": [
                {
                    "@id": "webuild:powerofattorney"
                },
                {
                    "@id": "webuild:concept-75"
                }
            ],
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "a legally or contractually valid empowerment by which an agent is granted the right to perform one or more actions, exercise specified powers, or act in a defined capacity towards other parties, within a stated scope and validity, and which may be presented and verified as evidence of authority in the EU Business Wallet context"
            },
            "dcterms:modified": {
