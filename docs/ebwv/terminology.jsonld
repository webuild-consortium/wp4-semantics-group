                "@type": "xsd:dateTime"
            },
            "@type": "skos:Concept"
        },
        {
            "@id": "webuild:telephone",
            "term:orderedSynonym": {
                "@list": [
                    {
                        "@id": "urn:uuid:7c026a1b-c532-485b-9c8c-04902719321b"
                    },
                    {
                        "@id": "urn:uuid:802b9b11-4a97-4f27-ad17-f31d4120870c"
                    }
                ]
            },
            "term:orderedRelated": {
                "@list": [
                    {
                        "@id": "webuild:contactpoint"
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "A telephone is associated with a contact point and may be a fixed-line, mobile, organizational, functional or service-specific number. The value should include the international country calling code when used in cross-border contexts. Its presence does not imply that the number supports text messaging or that it is verified, preferred or continuously monitored. Formatting and cardinality requirements should be defined in the applicable SHACL application profile."
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:related": {
                "@id": "webuild:contactpoint"
            },
            "skos:prefLabel": {
                "@id": "urn:uuid:9cb5a28e-f401-4731-a792-89803cbf93b3"
            },
            "skos:note": {
                "@language": "en",
                "@value": "A telephone is associated with a contact point and may be a fixed-line, mobile, organizational, functional or service-specific number. The value should include the international country calling code when used in cross-border contexts. Its presence does not imply that the number supports text messaging or that it is verified, preferred or continuously monitored. Formatting and cardinality requirements should be defined in the applicable SHACL application profile."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "a telephone number through which an entity can be contacted"
            },
            "skos:altLabel": [
                {
                    "@id": "urn:uuid:7c026a1b-c532-485b-9c8c-04902719321b"
                },
                {
                    "@id": "urn:uuid:802b9b11-4a97-4f27-ad17-f31d4120870c"
                }
            ],
            "dcterms:modified": {
                "@value": "2026-08-10T15:06:58.19Z",
                "@type": "xsd:dateTime"
            },
            "dcterms:created": {
                "@value": "2026-04-28T14:02:26.749Z",
                "@type": "xsd:dateTime"
            },
            "@type": "skos:Concept"
        },
        {
            "@id": "webuild:email",
            "term:orderedSynonym": {
                "@list": [
                    {
                        "@id": "urn:uuid:679ff440-0af1-4ac0-acff-dd64e01ebaca"
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "An email is associated with a contact point and provides an address for sending electronic messages to the entity represented by that contact point. It may be a personal, organizational, functional or service-specific address. Its presence does not imply that the address is verified, preferred or actively monitored. Formatting and cardinality requirements should be specified in the applicable SHACL application profile."
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
