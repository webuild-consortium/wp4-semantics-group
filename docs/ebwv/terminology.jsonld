{
    "@graph": [
        {
            "@id": "webuild:terms",
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "In contracts and business documents, terms may address matters such as price, payment, delivery, performance, liability, validity, termination, and dispute resolution. They may be stated directly in the document or incorporated by reference. The concept should be distinguished from term meaning a word or expression used in a terminology."
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:prefLabel": {
                "@id": "urn:uuid:bf9ab528-b364-460c-930f-b450afdb41f5"
            },
            "skos:note": {
                "@language": "en",
                "@value": "In contracts and business documents, terms may address matters such as price, payment, delivery, performance, liability, validity, termination, and dispute resolution. They may be stated directly in the document or incorporated by reference. The concept should be distinguished from term meaning a word or expression used in a terminology."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "provisions that establish the rights, obligations, conditions, limitations, and other rules governing an agreement, transaction, or business relationship"
            },
            "dcterms:modified": {
