        {
            "@id": "webuild:constructionsector",
            "term:orderedSynonym": {
                "@list": [
                    {
                        "@id": "urn:uuid:bd831ea7-bc8f-4ac6-b47e-ef434d1876d8"
                    }
                ]
            },
            "term:orderedRelated": {
                "@list": [
                    {
                        "@id": "webuild:activity"
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "In the context of Posted Worker Notifications, the concept is used to indicate whether an employer or another economic operator using the services of a posted worker is active in the construction sector. Sector membership may be determined using an applicable economic activity classification or national rules."
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:related": {
                "@id": "webuild:activity"
            },
            "skos:prefLabel": {
                "@id": "urn:uuid:62edeaaa-6c33-4869-8c2e-f4c0703f22ee"
            },
            "skos:note": {
                "@language": "en",
                "@value": "In the context of Posted Worker Notifications, the concept is used to indicate whether an employer or another economic operator using the services of a posted worker is active in the construction sector. Sector membership may be determined using an applicable economic activity classification or national rules."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "a sector of economic activity comprising the development, construction, alteration, renovation, repair and demolition of buildings and civil engineering works, including site preparation, installation, finishing and other specialised construction activities"
            },
            "skos:altLabel": {
                "@id": "urn:uuid:bd831ea7-bc8f-4ac6-b47e-ef434d1876d8"
            },
