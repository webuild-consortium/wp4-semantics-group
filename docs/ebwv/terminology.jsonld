                "@value": "end date"
            },
            "@type": "skos-xl:Label"
        },
        {
            "@id": "webuild:enddate",
            "term:orderedRelated": {
                "@list": [
                    {
                        "@id": "webuild:startdate"
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "Whether the end date is inclusive or exclusive, and whether a specific time or time zone applies, depends on the relevant context or application profile."
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:related": {
                "@id": "webuild:startdate"
            },
            "skos:prefLabel": {
                "@id": "urn:uuid:3f0fd494-e98a-4d29-b99d-9399f3eb017b"
            },
            "skos:note": {
                "@language": "en",
                "@value": "Whether the end date is inclusive or exclusive, and whether a specific time or time zone applies, depends on the relevant context or application profile."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "a calendar date that marks the end of a period, activity, status, relationship, validity or other time-bounded occurrence"
            },
            "dcterms:modified": {
                "@value": "2026-08-17T14:24:33.763Z",
                "@type": "xsd:dateTime"
            },
            "dcterms:created": {
                "@value": "2026-08-10T14:31:39.363Z",
                "@type": "xsd:dateTime"
            },
            "@type": "skos:Concept"
        },
        {
            "@id": "webuild:startdate",
            "term:orderedRelated": {
                "@list": [
                    {
                        "@id": "webuild:enddate"
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "The meaning of the start date is determined by its context. It should be distinguished from an issue date, registration date, submission date, or validity date unless the relevant process explicitly treats them as equivalent."
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:related": {
                "@id": "webuild:enddate"
            },
            "skos:prefLabel": {
                "@id": "urn:uuid:23b65578-687d-4f46-9456-e627d5136fde"
            },
            "skos:note": {
                "@language": "en",
                "@value": "The meaning of the start date is determined by its context. It should be distinguished from an issue date, registration date, submission date, or validity date unless the relevant process explicitly treats them as equivalent."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "the calendar date on which an activity, period, relationship, status, right, obligation, or other temporally bounded circumstance begins"
            },
            "dcterms:modified": {
