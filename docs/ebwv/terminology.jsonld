        {
            "@id": "webuild:a1",
            "term:orderedSynonym": {
                "@list": [
                    {
                        "@id": "urn:uuid:d341529b-bbc7-4bce-a094-ed6f9b558541"
                    }
                ]
            },
            "term:orderedNote": {
                "@list": [
                    {
                        "@language": "en",
                        "@value": "An A1 certificate is used particularly when a person is posted to work in another state or works in two or more states. It does not constitute a work permit or attest compliance with employment or posted-worker conditions."
                    }
                ]
            },
            "suomi-meta:publicationStatus": {
                "@id": "http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/DRAFT"
            },
            "suomi-meta:modifier": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "suomi-meta:creator": "5dc030a4-740f-4dde-9548-4e6e797899d8",
            "skos:prefLabel": {
                "@id": "urn:uuid:5efb140e-db79-428a-969f-7cd9c8589c9a"
            },
            "skos:note": {
                "@language": "en",
                "@value": "An A1 certificate is used particularly when a person is posted to work in another state or works in two or more states. It does not constitute a work permit or attest compliance with employment or posted-worker conditions."
            },
            "skos:inScheme": {
                "@id": "https://iri.suomi.fi/terminology/webuild/"
            },
            "skos:definition": {
                "@language": "en",
                "@value": "a certificate issued by a competent social security institution that attests which state’s social security legislation applies to a person under the rules on the coordination of social security systems and, where applicable, the period and conditions of that application"
            },
            "skos:altLabel": {
                "@id": "urn:uuid:d341529b-bbc7-4bce-a094-ed6f9b558541"
            },
