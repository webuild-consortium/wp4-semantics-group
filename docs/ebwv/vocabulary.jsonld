        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/liabilityorcontribution", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:licenceKey",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:GLN",
        "rdfs:range": "ebwv:GS1CompanyPrefix",
        "rdfs:label": "gs1 licence key",
        "rdfs:comment": {
            "@value": "<div>the GS1 Company Prefix assigned to the organization</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/licenceKey", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:locatorDesignator",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:Address",
        "rdfs:range": {
            "@type": "ows:Class",
            "owl:unionOf": ["xsd:string", "xsd:integer"]
        },
        "rdfs:label": "locator designator",
        "rdfs:comment": {
            "@value": "<div>an alphanumeric identifier assigned within a thoroughfare or property context to designate a specific access point, building, unit, or sub-unit</div>",
