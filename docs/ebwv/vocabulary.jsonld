        "rdfs:range": "ebwv:EconomicOperator",
        "rdfs:label": "host entity",
        "rdfs:comment": {
            "@value": "<div>an economic operator established or operating in the host country that receives, supervises, coordinates or otherwise benefits from the work carried out by a posted worker during a posting period</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
