        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:LegalEntityIdentifier",
        "rdfs:range": ["ebwv:LegalPerson", "ebwv:PublicSectorBody"],
        "rdfs:label": "legal entity as registered at lei issuer",
        "rdfs:comment": {
            "@value": "<div>an organisation, legal person, trust, fund, government body, international organisation or other legally or administratively recognised entity that is eligible to be identified by a Legal Entity Identifier under the Global LEI System</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/leilegalentity", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
