        "rdfs:label": "tax reference number",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/tin", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
