    "@included": [{
        "@id": "https://w3id.org/ebwv#",
        "@type": "owl:Ontology",
        "dc:title": {
            "@value": "European Business Wallet Vocabulary v0.1",
            "@language": "en"
        },
        "dc:description": {
            "@value": "Vocabulary used by the Verifiable Credentials of the European Business Wallet Framework",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:seeAlso": "https://webuild-consortium.github.io/wp4-semantics-group/ebwv",
        "dc:date": "2026-09-17"
    }, {
        "@id": "ebwv:a1",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:PostedWorkerNotification",
        "rdfs:range": "xsd:anyURI",
        "rdfs:label": "a1 certificate",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/a1", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:acceptedAt",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:GovernanceRulebook",
        "rdfs:range": "xsd:dateTime",
        "rdfs:label": "accepted at",
        "rdfs:comment": {
            "@value": "<div>Datetime when the rulebook was accepted. May differ from issuance time in an outbound flow where a credential is issued to an existing member based on a previously completed onboarding flow.</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/acceptedat", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:accountName",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:BankAccount",
        "rdfs:range": "xsd:string",
        "rdfs:label": "account name",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/accountname", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:accountType",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:BankAccount",
        "rdfs:range": "ebwv:AccountType",
        "rdfs:label": "account type",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/banktype", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:activity",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:Company",
        "rdfs:range": "ebwv:Nace21",
        "rdfs:label": "main activity of company",
        "rdfs:comment": {
            "@value": "<div>organised doing, operation or process carried out for a purpose or result</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/activity", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:hasAddress",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:Site",
        "rdfs:range": "ebwv:Address",
        "rdfs:label": "hasAddress",
        "rdfs:comment": {
            "@value": "<div>the address of an entity, provided the address is not of a specific type like registered address or temporary address</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/hasaddress", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:addressArea",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:Address",
        "rdfs:range": "xsd:string",
        "rdfs:label": "address area",
        "rdfs:comment": {
            "@value": "<div>the name of a geographic area that groups addresses</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/addressarea", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:administrativeRepresentative",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:EconomicOperator",
        "rdfs:range": "ebwv:Person",
        "rdfs:label": "administrative representative",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/administrativerepresentative", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:adminUnitL1",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:Address",
        "rdfs:range": "ebwv:CountryCode",
        "rdfs:label": "administrative unit level 1",
        "rdfs:comment": {
            "@value": "<div>the name of the uppermost level of the address, almost always a country</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/adminUnitL1", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:adminUnitL2",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:Address",
        "rdfs:range": "xsd:string",
        "rdfs:label": "administrative unit level 2",
        "rdfs:comment": {
            "@value": "<div>The name of a secondary level/region of the address, usually a county, state or other such area that typically encompasses several localities.</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/adminUnitL2", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:alternativeName",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:Person",
        "rdfs:range": "xsd:string",
        "rdfs:label": "alternative name",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/alternativename", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:amount",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:MonetaryAmount",
        "rdfs:range": "xsd:float",
        "rdfs:label": "amount",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/amount", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:assignment",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:PostedWorkerNotification",
        "rdfs:range": "ebwv:WorkAssignment",
        "rdfs:label": "assignment",
        "rdfs:comment": {
            "@value": "<div>a formal allocation of a role, mandate, responsibility, task, right, or duty to an identified party or agent within a defined context</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/assignment", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:attestationLegalCategory",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:ElectronicAttestationOfAttributes",
        "rdfs:range": ["ebwv:AttestationLegalCategory", {
            "@type": "owl:class",
            "owl:oneOf": ["ebwv:QEAA", "ebwv:Pub-EAA", "ebwv:EAA"]
        }],
        "rdfs:label": "attestation legal category",
        "rdfs:comment": {
            "@value": "<div>a categorization of electronic attestations of attributes into three primary types, each associated with a distinct level of assurance and legal effect</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/attestationlegalcategory", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:averagePeriodWorkforce",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:SocialSecurityContribution",
        "rdfs:range": "xsd:string",
        "rdfs:label": "average period workforce",
        "rdfs:comment": {
            "@value": "<div>average number of employed persons for the reporting period</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/averageperiodworkforce", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:birthName",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:Person",
        "rdfs:range": "xsd:string",
        "rdfs:label": "birth name",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/birthname", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:businessEntity",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:DUNS",
        "rdfs:range": "ebwv:Company",
        "rdfs:label": "business entity",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/businessEntity", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:buyer",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:PaymentTerms",
        "rdfs:range": "xsd:anyURI",
        "rdfs:label": "buyer",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/buyer", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:citizenship",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:Person",
        "rdfs:range": "ebwv:CountryCode",
        "rdfs:label": "citizenship",
        "rdfs:comment": {
            "@value": "<div>the legal bond between a natural person and a state, recognised under national law, which establishes membership in that state and entails associated rights and obligations</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/citizenship", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:complianceStatus",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:SocialSecurityContribution",
        "rdfs:range": ["xsd:string", "skos:Concept"],
        "rdfs:label": "compliance status",
        "rdfs:comment": {
            "@value": "<div>in the SSC context, the assessed status of the fulfilment of the covered obligations</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/compliancestatus", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:constructionSector",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:EconomicOperator",
        "rdfs:range": "xsd:boolean",
        "rdfs:label": "construction sector",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/constructionsector", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:contactPoint",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": {
            "@type": "owl:Class",
            "owl:unionOf": ["ebwv:Person", "ebwv:EconomicOperator"]
        },
        "rdfs:range": "ebwv:ContactPoint",
        "rdfs:label": "contact point",
        "rdfs:comment": {
            "@value": "<div>a designated communication channel or organisational function through which an entity can be contacted for a specific purpose</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/contactpoint", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:contributor",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:SocialSecurityContribution",
        "rdfs:range": "ebwv:EconomicOperator",
        "rdfs:label": "contributor",
        "rdfs:comment": {
            "@value": "<div>The economic operator that is the employer subject of a social security contribution attestation.</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/contributor", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:correspondenceAddress",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": {
            "@type": "owl:Class",
            "owl:unionOf": ["ebwv:Company", "ebwv:LegalPerson"]
        },
        "rdfs:range": "ebwv:Address",
        "rdfs:label": "correspondence Address",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/correspondenceaddress", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:countryOfBirth",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:Person",
        "rdfs:range": "ebwv:Location",
        "rdfs:label": "country of birth",
        "rdfs:comment": {
            "@value": "<div>the sovereign state within whose territory a person's birth was officially registered</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/countryofbirth", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:countryOfDeath",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:Person",
        "rdfs:range": "ebwv:Location",
        "rdfs:label": "country of death",
        "rdfs:comment": {
            "@value": "<div>the sovereign state within whose territory a person's death was officially registered</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/countryofdeath", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:coverageStatement",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:SocialSecurityContribution",
        "rdfs:range": "xsd:string",
        "rdfs:label": "coverage statement",
        "rdfs:comment": {
            "@value": "<div>a human-readable statement describing the reporting scope covered by the attestation</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/coveragestatement", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:coveredObligationType",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:SocialSecurityContribution",
        "rdfs:range": "xsd:string",
        "rdfs:label": "covered obligation type",
        "rdfs:comment": {
            "@value": "<div>the type of obligation that is covered by the attestation; in the case of a SSC, this covers for example social security, employment-related contribution, reporting, or payment obligation</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/coveredobligationtype", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:currency",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": {
            "@type": "owl:Class",
            "owl:unionOf": ["ebwv:MonetaryAmount", "ebwv:PaymentTerms"]
        },
        "rdfs:range": "ebwv:Currency",
        "rdfs:label": "currency",
        "rdfs:comment": {
            "@value": "<div>a recognised monetary unit used to express prices, payments, liabilities, values, or other monetary amounts in a business, financial, administrative, or regulatory context</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/currency", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:dateOfBirth",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": {
            "@type": "owl:Class",
            "owl:unionOf": ["ebwv:Person", "ebwv:NaturalPerson"]
        },
        "rdfs:range": "xsd:date",
        "rdfs:label": "date of birth",
        "rdfs:comment": {
            "@value": "<div>the point in time on which the person was born</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/dateofbirth", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:dateOfDeath",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:Person",
        "rdfs:range": "xsd:date",
        "rdfs:label": "date of death",
        "rdfs:comment": {
            "@value": "<div>the calendar date on which a person is recorded or attested as having died</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/dateofdeath", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:dateOfRegistration",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": {
            "@type": "owl:Class",
            "owl:unionOf": ["ebwv:Company", "ebwv:LegalPerson"]
        },
        "rdfs:range": "xsd:date",
        "rdfs:label": "date of registration",
        "rdfs:comment": {
            "@value": "<div>the date on which the legal entity has registered in some jurisdiction for regulatory and / or for tax purposes</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/dateofregistration", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:deliveryLocation",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:PaymentTerms",
        "rdfs:range": ["ebwv:Location", "ebwv:Address"],
        "rdfs:label": "delivery location",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/deliverylocation", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:domicile",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:Person",
        "rdfs:range": "ebwv:Address",
        "rdfs:label": "domicile",
        "rdfs:comment": {
            "@value": "<div>the address representing the place that a person treats as their permanent home, as recorded, declared, or attested in a given context</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/domicile", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:duration",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:WorkAssignment",
        "rdfs:range": "ebwv:PeriodOfTime",
        "rdfs:label": "duration",
        "rdfs:comment": {
            "@value": "<div>a temporal length representing how long an activity, status, validity period, assignment, mandate, process, event, or other time-bound condition lasts</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
