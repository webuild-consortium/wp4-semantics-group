        "rdfs:subClassOf": ["cred:CredentialSubject"],
        "rdfs:label": "Posted Worker Notification",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/postedworkernotification", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:PowerOfAttorney",
        "@type": "rdfs:Class",
        "rdfs:subClassOf": ["cred:CredentialSubject"],
        "rdfs:label": "Power of attorney",
        "rdfs:isDefinedBy": "https://sanastot.suomi.fi/en/terminology/webuild/concept/powerofattorney",
        "vs:term_status": "stable",
        "mentioned": [{
            "@id": "https://w3id.org/ebwv/v0.1",
            "@type": "jsonld:Context"
        }]
    }, {
        "@id": "ebwv:PublicSectorBody",
        "@type": "rdfs:Class",
        "rdfs:label": "public sector body",
        "rdfs:comment": {
            "@value": "<div>public sector body’ means a Union entity, a national, state, regional or local authority, a body governed by public law or an association formed by one or several such entities or bodies , or a private entity mandated by at least one such entities, authorities, bodies or associations to provide public services, when acting under such a mandate</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/publicsectorbody", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:ScopeOfAuthorization",
        "@type": "rdfs:Class",
        "rdfs:label": "Scope Of Authorization",
        "rdfs:comment": {
            "@value": "<div>the actions, matters, transactions, roles or circumstances for which an agent is authorised to act on behalf of another person or entity</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/scopeofauthorization", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:Site",
        "@type": "rdfs:Class",
        "rdfs:label": "Site",
        "rdfs:comment": {
            "@value": "<div>a place, premises or location at which an organisation is present or located</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/site", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:SocialSecurityContribution",
        "@type": "rdfs:Class",
        "rdfs:subClassOf": ["cred:CredentialSubject"],
        "rdfs:label": "Social Security Contribution",
        "rdfs:comment": {
            "@value": "<div>A social security contribution attestation is an attestation issued by a competent authority or authorized body confirming information about an employer’s fulfilment of obligations related to social security contributions arising from the employment of workers.</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/socialsecuritycontribution", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:StatutoryPartner",
        "@type": "rdfs:Class",
        "rdfs:label": "Statutory Partner",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/statutorypartner", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:TypeOfEmployment",
        "@type": "rdfs:Class",
        "rdfs:label": "Type Of Employment",
        "rdfs:comment": {
            "@value": "<div>the category or form of an employment relationship, indicating how a worker is employed or engaged by an employer</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/typeofemployment", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
