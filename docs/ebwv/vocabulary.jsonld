        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:BeneficialOwnership",
        "rdfs:range": "ebwv:TransparencyRegisterEntry",
        "rdfs:label": "transparency register",
        "rdfs:comment": {
            "@value": "<div>beneficial owners as recorded in the transparency register</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/transparencyregister", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:transparencyRegisterExtract",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:KycLegalEntity",
        "rdfs:range": "ebwv:TransparencyRegisterExtract",
        "rdfs:label": "transparency register extract",
        "rdfs:comment": {
            "@value": "<div>a transparency register extract obtained for the focus legal entity</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/transparencyregisterextract", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:type",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:VATRegistrationUnit",
        "rdfs:range": "xsd:string",
        "rdfs:label": "type",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/type", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:typeOfEmployment",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": {
            "@type": "owl:Class",
            "owl:unionOf": ["ebwv:A1Certificate", "ebwv:PostedWorkerNotification"]
        },
        "rdfs:range": ["ebwv:TypeOfEmployment", {
            "@type": "owl:class",
            "owl:oneOf": ["ebwv:Permanent", "ebwv:Temporary"]
        }],
        "rdfs:label": "type of employment",
        "rdfs:comment": {
            "@value": "<div>the category or form of an employment relationship, indicating how a worker is employed or engaged by an employer</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/typeofemployment", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:typeOfRepresentation",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": {
            "@type": "owl:Class",
            "owl:unionOf": ["ebwv:LegalRepresentative", "ebwv:StatutoryPartner"]
        },
        "rdfs:range": ["ebwv:TypeOfRepresentation", {
            "@type": "owl:class",
            "owl:oneOf": ["ebwv:Alone", "ebwv:Jointly"]
        }],
        "rdfs:label": "type of representation",
        "rdfs:comment": {
            "@value": "<div>specifies how a representative may act on behalf of the principal, meaning whether they can act alone or only together with others.</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/typeofrepresentation", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:ultimateParent",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:KycLegalEntity",
        "rdfs:range": {
            "@type": "ows:Class",
            "owl:unionOf": ["ebwv:LimitedLiabilityCompany", "ebwv:Partnership"]
        },
        "rdfs:label": "ultimate parent",
        "rdfs:comment": {
            "@value": "<div>the ultimate (top) parent company of the focus legal entity</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/ultimateparent", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:url",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": {
            "@type": "owl:Class",
            "owl:unionOf": ["ebwv:GovernanceRulebook", "ebwv:EvidenceData"]
        },
        "rdfs:range": "xsd:anyURI",
        "rdfs:label": "url",
        "rdfs:comment": {
            "@value": "<div>Reference (URL) to the online source of the specified document (e.g. governance rulebook, iso certificate, etc.)</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/url", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:validFromDate",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:TransparencyRegisterExtract",
        "rdfs:range": "xsd:date",
        "rdfs:label": "valid from date",
        "rdfs:comment": {
            "@value": "<div>the date from which the transparency register extract is valid</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/validfromdate", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:verificationDate",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:EvidenceData",
        "rdfs:range": "xsd:date",
        "rdfs:label": "verification date",
        "rdfs:comment": {
            "@value": "<div>the date on which the verification was performed</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/verificationdate", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:version",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:GovernanceRulebook",
        "rdfs:range": "xsd:string",
        "rdfs:label": "verson",
        "rdfs:comment": {
            "@value": "<div>Version of the online rulebook at the time of acceptance.</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/version", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:votingRightsBeneficialOwner",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:BeneficialOwnershipVariant",
        "rdfs:range": "ebwv:BeneficialOwner",
        "rdfs:label": "voting rights beneficial owner",
        "rdfs:comment": {
            "@value": "<div>a beneficial owner determined on the basis of voting rights - a natural person who, directly or indirectly, controls a share of the voting rights (Stimmrechte) of the focus legal entity that reaches the threshold of the enclosing calculation method (more than 25 percent under the standard method, or the 10 or 25 percent threshold of the accumulation and domination methods) (section 3(2) sentence 1 no. 2 GwG)</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/votingrightsbeneficialowner", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:website",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:ContactPoint",
        "rdfs:range": "xsd:anyURI",
        "rdfs:label": "website",
        "rdfs:comment": {
            "@value": "<div>website of the legal entity</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/website", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:A1Certificate",
        "@type": "rdfs:Class",
        "rdfs:subClassOf": ["cred:CredentialSubject"],
        "rdfs:label": "A1 Certificate",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/a1certificate", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:Address",
        "@type": "rdfs:Class",
        "rdfs:label": "Address",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/address", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:Agent",
        "@type": "rdfs:Class",
        "rdfs:label": "Agent",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/agent", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:AttestationLegalCategory",
        "@type": "rdfs:Class",
        "rdfs:label": "Attestation Legal Category",
        "rdfs:comment": {
            "@value": "<div>a categorization of electronic attestations of attributes into three primary types, each associated with a distinct level of assurance and legal effect</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/attestationlegalcategory", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:BankAccount",
        "@type": "rdfs:Class",
        "rdfs:subClassOf": ["cred:CredentialSubject"],
        "rdfs:label": "Bank Account",
        "rdfs:comment": {
            "@value": "<div>an account held with a credit institution or payment service provider that enables a legal or natural person to receive, hold, and transfer funds</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/bankaccount", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:BeneficialOwner",
        "@type": "rdfs:Class",
        "rdfs:label": "beneficial owner",
        "rdfs:comment": {
            "@value": "<div>a beneficial owner of the focus legal entity, with their direct and total capital and voting shares, high-risk indicator and, where applicable, the reason for other control</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/beneficialowner", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:BeneficialOwnership",
        "@type": "rdfs:Class",
        "rdfs:label": "beneficial ownership",
        "rdfs:comment": {
            "@value": "<div>the beneficial-ownership (wirtschaftlich Berechtigte) analysis of the focus legal entity across the standard, accumulation, domination and customer-due-diligence calculation methods</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/beneficialownership", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:BeneficialOwnershipVariant",
        "@type": "rdfs:Class",
        "rdfs:label": "beneficial ownership variant",
        "rdfs:comment": {
            "@value": "<div>the beneficial owners determined under one calculation method, grouped by the basis of determination — capital, voting rights, other control, or fictitious</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/beneficialownershipvariant", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:CertifiedSite",
        "@type": "rdfs:Class",
        "rdfs:subClassOf": ["ebwv:Site"],
        "rdfs:label": "certified site",
        "rdfs:comment": {
            "@value": "<div>certification target (site) of the corresponding certification</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/certifiedsite", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:Company",
        "@type": "rdfs:Class",
        "rdfs:subClassOf": ["cred:CredentialSubject", "ebwv:EconomicOperator", "ebwv:KycLegalEntity", "ebwv:LegalPerson"],
        "rdfs:label": "Company as defined in directive-EU-2025/25",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/company", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:ContactPoint",
        "@type": "rdfs:Class",
        "rdfs:label": "Contact Point",
        "rdfs:comment": {
            "@value": "<div>a designated communication channel or organisational function through which an entity can be contacted for a specific purpose</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/contactpoint", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:CorporateRole",
        "@type": "rdfs:Class",
        "rdfs:label": "corporate role",
        "rdfs:comment": {
            "@value": "<div>a function held by a legal representative or statutory partner within a company, e.g. CEO or CFO</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/corporaterole", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:DataSpaceRole",
        "@type": "rdfs:Class",
        "rdfs:label": "role of dataspace member",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/dataspacerole", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:DeliveryType",
        "@type": "rdfs:Class",
        "rdfs:label": "delivery type",
        "rdfs:comment": {
            "@value": "<div>indicates whether a KYC delivery represents a researched product or a research that was aborted</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/deliverytype", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:DUNS",
        "@type": "rdfs:Class",
        "rdfs:subClassOf": ["cred:CredentialSubject"],
        "rdfs:label": "DUNS",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/duns", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:EconomicOperator",
        "@type": "rdfs:Class",
        "rdfs:label": "Economic Operator",
        "rdfs:comment": {
            "@value": "<div>any natural or legal person, including but not limited to companies, partnerships, foundations, associations as well as sole-traders and self-employed persons or a group of such persons, acting in a commercial or professional capacity</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/economicoperator", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:ElectronicAttestationOfAttributes",
        "@type": "rdfs:Class",
        "rdfs:subClassOf": ["cred:VerifiableCredential"],
        "rdfs:label": "Electronic Attestation Of Attributes",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/electronicattestationofattributes", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:EquityHolder",
        "@type": "rdfs:Class",
        "rdfs:label": "equity holder",
        "rdfs:comment": {
            "@value": "<div>Any individual or entity that holds an ownership stake in a business. This includes public or private stockholders, sole proprietors, LLC members, and partnership owners. Not all equity holders own formal stock shares (for example, owners of a sole proprietorship or a general partnership). If the equity holder is a legal person it can have a list of equity holders which ultimately forms a ownership tree.</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/equityholder", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:EquityPartner",
        "@type": "rdfs:Class",
        "rdfs:subClassOf": ["ebwv:EquityHolder"],
        "rdfs:label": "equity partner",
        "rdfs:comment": {
            "@value": "<div>An owner in a professional services firm (such as a law, accounting, or consulting firm) structured as a partnership or LLP. Rather than earning a fixed salary, equity partners contribute firm capital, share directly in the company's annual profits and losses, and hold voting and management rights.</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/equitypartner", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:EuropeanBusinessWalletOwner",
        "@type": "rdfs:Class",
        "rdfs:subClassOf": ["cred:CredentialSubject"],
        "rdfs:label": "European Business Wallet Owner",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/europeanbusinesswalletowner", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:EvidenceData",
        "@type": "rdfs:Class",
        "rdfs:subClassOf": ["cred:CredentialEvidence"],
        "rdfs:label": "evidence data",
        "rdfs:comment": {
            "@value": "<div>Additional supporting information about claims allowing the verifier to establish the confidence with which it relies on the claims. The EvidenceData records how information was verified, naming the source, the verified claims and the verification date.</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/evidencedata", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:FinancialYear",
        "@type": "rdfs:Class",
        "rdfs:label": "financial year",
        "rdfs:comment": {
            "@value": "<div>an annual financial statement (Geschäftsjahr) of the focus legal entity, reporting size class, revenue, operating result, balance sheet total, headcount and the statement date</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/financialyear", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:GeneralPartner",
        "@type": "rdfs:Class",
        "rdfs:label": "General Partner",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/generalpartner", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:GLN",
        "@type": "rdfs:Class",
        "rdfs:subClassOf": ["cred:CredentialSubject"],
        "rdfs:label": "Global Location Number",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/gln", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:GovernanceRulebook",
        "@type": "rdfs:Class",
        "rdfs:label": "Governance rulebook",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/governancerulebook", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:Incoterms",
        "@type": "rdfs:Class",
        "rdfs:label": "Incoterms",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/incoterms", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:KycCheck",
        "@type": "rdfs:Class",
        "rdfs:subClassOf": ["cred:CredentialSubject"],
        "rdfs:label": "KYC check",
        "rdfs:comment": {
            "@value": "<div>the result of a Know-Your-Customer (KYC) investigation on a focus legal entity, bundling the delivery type and the researched focus entity with its ownership, control and register information</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/kyccheck", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:KycLegalEntity",
        "@type": "rdfs:Class",
        "rdfs:label": "KYC legal entity",
        "rdfs:comment": {
            "@value": "<div>the collection of KYC-specific attributes of a legal entity, such as liquidation and insolvency status, foundation or trust indicators, register identification and capital-market orientation. Company is a subclass of KycLegalEntity and therefore inherits these attributes alongside the core attributes it inherits from EconomicOperator.</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/kyclegalentity", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:LegalEntity",
        "@type": "rdfs:Class",
        "rdfs:label": "legal entity recognized by law",
        "rdfs:comment": {
            "@value": "<div>A legal entity is any individual, company, or organization recognized by law. It possesses distinct rights and responsibilities, meaning it can own property, enter into contracts, incur debts, pay taxes, and sue or be sued in court.</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/legalentity", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:LegalEntityIdentifier",
        "@type": "rdfs:Class",
        "rdfs:subClassOf": ["cred:CredentialSubject"],
        "rdfs:label": "Legal entity identifier",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/legalentityidentifier", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:LegalPerson",
        "@type": "rdfs:Class",
        "rdfs:subClassOf": ["cred:CredentialSubject", "ebwv:LegalEntity"],
        "rdfs:label": "Legal Person",
        "rdfs:comment": {
            "@value": "<div>A legal person is an entity the law recognises as having its own rights and obligations, separate from its members. It can own property, enter contracts, sue and be sued, and be held liable.</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/legalperson", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:LegalRepresentative",
        "@type": "rdfs:Class",
        "rdfs:label": "Legal representative",
        "rdfs:comment": {
            "@value": "<div>a natural person or economic operator that has authority, under law, the company's statutes, a register entry or another recognised legal basis, to represent a company in dealings with third parties, authorities or courts</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/legalrepresentative", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:LeiRegistration",
        "@type": "rdfs:Class",
        "rdfs:label": "LEI Registration",
        "rdfs:comment": {
            "@value": "<div>Registration Meta Data of LEI provided and maintained by LEI issuer</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/registration", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:LimitedLiabilityCompany",
        "@type": "rdfs:Class",
        "rdfs:subClassOf": ["ebwv:Company"],
        "rdfs:label": "limited liability company",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/limitedliabilitycompany", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:LimitedPartner",
        "@type": "rdfs:Class",
        "rdfs:label": "Limited Partner",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/limitedpartner", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:Location",
        "@type": "rdfs:Class",
        "rdfs:label": "Location",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/location", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:Membership",
        "@type": "rdfs:Class",
        "rdfs:subClassOf": ["cred:CredentialSubject"],
        "rdfs:label": "Membership",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/membership", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:MonetaryAmount",
        "@type": "rdfs:Class",
        "rdfs:label": "Monetary Amount",
        "rdfs:comment": {
            "@value": "<div>A structured representation of a sum of money, consisting at minimum of a numeric amount and the currency in which that amount is expressed. It is used in business attestations, credentials, invoices, payments, taxes, fees, capital, turnover, balances, and other economic or financial statements where the monetary value must be interpreted unambiguously across systems and jurisdictions.</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/monetaryamount", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:NaturalPerson",
        "@type": "rdfs:Class",
        "rdfs:subClassOf": ["cred:CredentialSubject", "ebwv:LegalEntity"],
        "rdfs:label": "Natural Person",
        "rdfs:comment": {
            "@value": "<div>A natural person is a human being with legal capacity, holding rights and obligations simply by being a person. The contrast is a legal person. It always acts through natural persons, such as managing directors, \"Prokuristen\", or authorised agents. Legal person credentials link the two - see <a href=\"#LegalRepresentative\">LegalRepresentative</a></div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/naturalperson", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:OnboardingDetails",
        "@type": "rdfs:Class",
        "rdfs:label": "onboarding details",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/onboardingdetails", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:Participation",
        "@type": "rdfs:Class",
        "rdfs:label": "participation",
        "rdfs:comment": {
            "@value": "<div>a participation (Beteiligung) held by the focus legal entity in another legal entity</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/participation", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:Partnership",
        "@type": "rdfs:Class",
        "rdfs:subClassOf": ["ebwv:Company"],
        "rdfs:label": "partnership",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/partnership", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:PaymentTerms",
        "@type": "rdfs:Class",
        "rdfs:subClassOf": ["cred:CredentialSubject"],
        "rdfs:label": "terms of payment",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/paymentterms", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:PeriodOfTime",
        "@type": "rdfs:Class",
        "rdfs:label": "Period of Time",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/periodoftime", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:PostedWorkerNotification",
        "@type": "rdfs:Class",
        "rdfs:subClassOf": ["cred:CredentialSubject"],
        "rdfs:label": "Posted Worker Notification",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/postedworkernotification", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:PowerOfAttorney",
        "@type": "rdfs:Class",
        "rdfs:subClassOf": ["cred:CredentialSubject"],
        "rdfs:label": "Power of attorney",
        "rdfs:comment": {
            "@value": "<div>A power of attorney is a verifiable authorisation that allows a principal (a natural person) or group of principals to delegate authority to a mandatee (a natural person). The power of attorney must be signed by the principal. If the power of attorney is given by a group of principals, each principal must sign it. A power of attorney is limited in scope. It enables the mandatee to represent or act on behalf of the principals within this scope.<br> The power of attorney must prove that the principals are legitimate holders of the power they are delegating. Proof of provenance must be provided in the credential to establish this trust.</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/powerofattorney", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:PublicSectorBody",
        "@type": "rdfs:Class",
        "rdfs:label": "public sector body",
        "rdfs:comment": {
            "@value": "<div>public sector body’ means a Union entity, a national, state, regional or local authority, a body governed by public law or an association formed by one or several such entities or bodies , or a private entity mandated by at least one such entities, authorities, bodies or associations to provide public services, when acting under such a mandate</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/publicsectorbody", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:QmsCertificate",
        "@type": "rdfs:Class",
        "rdfs:subClassOf": ["cred:CredentialSubject"],
        "rdfs:label": "Quality management systems (QMS) certificate",
        "rdfs:comment": {
            "@value": "<div>Quality management systems (QMS) certificate used for ESG Reporting and Sustainability</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/qmscertificate", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:QmsStandard",
        "@type": "rdfs:Class",
        "rdfs:label": "quality management systems standard",
        "rdfs:comment": {
            "@value": "<div>A Quality Management System (QMS) standard is a formal, structured set of policies, processes, and procedures designed to help organizations consistently meet customer and regulatory requirements. Key QMS Standards are &colon;<li>ISO 9001&colon; The universal baseline standard for quality management systems applicable to any business size or sector.</li><li>ISO 13485&colon; Tailored specifically for the medical device and healthcare industry, emphasizing product safety and lifecycle tracking.</li><li>IATF 16949&colon; Customized for the automotive manufacturing sector to prevent defects and reduce supply chain waste.</li><li> AS9100&colon; Built for aerospace and defense organizations demanding high safety and reliability standards.</li></div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/qmsstandard", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:RegisterIdentification",
        "@type": "rdfs:Class",
        "rdfs:label": "register identification",
        "rdfs:comment": {
            "@value": "<div>the identification of a legal entity in an official company register, including the register type, the registering court or authority, and the register number</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/registeridentification", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:Regulator",
        "@type": "rdfs:Class",
        "rdfs:label": "regulator",
        "rdfs:comment": {
            "@value": "<div>a supervisory authority (such as BaFin) at which the legal entity is registered, with the regulator-assigned identifier and the entity's regulatory classification</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/regulator", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:Residency",
        "@type": "rdfs:Class",
        "rdfs:subClassOf": ["cred:CredentialSubject"],
        "rdfs:label": "residency",
        "rdfs:comment": {
            "@value": "<div>the residency of a natural person at an address, stating the person, the address and the date since when the person resides there</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/residency", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:ScopeOfPower",
        "@type": "rdfs:Class",
        "rdfs:label": "scope of power",
        "rdfs:comment": {
            "@value": "<div>the scope of power delegated to a mandatee in the context of representing a company</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/scopeofpower", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:Share",
        "@type": "rdfs:Class",
        "rdfs:label": "share",
        "rdfs:comment": {
            "@value": "<div>a capital and voting stake (Anteil) held in a company, expressed as relative share, absolute amounts and relative voting rights, and whether the participation is direct</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/share", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:Shareholder",
        "@type": "rdfs:Class",
        "rdfs:subClassOf": ["ebwv:EquityHolder"],
        "rdfs:label": "shareholder",
        "rdfs:comment": {
            "@value": "<div>The common attributes of a shareholder of a legal entity — the legal entity that's hold the share, the stake and the aggregated share in the focus entity. An equity holder who owns fractional shares of stock in a corporation (such as common or preferred stock). Shareholders have a claim on company value, and their financial liability is typically limited to the amount they invested in the stock.</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": "https://w3id.org/ebwv#",
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:ShareInFocus",
        "@type": "rdfs:Class",
        "rdfs:label": "share in focus entity",
        "rdfs:comment": {
            "@value": "<div>the capital and voting share a holder has in the focus legal entity, computed under the several beneficial-ownership calculation methods used in German anti-money-laundering practice (GwG / Transparenzregister). Each method yields a relative capital share together with the relative voting rights; the methods differ in how indirect holdings along an ownership path (Strang) are counted and at which threshold (Grenze) a holding is recognised - see the standard, accG10, accG25, dom10 and dom25 properties</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/shareinfocus", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:ShareVotingPair",
        "@type": "rdfs:Class",
        "rdfs:label": "share and voting pair",
        "rdfs:comment": {
            "@value": "<div>a pair of relative capital share and relative voting rights computed for a given beneficial-ownership calculation method</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/sharevotingpair", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:Site",
        "@type": "rdfs:Class",
        "rdfs:label": "Site",
        "rdfs:comment": {
            "@value": "<div>a place, premises or location at which an organisation is present or located</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/site", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:SocialSecurityContribution",
        "@type": "rdfs:Class",
        "rdfs:subClassOf": ["cred:CredentialSubject"],
        "rdfs:label": "Social Security Contribution",
        "rdfs:comment": {
            "@value": "<div>A social security contribution attestation is an attestation issued by a competent authority or authorized body confirming information about an employer’s fulfilment of obligations related to social security contributions arising from the employment of workers.</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/socialsecuritycontribution", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:StatutoryPartner",
        "@type": "rdfs:Class",
        "rdfs:label": "Statutory Partner",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/statutorypartner", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:StockExchange",
        "@type": "rdfs:Class",
        "rdfs:label": "stock exchange",
        "rdfs:comment": {
            "@value": "<div>a stock exchange on which a security may be listed, identified by name, country and operating market identification code (MIC)</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/stockexchange", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:StockExchangeListing",
        "@type": "rdfs:Class",
        "rdfs:label": "stock exchange listing",
        "rdfs:comment": {
            "@value": "<div>a listing of the legal entity on a stock exchange, with its market identification code and ticker symbol</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/stockexchangelisting", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:TransparencyRegisterEntry",
        "@type": "rdfs:Class",
        "rdfs:label": "transparency register entry",
        "rdfs:comment": {
            "@value": "<div>a beneficial owner as recorded in the transparency register (Transparenzregister), with the natural person and the type and scope of their economic interest</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/transparencyregisterentry", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:TransparencyRegisterExtract",
        "@type": "rdfs:Class",
        "rdfs:label": "transparency register extract",
        "rdfs:comment": {
            "@value": "<div>metadata of a transparency register (Transparenzregister) extract obtained for the focus legal entity, including application and reference numbers, validity date and discrepancy-report information</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/transparencyregisterextract", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:TypeOfEmployment",
        "@type": "rdfs:Class",
        "rdfs:label": "Type Of Employment",
        "rdfs:comment": {
            "@value": "<div>the category or form of an employment relationship, indicating how a worker is employed or engaged by an employer</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/typeofemployment", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:TypeOfRepresentation",
        "@type": "rdfs:Class",
        "rdfs:label": "type of representation",
        "rdfs:comment": {
            "@value": "<div>type of representation meaning Alone or Jointly</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/typeofrepresentation", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:UBO",
        "@type": "rdfs:Class",
        "rdfs:label": "Ultimate Beneficiary Owner",
        "rdfs:comment": {
            "@value": "<div>An Ultimate Beneficial Owner (UBO) is the natural person (real human) who ultimately owns, controls, or profits from a legal person (company).</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https:/w3id.org/ebwv/terminology#/concept/UBO", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:VATRegistrationUnit",
        "@type": "rdfs:Class",
        "rdfs:label": "VAT Registration Unit",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/vatregistrationunit", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:Vessel",
        "@type": "rdfs:Class",
        "rdfs:label": "Vessel",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/vessel", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:WorkAssignment",
        "@type": "rdfs:Class",
        "rdfs:subClassOf": ["schema:Thing"],
        "rdfs:label": "Work Assignment",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/workassignment", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:AbortedResearch",
        "@type": "ebwv:DeliveryType",
        "rdfs:label": "aborted research",
        "rdfs:comment": {
            "@value": "<div>delivery type indicating that the KYC investigation was aborted before completion</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/abortedresearch", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:Alone",
        "@type": "ebwv:TypeOfRepresentation",
        "rdfs:label": "Alone",
        "rdfs:comment": {
            "@value": "<div>the representative can bind the company or principal alone, with their signature only.</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/Alone", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:CEO",
        "@type": "ebwv:CorporateRole",
        "rdfs:label": "Chief Executive Officer",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/ceo", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:CFO",
        "@type": "ebwv:CorporateRole",
        "rdfs:label": "Chief Financial Officer",
