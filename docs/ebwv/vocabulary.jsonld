        "rdfs:domain": "ebwv:EconomicOperator",
        "rdfs:range": "ebwv:NaturalPerson",
        "rdfs:label": "social representative",
        "rdfs:comment": {
            "@value": "<div>a person or entity designated to represent or assist an employer or posted worker in relation to social security, labour, employment or posting-related obligations during a posting period</div>",
