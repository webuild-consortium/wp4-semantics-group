            "@type": "ows:Class",
            "owl:unionOf": ["ebwv:ShareVotingPair", "ebwv:BeneficialOwnershipVariant"]
        },
        "rdfs:label": "standard method",
        "rdfs:comment": {
            "@value": "<div>share and control determined under the standard method - the statutory GwG calculation under which a natural person qualifies as beneficial owner when holding, directly or indirectly, more than 25 percent of the capital shares or voting rights, or exercising control in a comparable manner</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/standard", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
