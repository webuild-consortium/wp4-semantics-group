    "@included": [{
        "@id": "https://w3id.org/ebwv#",
        "@type": "owl:Ontology",
        "dc:title": {
            "@value": "European Business Wallet Vocabulary v0.1",
            "@language": "en"
        },
        "dc:description": {
            "@value": "Vocabulary used by the Verifiable Credentials of the European Business Wallet Framework",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:seeAlso": "https://webuild-consortium.github.io/wp4-semantics-group/ebwv",
        "dc:date": "2026-10-26"
    }, {
        "@id": "ebwv:a1",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:PostedWorkerNotification",
        "rdfs:range": "xsd:anyURI",
        "rdfs:label": "a1 certificate",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/a1", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:absoluteShare",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:Share",
        "rdfs:range": "ebwv:MonetaryAmount",
        "rdfs:label": "absolute share",
        "rdfs:comment": {
            "@value": "<div>total value of the shares held directly and indirectly; may be repeated to express the same value in several currencies</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/absoluteshare", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:academicTitle",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:NaturalPerson",
        "rdfs:range": "xsd:string",
        "rdfs:label": "academic title",
        "rdfs:comment": {
            "@value": "<div>title (Titel) of the natural person as recorded in the official registers</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/academictitle", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:acceptedAt",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:GovernanceRulebook",
        "rdfs:range": "xsd:dateTime",
        "rdfs:label": "accepted at",
        "rdfs:comment": {
            "@value": "<div>Datetime when the rulebook was accepted. May differ from issuance time in an outbound flow where a credential is issued to an existing member based on a previously completed onboarding flow.</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/acceptedat", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:accG10",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": {
            "@type": "owl:Class",
            "owl:unionOf": ["ebwv:ShareInFocus", "ebwv:BeneficialOwnership"]
        },
        "rdfs:range": {
            "@type": "ows:Class",
            "owl:unionOf": ["ebwv:ShareVotingPair", "ebwv:BeneficialOwnershipVariant"]
        },
        "rdfs:label": "accumulation 10% method",
        "rdfs:comment": {
            "@value": "<div>determined under the accumulation (Addition) method with a 10 percent threshold (Grenze) - relative holdings of at least 10 percent are added up across all ownership paths (Straenge) that lead to the focus entity</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/accg10", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:accG25",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": {
            "@type": "owl:Class",
            "owl:unionOf": ["ebwv:ShareInFocus", "ebwv:BeneficialOwnership"]
        },
        "rdfs:range": {
            "@type": "ows:Class",
            "owl:unionOf": ["ebwv:ShareVotingPair", "ebwv:BeneficialOwnershipVariant"]
        },
        "rdfs:label": "accumulation 25% method",
        "rdfs:comment": {
            "@value": "<div>determined under the accumulation (Addition) method with a 25 percent threshold (Grenze) - relative holdings of at least 25 percent are added up across all ownership paths (Straenge) that lead to the focus entity</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/accg25", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:accountName",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:BankAccount",
        "rdfs:range": "xsd:string",
        "rdfs:label": "account name",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/accountname", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:accountType",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:BankAccount",
        "rdfs:range": "ebwv:AccountType",
        "rdfs:label": "account type",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/banktype", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:activity",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:Company",
        "rdfs:range": {
            "@type": "ows:Class",
            "owl:unionOf": ["ebwv:Nace21", "ebwv:Naics", "ebwv:Sic", "ebwv:Wz2003", "ebwv:Wz2008"]
        },
        "rdfs:label": "main activity of company",
        "rdfs:comment": {
            "@value": "<div>the main economic activity of the company, expressed as a code in one or more classification schemes (NACE Rev. 2.1, NAICS, SIC, WZ 2003, WZ 2008)</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/activity", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:addressArea",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:Address",
        "rdfs:range": "xsd:string",
        "rdfs:label": "address area",
        "rdfs:comment": {
            "@value": "<div>the name of a geographic area that groups addresses</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/addressarea", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:administrativeRepresentative",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:EconomicOperator",
        "rdfs:range": "ebwv:NaturalPerson",
        "rdfs:label": "administrative representative",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/administrativerepresentative", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:adminUnitL1",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:Address",
        "rdfs:range": "ebwv:CountryCode",
        "rdfs:label": "administrative unit level 1",
        "rdfs:comment": {
            "@value": "<div>the name of the uppermost level of the address, almost always a country</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/adminUnitL1", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:adminUnitL2",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:Address",
        "rdfs:range": "xsd:string",
        "rdfs:label": "administrative unit level 2",
        "rdfs:comment": {
            "@value": "<div>The name of a secondary level/region of the address, usually a county, state or other such area that typically encompasses several localities.</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/adminUnitL2", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:alternativeName",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:NaturalPerson",
        "rdfs:range": "xsd:string",
        "rdfs:label": "alternative name",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/alternativename", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:amount",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:MonetaryAmount",
        "rdfs:range": "xsd:float",
        "rdfs:label": "amount",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/amount", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:applicationNumber",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:TransparencyRegisterExtract",
        "rdfs:range": "xsd:string",
        "rdfs:label": "application number",
        "rdfs:comment": {
            "@value": "<div>the transaction number assigned by the transparency register for the extract</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/applicationnumber", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:arrivalDate",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:Residency",
        "rdfs:range": "xsd:date",
        "rdfs:label": "arrival date",
        "rdfs:comment": {
            "@value": "<div>the date since when the person resides at this address</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/arrivaldate", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:assignment",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:PostedWorkerNotification",
        "rdfs:range": "ebwv:WorkAssignment",
        "rdfs:label": "assignment",
        "rdfs:comment": {
            "@value": "<div>a formal allocation of a role, mandate, responsibility, task, right, or duty to an identified party or agent within a defined context</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/assignment", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:attestationLegalCategory",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:ElectronicAttestationOfAttributes",
        "rdfs:range": ["ebwv:AttestationLegalCategory", {
            "@type": "owl:class",
            "owl:oneOf": ["ebwv:QEAA", "ebwv:Pub-EAA", "ebwv:EAA"]
        }],
        "rdfs:label": "attestation legal category",
        "rdfs:comment": {
            "@value": "<div>a categorization of electronic attestations of attributes into three primary types, each associated with a distinct level of assurance and legal effect</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/attestationlegalcategory", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:averagePeriodWorkforce",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:SocialSecurityContribution",
        "rdfs:range": "xsd:string",
        "rdfs:label": "average period workforce",
        "rdfs:comment": {
            "@value": "<div>average number of employed persons for the reporting period</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/averageperiodworkforce", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:balanceSheetDate",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:KycLegalEntity",
        "rdfs:range": "xsd:date",
        "rdfs:label": "balance sheet date",
        "rdfs:comment": {
            "@value": "<div>balance sheet reporting date of the legal entity</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/balancesheetdate", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:balanceSheetTotal",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:FinancialYear",
        "rdfs:range": "ebwv:MonetaryAmount",
        "rdfs:label": "balance sheet total",
        "rdfs:comment": {
            "@value": "<div>balance sheet total (Bilanzsumme) of the focus legal entity in the financial year</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/balancesheettotal", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:beneficialOwnership",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:KycLegalEntity",
        "rdfs:range": "ebwv:BeneficialOwnership",
        "rdfs:label": "beneficial ownership",
        "rdfs:comment": {
            "@value": "<div>the beneficial-ownership analysis of the focus legal entity</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/beneficialownership", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:birthName",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:NaturalPerson",
        "rdfs:range": "xsd:string",
        "rdfs:label": "birth name",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/birthname", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:businessEntity",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:DUNS",
        "rdfs:range": "ebwv:Company",
        "rdfs:label": "business entity",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/businessEntity", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:buyer",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:PaymentTerms",
        "rdfs:range": "xsd:anyURI",
        "rdfs:label": "buyer",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/buyer", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:capitalBeneficialOwner",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:BeneficialOwnershipVariant",
        "rdfs:range": "ebwv:BeneficialOwner",
        "rdfs:label": "capital beneficial owner",
        "rdfs:comment": {
            "@value": "<div>a beneficial owner determined on the basis of capital - a natural person who, directly or indirectly, holds a share of the capital (Kapitalanteile) of the focus legal entity that reaches the threshold of the enclosing calculation method (more than 25 percent under the standard method, or the 10 or 25 percent threshold of the accumulation and domination methods) (section 3(2) sentence 1 no. 1 GwG)</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/capitalbeneficialowner", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:cdd",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:BeneficialOwnership",
        "rdfs:range": "ebwv:BeneficialOwnershipVariant",
        "rdfs:label": "customer due diligence method",
        "rdfs:comment": {
            "@value": "<div>beneficial owners determined under the customer-due-diligence (CDD) method</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/cdd", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:certificationStandard",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:QmsCertificate",
        "rdfs:range": "ebwv:QmsStandard",
        "rdfs:label": "certification standard",
        "rdfs:comment": {
            "@value": "<div>the standard the certificate is based on</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/certificationstandard", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:certifiedScope",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": {
            "@type": "owl:Class",
            "owl:unionOf": ["ebwv:QmsCertificate", "ebwv:CertifiedSite"]
        },
        "rdfs:range": "xsd:String",
        "rdfs:label": "certified scope",
        "rdfs:comment": {
            "@value": "<div>the scope of certification</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/certifiedscope", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:citizenship",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:NaturalPerson",
        "rdfs:range": "ebwv:CountryCode",
        "rdfs:label": "citizenship",
        "rdfs:comment": {
            "@value": "<div>the legal bond between a natural person and a state, recognised under national law, which establishes membership in that state and entails associated rights and obligations</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/citizenship", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:companyCategory",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:KycLegalEntity",
        "rdfs:range": "xsd:string",
        "rdfs:label": "company category",
        "rdfs:comment": {
            "@value": "<div>company category (Gesellschaftsart) of the legal entity</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/companycategory", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:companyRegisterId",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:RegisterIdentification",
        "rdfs:range": "xsd:string",
        "rdfs:label": "company register id",
        "rdfs:comment": {
            "@value": "<div>identification number of the company in a (foreign) register</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/companyregisterid", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:companyRegisterIdCountry",
