        "rdfs:range": "xsd:string",
        "rdfs:label": "interest type",
        "rdfs:comment": {
            "@value": "<div>type of the economic interest of the natural person</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/interesttype", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:isCsrdObligated",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:KycLegalEntity",
        "rdfs:range": "xsd:boolean",
        "rdfs:label": "is CSRD obligated",
        "rdfs:comment": {
            "@value": "<div>states whether the company is legally required to comply with the <a href=\"https://finance.ec.europa.eu/financial-markets/company-reporting-and-auditing/company-reporting/corporate-sustainability-reporting_en\">European Union's Corporate Sustainability Reporting Directive (CSRD)</a>. It means the company is legally mandated to track and publicly disclose their environmental, social, and governance (ESG) impacts, risks, and opportunities in a standardized digital format.</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/iscsrdobligated", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:isDirectParticipation",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:Share",
        "rdfs:range": "xsd:boolean",
        "rdfs:label": "is direct participation",
        "rdfs:comment": {
            "@value": "<div>whether the participation in the company is direct</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/isdirectparticipation", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:isExemptFromSection181",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:LegalRepresentative",
        "rdfs:range": "xsd:boolean",
        "rdfs:label": "is exempt from section 181",
        "rdfs:comment": {
            "@value": "<div>whether the representative is exempt from the self-dealing restriction of section 181 of the German Civil Code (BGB)</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/isexemptfromsection181", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:isFoundation",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:KycLegalEntity",
        "rdfs:range": "xsd:boolean",
        "rdfs:label": "is foundation",
        "rdfs:comment": {
            "@value": "<div>entity type indicator stating whether the company is a foundation</div>",
