        "rdfs:domain": "ebwv:BeneficialOwnershipVariant",
        "rdfs:range": "ebwv:BeneficialOwner",
        "rdfs:label": "other control beneficial owner",
        "rdfs:comment": {
            "@value": "<div>a beneficial owner determined on the basis of control exercised in another comparable way (auf vergleichbare Weise Kontrolle) rather than through capital or voting rights - for example through voting or control agreements, the right to appoint or remove the management, veto rights or another dominant influence; the concrete basis is stated in otherControlReason (section 3(2) sentence 1 no. 3 GwG)</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/othercontrolbeneficialowner", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:otherControlReason",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:BeneficialOwner",
        "rdfs:range": "xsd:string",
        "rdfs:label": "other control reason",
        "rdfs:comment": {
            "@value": "<div>reason for which the person is considered to exercise other control</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/othercontrolreason", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:owner",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:BankAccount",
        "rdfs:range": {
            "@type": "ows:Class",
            "owl:unionOf": ["ebwv:LegalPerson", "ebwv:EconomicOperator", "ebwv:NaturalPerson"]
        },
        "rdfs:label": "owner",
        "rdfs:comment": {
            "@value": "<div>an agent that holds an ownership right, title or legally recognised control over an asset, resource, business entity, credential, account, property or other object</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/owner", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:ownershipPercentage",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:TBD",
        "rdfs:range": "xsd:float",
        "rdfs:label": "ownership percentage",
        "rdfs:isDefinedBy": ["https:/w3id.org/ebwv/terminology#/concept/ownershipPercentage", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:participation",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:KycLegalEntity",
        "rdfs:range": "ebwv:Participation",
        "rdfs:label": "participation",
        "rdfs:comment": {
            "@value": "<div>a participation held by the focus legal entity in another legal person</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/participation", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:partner",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:Partnership",
        "rdfs:range": {
            "@type": "ows:Class",
            "owl:unionOf": ["ebwv:GeneralPartner", "ebwv:LimitedPartner", "ebwv:StatutoryPartner"]
        },
        "rdfs:label": "partner",
        "rdfs:comment": {
            "@value": "<div>a person or legal entity that is a member of a partnership or comparable company-law entity and whose status as partner is recorded or recognised by the competent business register or company register</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/partner", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:patronymicName",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:NaturalPerson",
        "rdfs:range": "xsd:string",
        "rdfs:label": "patronymic name",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/patronymicname", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:paymentDue",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:PaymentTerms",
        "rdfs:range": ["xsd:duration", "time:TemporalDuration"],
        "rdfs:label": "due period of payment",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/paymentDue", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:person",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": {
            "@type": "owl:Class",
            "owl:unionOf": ["ebwv:A1Certificate", "ebwv:Residency", "ebwv:TransparencyRegisterEntry"]
        },
        "rdfs:range": "ebwv:NaturalPerson",
        "rdfs:label": "person",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/person", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:personalAdministrativeNumber",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:NaturalPerson",
        "rdfs:range": "xsd:string",
        "rdfs:label": "personal administrative number",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/personaladministrativenumber", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:placeOfBirth",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:NaturalPerson",
        "rdfs:range": "ebwv:Location",
        "rdfs:label": "place of birth",
        "rdfs:comment": {
            "@value": "<div>the location where a person was born</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/placeofbirth", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:placeOfDeath",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:NaturalPerson",
        "rdfs:range": "ebwv:Location",
        "rdfs:label": "place of death",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/placeofdeath", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:placeOfWork",
        "@type": "rdf:Property",
        "rdfs:domain": {
            "@type": "owl:Class",
            "owl:unionOf": ["ebwv:A1Certificate", "ebwv:WorkAssignment"]
        },
        "rdfs:range": {
            "@type": "ows:Class",
            "owl:unionOf": ["ebwv:Address", "ebwv:CountryCode", "ebwv:EconomicOperator", "ebwv:Vessel"]
        },
        "rdfs:label": "place of work",
        "rdfs:comment": {
            "@value": "<div>the location where a worker performs, is expected to perform, or is assigned to perform work during an employment, posting or work assignment</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/placeofwork", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:platform",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:OnboardingDetails",
        "rdfs:range": "xsd:string",
        "rdfs:label": "platform",
        "rdfs:comment": {
            "@value": "<div>name of the plaform that onboarded the member (e.g. data sharing initiative)</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/platform", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:poBox",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:Address",
        "rdfs:range": "xsd:string",
        "rdfs:label": "post office box",
        "rdfs:comment": {
            "@value": "<div>A location designator for a postal delivery point at a post office, usually a number.</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/pobox", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:portrait",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:NaturalPerson",
        "rdfs:range": "xsd:string",
        "rdfs:label": "portrait",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/portrait", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:postCode",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:Address",
        "rdfs:range": "xsd:string",
        "rdfs:label": "post code",
        "rdfs:comment": {
            "@value": "<div>The code created and maintained for postal purposes to identify a subdivision of addresses and postal delivery points.</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/postcode", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:postedWorker",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:PostedWorkerNotification",
        "rdfs:range": "ebwv:NaturalPerson",
        "rdfs:label": "posted worker",
        "rdfs:comment": {
            "@value": "<div>a worker who is sent by an employer to perform work temporarily in a country other than the country in which the worker normally works</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/postedworker", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:postName",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:Address",
        "rdfs:range": "xsd:string",
        "rdfs:label": "post name",
        "rdfs:comment": {
            "@value": "<div>a name created and maintained for postal purposes to identify a subdivision of addresses and postal delivery points</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/postname", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:principal",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:PowerOfAttorney",
        "rdfs:range": "ebwv:NaturalPerson",
        "rdfs:label": "principal",
        "rdfs:comment": {
            "@value": "<div>The person or the group (list) of persons who gives power.</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/principal", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:processingNote",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:TransparencyRegisterExtract",
        "rdfs:range": "xsd:string",
        "rdfs:label": "processing note",
        "rdfs:comment": {
            "@value": "<div>a note indicating a particularity regarding the focus legal entity in the extract</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/processingnote", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:provenanceProof",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:ElectronicAttestationOfAttributes",
        "rdfs:range": "ebwv:ElectronicAttestationOfAttributes",
        "rdfs:label": "provenance proof",
        "rdfs:comment": {
            "@value": "<div>Proof required to establish trust in the issuer of the credential. The proof allows the relying party to verify if the issuer is authorized to issue the credential and to make the claims about the credential subject. E.g. in the case of an power of attorney the provenanceProof provides the proof that the principal is authorized to give power to the mandatee.</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/provenanceproof", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:provenClaim",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:EvidenceData",
        "rdfs:range": "xsd:string",
        "rdfs:label": "proven claim",
        "rdfs:comment": {
            "@value": "<div>JsonPath to the claim in the credential (root) that is covered by this evidence</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/provenclaim", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:provider",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:BankAccount",
        "rdfs:range": {
            "@type": "ows:Class",
            "owl:unionOf": ["ebwv:LegalPerson", "ebwv:EconomicOperator"]
        },
        "rdfs:label": "provider",
        "rdfs:comment": {
            "@value": "<div>an agent that offers, supplies or makes available a service, account, facility or other capability to another party</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/provider", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:provisionalDetermination",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:A1Certificate",
        "rdfs:range": "xsd:boolean",
        "rdfs:label": "provisional determination",
        "rdfs:comment": {
            "@value": "<div>A determination that has legal or administrative effect on a provisional basis and remains subject to confirmation, amendment, or withdrawal under the applicable procedure.</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/provisionaldetermination", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:qualificationNote",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:SocialSecurityContribution",
        "rdfs:range": "xsd:string",
        "rdfs:label": "qualification note",
        "rdfs:comment": {
            "@value": "<div>A human-readable note about caveat, limitation, condition that qualifies the interpretation of the attestation.</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/qualificationnote", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:referenceNumber",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:TransparencyRegisterExtract",
        "rdfs:range": "xsd:string",
        "rdfs:label": "reference number",
        "rdfs:comment": {
            "@value": "<div>the reference number identifying a transparency register extract</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/referencenumber", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:register",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:KycLegalEntity",
        "rdfs:range": "ebwv:RegisterIdentification",
        "rdfs:label": "register",
        "rdfs:comment": {
            "@value": "<div>identification of the legal entity in an official company register</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/register", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:registeredAddress",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": {
            "@type": "owl:Class",
            "owl:unionOf": ["ebwv:Company", "ebwv:EconomicOperator", "ebwv:GLN", "ebwv:LegalPerson", "ebwv:LegalEntity", "ebwv:Site"]
        },
        "rdfs:range": "ebwv:Address",
        "rdfs:label": "registered address",
        "rdfs:comment": {
            "@value": "<div>the address at which the legal entity is legally registered; if an entity is not considered to be a registered organisation, use \"hasAddress\" or similar property to express the address of the entity</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/registeredaddress", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:registerLocation",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:RegisterIdentification",
        "rdfs:range": "xsd:string",
        "rdfs:label": "register location",
        "rdfs:comment": {
            "@value": "<div>name of the local court (Amtsgericht) or authority at which the company is registered</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/registerlocation", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:registerNumber",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:RegisterIdentification",
        "rdfs:range": "xsd:string",
        "rdfs:label": "register number",
        "rdfs:comment": {
            "@value": "<div>official registration number of the company at the register</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/registernumber", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:registerType",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:RegisterIdentification",
        "rdfs:range": "xsd:string",
        "rdfs:label": "register type",
        "rdfs:comment": {
            "@value": "<div>type of the register in which the legal entity is registered</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/registertype", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:registerTypeDescription",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:RegisterIdentification",
        "rdfs:range": "xsd:string",
        "rdfs:label": "register type description",
        "rdfs:comment": {
            "@value": "<div>classification / description of the register type</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/registertypedescription", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:regulatedId",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:Regulator",
        "rdfs:range": "xsd:string",
        "rdfs:label": "regulated id",
        "rdfs:comment": {
            "@value": "<div>the identifier assigned by the supervisory authority that is specific to the regulated entity</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/regulatedid", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:regulator",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:KycLegalEntity",
        "rdfs:range": "ebwv:Regulator",
        "rdfs:label": "regulator",
        "rdfs:comment": {
            "@value": "<div>a supervisory authority at which the legal entity is registered</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/regulator", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:regulatorClassification",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:Regulator",
        "rdfs:range": "xsd:string",
        "rdfs:label": "regulator classification",
        "rdfs:comment": {
            "@value": "<div>classification of the entity type according to the supervisory authority's definition</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/regulatorclassification", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:regulatorName",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
