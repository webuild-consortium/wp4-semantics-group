    }, {
        "@id": "ebwv:legalBasis",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:SocialSecurityContribution",
        "rdfs:range": "xsd:string",
        "rdfs:label": "legal basis",
        "rdfs:comment": {
            "@value": "<div>legal provision or framework under which the attestation is issued</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/legalbasis", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:legalEntity",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:LegalRepresentative",
        "rdfs:range": ["ebwv:NaturalPerson", "ebwv:LegalPerson"],
        "rdfs:label": "legal entity recognized by law",
        "rdfs:comment": {
            "@value": "<div>A legal entity is any individual, company, or organization recognized by law. It possesses distinct rights and responsibilities, meaning it can own property, enter into contracts, incur debts, pay taxes, and sue or be sued in court.</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/legalentity", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:legalForm",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": {
            "@type": "owl:Class",
            "owl:unionOf": ["ebwv:LegalPerson", "ebwv:Company"]
        },
        "rdfs:range": "xsd:string",
        "rdfs:label": "legal form",
        "rdfs:comment": {
            "@value": "<div>the juridical classification of a legal entity according to the law under which it is constituted, determining its legal personality, governance structure, and liability regime</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/legalform", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:legalIdentifier",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": {
            "@type": "owl:Class",
            "owl:unionOf": ["ebwv:EuropeanBusinessWalletOwner", "ebwv:LegalPerson", "ebwv:EconomicOperator", "ebwv:PublicSectorBody"]
        },
        "rdfs:range": {
            "@type": "ows:Class",
            "owl:unionOf": ["ebwv:PublicSectorBodyId", "ebwv:Euid"]
        },
        "rdfs:label": "legal identifier",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/legalidentifier", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:legalName",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": {
            "@type": "owl:Class",
            "owl:unionOf": ["ebwv:EuropeanBusinessWalletOwner", "ebwv:LegalPerson", "ebwv:EconomicOperator", "ebwv:PublicSectorBody"]
        },
        "rdfs:range": "xsd:string",
        "rdfs:label": "legal name",
        "rdfs:comment": {
            "@value": "<div>the name under which the legal entity is legally registered</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/legalname", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:legalRepresentative",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:LimitedLiabilityCompany",
        "rdfs:range": "ebwv:LegalRepresentative",
        "rdfs:label": "legal representative",
        "rdfs:comment": {
            "@value": "<div>a natural person or economic operator that has authority, under law, the company's statutes, a register entry or another recognised legal basis, to represent a company in dealings with third parties, authorities or courts</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/legalrepresentative", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:legalStatus",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": {
            "@type": "owl:Class",
            "owl:unionOf": ["ebwv:Company", "ebwv:LegalPerson"]
        },
        "rdfs:range": "xsd:string",
        "rdfs:label": "status of the company",
        "rdfs:comment": {
            "@value": "<div>the officially recorded status of a registered business entity as determined or maintained by the competent register authority</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/legalstatus", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
