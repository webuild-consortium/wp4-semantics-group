        "rdfs:label": "Head of Human Resources",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/headofhr", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:Jointly",
        "@type": "ebwv:TypeOfRepresentation",
        "rdfs:label": "Jointly",
        "rdfs:comment": {
            "@value": "<div>the representative can only act together with one or more other authorised representatives. A typical rule is \"two managing directors jointly.\"</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/Jointly", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:OnboardingServiceProvider",
        "@type": "ebwv:DataSpaceRole",
        "rdfs:label": "Onboarding Service Provider",
        "rdfs:comment": {
            "@value": "<div>Partner that onboards members into Agri-X; may be a DSI or another technology partner.</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/onboardingserviceprovider", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:Operator",
        "@type": "ebwv:DataSpaceRole",
        "rdfs:label": "Operator",
        "rdfs:comment": {
            "@value": "<div>Partner providing DSSC building-block services (identity management, consent management, logging, …).</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/operator", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:Permanent",
        "@type": "ebwv:TypeOfEmployment",
        "rdfs:label": "Permanent",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/permanent", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:Pub-EAA",
        "@type": "ebwv:AttestationLegalCategory",
        "rdfs:label": "Public Electronic Attestation of Attributes",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/Pub-EAA", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:QEAA",
        "@type": "ebwv:AttestationLegalCategory",
        "rdfs:label": "Qualified Electronic Attestation of Attributes",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/QEAA", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:RegistrationAndClosingOfBranches",
        "@type": "ebwv:ScopeOfPower",
        "rdfs:label": "registration and closing of branches",
        "rdfs:comment": {
            "@value": "<div>Registration and closure of branches of the Company.</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https:/w3id.org/ebwv/terminology#/concept/registrationandclosingofbranches", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:ResearchedProduct",
        "@type": "ebwv:DeliveryType",
        "rdfs:label": "researched product",
        "rdfs:comment": {
            "@value": "<div>delivery type indicating that the KYC investigation was completed and the researched product is delivered</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/researchedproduct", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:Temporary",
        "@type": "ebwv:TypeOfEmployment",
        "rdfs:label": "Temporary",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/temporary", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:AccountType",
        "@type": "rdfs:Datatype",
        "rdfs:subClassOf": ["xsd:string"],
        "rdfs:label": "account type",
        "rdfs:comment": {
            "@value": "<div>list of account types TBD</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": "https://w3id.org/ebwv#",
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:BanzNumber",
        "@type": "rdfs:Datatype",
        "rdfs:subClassOf": ["xsd:string"],
        "rdfs:label": "Bundesanzeiger number",
        "rdfs:comment": {
            "@value": "<div>internal unique identification (BANZ-Number) assigned by Bundesanzeiger Verlag that identifies a company as part of the KYC service</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/banznumber", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:Bic",
        "@type": "rdfs:Datatype",
        "rdfs:subClassOf": ["xsd:string"],
        "owl:onDatatype": "xsd:string",
        "owl:withRestrictions": {
            "@list": [{
                "xsd:pattern": "[A-Z]{6}[A-Z0-9]{2}([A-Z0-9]{3})"
            }]
        },
        "rdfs:label": "Business Identifier Code aka Swift Code",
        "rdfs:comment": {
            "@value": "<div>International code (i.e. BIC or SWIFT code), as defined in ISO 9362, of the financial institution</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://www.iso.org/standard/84108.html", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:CertificateRegistrationNumber",
        "@type": "rdfs:Datatype",
        "rdfs:subClassOf": ["xsd:string"],
        "rdfs:label": "certificate registration number",
        "rdfs:comment": {
            "@value": "<div>An internal tracking or reference number assigned specifically by the third-party Certification Body (CB) (such as TÜV NORD, DQS, or TÜV SÜD) that performed the audit and printed the paper certificate.</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://iatf-customerportal.org/", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:ClearingNumber",
        "@type": "rdfs:Datatype",
        "rdfs:subClassOf": ["xsd:string"],
        "rdfs:label": "ClearingNumber",
        "rdfs:comment": {
            "@value": "<div>Clearing number, only used in some countries, of the identification of the financial institution.</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": "https://w3id.org/ebwv#",
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:CompanyId",
        "@type": "rdfs:Datatype",
        "rdfs:subClassOf": ["xsd:string"],
        "rdfs:label": "Company identifier",
        "rdfs:comment": {
            "@value": "<div>internal check number (CompanyID) assigned by Bundesanzeiger Verlag that identifies a company in the UFDB</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/banznumber", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:CountryCode",
        "@type": "rdfs:Datatype",
        "rdfs:subClassOf": ["xsd:string"],
        "owl:onDatatype": "xsd:string",
        "owl:withRestrictions": {
            "@list": [{
                "xsd:pattern": "[A-Z]{2}(-.*)?"
            }]
        },
        "rdfs:label": "Country Code",
        "rdfs:comment": {
            "@value": "<div>2 letter country code according to ISO-3166</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://www.iso.org/iso-3166-country-codes.html", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:Currency",
        "@type": "rdfs:Datatype",
        "rdfs:subClassOf": ["xsd:string"],
        "owl:onDatatype": "xsd:string",
        "owl:withRestrictions": {
            "@list": [{
                "xsd:pattern": "[A-Z]{3}"
            }]
        },
        "rdfs:label": "Currency",
        "rdfs:comment": {
            "@value": "<div>3 letter currency code according to the European controlled vocabulary 'Currency'</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://op.europa.eu/en/web/eu-vocabularies/concept-scheme/-/resource?uri=http://publications.europa.eu/resource/authority/currency", "http://publications.europa.eu/resource/authority/currency", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:DunsNumber",
        "@type": "rdfs:Datatype",
        "rdfs:subClassOf": ["xsd:string"],
        "owl:onDatatype": "xsd:string",
        "owl:withRestrictions": {
            "@list": [{
                "xsd:pattern": "[0-9]{9}"
            }]
        },
        "rdfs:label": "DUNS number",
        "rdfs:comment": {
            "@value": "<div>The Data Universal Numbering System, abbreviated as DUNS or D-U-N-S, is a proprietary system developed and managed by Dun & Bradstreet (D&B) that assigns a unique numeric identifier, referred to as a \"DUNS number\" to a single business entity.</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/dunsnumber", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:Eori",
        "@type": "rdfs:Datatype",
        "rdfs:subClassOf": ["xsd:string"],
        "rdfs:label": "economic operator registration and identification",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/eori", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:Euid",
        "@type": "rdfs:Datatype",
        "rdfs:subClassOf": ["xsd:string"],
        "rdfs:label": "EUID",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/euid", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:Excise",
        "@type": "rdfs:Datatype",
        "rdfs:subClassOf": ["xsd:string"],
        "rdfs:label": "excise number",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/excise", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:GlobalLocationNumber",
        "@type": "rdfs:Datatype",
        "rdfs:subClassOf": ["xsd:string"],
        "owl:onDatatype": "xsd:string",
        "owl:withRestrictions": {
            "@list": [{
                "xsd:pattern": "[0-9]{13}"
            }]
        },
        "rdfs:label": "Global Location Number",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/globallocationnumber", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:GS1CompanyPrefix",
        "@type": "rdfs:Datatype",
        "rdfs:subClassOf": ["xsd:string"],
        "owl:onDatatype": "xsd:string",
        "owl:withRestrictions": {
            "@list": [{
                "xsd:pattern": "[0-9]{7,9}"
            }]
        },
        "rdfs:label": "GS1 company prefix",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/gs1companyprefix", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:IatfCertificateNumber",
        "@type": "rdfs:Datatype",
        "rdfs:subClassOf": ["xsd:string"],
        "owl:onDatatype": "xsd:string",
        "owl:withRestrictions": {
            "@list": [{
                "xsd:pattern": "[0-9]{7}"
            }]
        },
        "rdfs:label": "IATF Certificate Number",
        "rdfs:comment": {
            "@value": "<div>The IATF Certification Number (IATF Registration No.) is a unique, central identification number issued directly by the International Automotive Task Force (IATF) database/oversight system for the certified organization or manufacturing site.</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://iatf-customerportal.org/", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:IatfUsi",
        "@type": "rdfs:Datatype",
        "rdfs:subClassOf": ["xsd:string"],
        "owl:onDatatype": "xsd:string",
        "owl:withRestrictions": {
            "@list": [{
                "xsd:pattern": "[0-9A-Z]{6}"
            }]
        },
        "rdfs:label": "IATF USI",
        "rdfs:comment": {
            "@value": "<div>This IATF Unique Site Identifier (USI) is used within the automotive industry's IATF 16949 Quality Management System. It is a permanent, immutable 6-digit alphanumeric code assigned to a specific physical manufacturing facility or remote support location. It remains tied to that exact address for the lifetime of the certification, regardless of company name changes or certification body transfers.</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://iatf-customerportal.org/", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:Iban",
        "@type": "rdfs:Datatype",
        "rdfs:subClassOf": ["xsd:string"],
        "owl:onDatatype": "xsd:string",
        "owl:withRestrictions": {
            "@list": [{
                "xsd:pattern": "[A-Z]{2}[0-9A-Z]{13,30}"
            }]
        },
        "rdfs:label": "IBAN",
        "rdfs:comment": {
            "@value": "<div>IBAN as defined by ISO 13616:2020</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://www.iso.org/standard/81090.html", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:Isin",
        "@type": "rdfs:Datatype",
        "rdfs:subClassOf": ["xsd:string"],
        "owl:onDatatype": "xsd:string",
        "owl:withRestrictions": {
            "@list": [{
                "xsd:pattern": "[A-Z]{2}[A-Z0-9]{9}[0-9]"
            }]
        },
        "rdfs:label": "International Securities Identification Number",
        "rdfs:comment": {
            "@value": "<div>International Securities Identification Number uniquely identifying a security, as defined in ISO 6166</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://www.iso.org/standard/78502.html", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:KmgMid",
        "@type": "rdfs:Datatype",
        "rdfs:subClassOf": ["xsd:string"],
        "owl:onDatatype": "xsd:string",
        "owl:withRestrictions": {
            "@list": [{
                "xsd:pattern": "[0-9]{9}"
            }]
        },
        "rdfs:label": "KMG-MID",
        "rdfs:comment": {
            "@value": "<div>A nationally unique identifier assigned to an agricultural holding registered in the Slovenian Register of Agricultural Holdings (Register kmetijskih gospodarstev, RKG). The identifier uniquely identifies a farm or agricultural holding for administrative, regulatory, subsidy, traceability, and agricultural data exchange purposes.</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/kmgmid", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:Lei",
        "@type": "rdfs:Datatype",
        "rdfs:subClassOf": ["xsd:string"],
        "rdfs:label": "legal entity identifier",
        "rdfs:comment": {
            "@value": "<div>a globally unique reference code assigned under the Global LEI System to identify a legal entity participating in financial, business or regulatory transactions</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/lei", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:MainCertificateRegistrationNumber",
        "@type": "rdfs:Datatype",
        "rdfs:subClassOf": ["xsd:string"],
        "rdfs:label": "main certificate registration number",
        "rdfs:comment": {
            "@value": "<div>An internal tracking or reference number assigned specifically by the third-party Certification Body (CB) (such as TÜV NORD, DQS, or TÜV SÜD) that performed the audit and printed the paper certificate.</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://iatf-customerportal.org/", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:Nace21",
        "@type": "rdfs:Datatype",
        "rdfs:subClassOf": ["xsd:string"],
        "rdfs:label": "Nace Rev. 2.1",
        "rdfs:comment": {
            "@value": "<div>notation of the main activity of the company according to the European controlled vocabulary 'Nace Rev. 2.1'</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://op.europa.eu/en/web/eu-vocabularies/concept-scheme/-/resource?uri=http://data.europa.eu/ux2/nace2.1/nace2.1", "http://data.europa.eu/ux2/nace2.1/nace2.1", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:Naics",
        "@type": "rdfs:Datatype",
        "rdfs:subClassOf": ["xsd:string"],
        "rdfs:label": "NAICS 2002",
        "rdfs:comment": {
            "@value": "<div>notation of the main activity of the company according to the North American Industry Classification System (NAICS), edition 2002</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/naics", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:NationalBankCode",
        "@type": "rdfs:Datatype",
        "rdfs:subClassOf": ["xsd:string"],
        "rdfs:label": "National Bank Code",
        "rdfs:comment": {
            "@value": "<div>Country-specific code for e.g. internal routing within a specific country’s clearing system (e.g. BLZ, Sort Code)</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": "https://w3id.org/ebwv#",
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:PeppolId",
        "@type": "rdfs:Datatype",
        "rdfs:subClassOf": ["xsd:string"],
        "owl:onDatatype": "xsd:string",
        "owl:withRestrictions": {
            "@list": [{
                "xsd:pattern": "[0-9]{4}(:.*)"
            }]
        },
        "rdfs:label": "Peppol ID",
        "rdfs:comment": {
            "@value": "<div>A Peppol ID is a unique identifier used to securely exchange electronic documents (like invoices) within the Peppol network, acting similarly to a digital address. It consists of a four-digit scheme ID (identifying the type of number) and a specific participant ID, separated by a colon (e.g., 9930:DE123456789)</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://docs.peppol.eu/edelivery/", "https://docs.peppol.eu/poacc/billing/3.0/codelist/ICD/", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:PublicSectorBodyId",
