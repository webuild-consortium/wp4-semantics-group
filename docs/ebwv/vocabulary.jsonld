        "rdfs:domain": "ebwv:BankAccount",
        "rdfs:range": "ebwv:Iban",
        "rdfs:label": "IBAN",
        "rdfs:comment": {
            "@value": "<div>an internationally standardised identifier for a payment account, composed of a country code, check digits and a country-specific basic bank account number, used to identify the account to which a payment is to be made or from which a payment is to be collected</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/iban", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:identifier",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": {
            "@type": "owl:Class",
            "owl:unionOf": ["ebwv:EconomicOperator", "ebwv:Site", "ebwv:VATRegistrationUnit", "ebwv:GLN", "ebwv:DUNS", "ebwv:QmsCertificate", "ebwv:NaturalPerson", "ebwv:EquityHolder", "ebwv:Participation", "ebwv:BeneficialOwner"]
        },
        "rdfs:range": {
            "@type": "ows:Class",
            "owl:unionOf": ["ebwv:BanzNumber", "ebwv:Bic", "ebwv:CertificateRegistrationNumber", "ebwv:ClearingNumber", "ebwv:CompanyId", "ebwv:DunsNumber", "ebwv:Eori", "ebwv:Excise", "ebwv:GlobalLocationNumber", "ebwv:IatfCertificateNumber", "ebwv:IatfUsi", "ebwv:Iban", "ebwv:Isin", "ebwv:Lei", "ebwv:MainCertificateRegistrationNumber", "ebwv:PeppolId", "ebwv:Tin", "ebwv:VatId", "xsd:anyURI", "xsd:string"]
        },
        "rdfs:label": "identifier",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/identifier", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:insolvencyStatus",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:KycLegalEntity",
        "rdfs:range": "xsd:string",
        "rdfs:label": "insolvency status",
