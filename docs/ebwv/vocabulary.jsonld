            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/ishighrisk", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:isTrust",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:KycLegalEntity",
        "rdfs:range": "xsd:boolean",
        "rdfs:label": "is trust",
        "rdfs:comment": {
            "@value": "<div>entity type indicator stating whether the entity is a trust</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/istrust", "https://w3id.org/ebwv#"],
