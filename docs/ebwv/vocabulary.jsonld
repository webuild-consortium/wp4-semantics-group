        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/countryofdeath", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:coverageStatement",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:SocialSecurityContribution",
        "rdfs:range": "xsd:string",
        "rdfs:label": "coverage statement",
        "rdfs:comment": {
            "@value": "<div>a human-readable statement describing the reporting scope covered by the attestation</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/coveragestatement", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:coveredObligationType",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:SocialSecurityContribution",
        "rdfs:range": "xsd:string",
        "rdfs:label": "covered obligation type",
        "rdfs:comment": {
            "@value": "<div>the type of obligation that is covered by the attestation; in the case of a SSC, this covers for example social security, employment-related contribution, reporting, or payment obligation</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/coveredobligationtype", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:currency",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": {
            "@type": "owl:Class",
            "owl:unionOf": ["ebwv:MonetaryAmount", "ebwv:PaymentTerms"]
        },
        "rdfs:range": "ebwv:Currency",
        "rdfs:label": "currency",
        "rdfs:comment": {
            "@value": "<div>a recognised monetary unit used to express prices, payments, liabilities, values, or other monetary amounts in a business, financial, administrative, or regulatory context</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/currency", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:dateOfBirth",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:NaturalPerson",
        "rdfs:range": "xsd:date",
        "rdfs:label": "date of birth",
        "rdfs:comment": {
            "@value": "<div>the point in time on which the person was born</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/dateofbirth", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:dateOfDeath",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:NaturalPerson",
        "rdfs:range": "xsd:date",
        "rdfs:label": "date of death",
        "rdfs:comment": {
            "@value": "<div>the calendar date on which a person is recorded or attested as having died</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/dateofdeath", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:dateOfRegistration",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": {
            "@type": "owl:Class",
            "owl:unionOf": ["ebwv:Company", "ebwv:LegalPerson"]
        },
        "rdfs:range": "xsd:date",
        "rdfs:label": "date of registration",
        "rdfs:comment": {
            "@value": "<div>the date on which the legal entity has registered in some jurisdiction for regulatory and / or for tax purposes</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/dateofregistration", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:deliveryLocation",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:PaymentTerms",
        "rdfs:range": ["ebwv:Location", "ebwv:Address"],
        "rdfs:label": "delivery location",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/deliverylocation", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:deliveryType",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:KycCheck",
        "rdfs:range": ["ebwv:DeliveryType", {
            "@type": "owl:class",
            "owl:oneOf": ["ebwv:ResearchedProduct", "ebwv:AbortedResearch"]
        }],
        "rdfs:label": "delivery type",
        "rdfs:comment": {
            "@value": "<div>states whether the delivery concerns a researched product or a research that was aborted</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/deliverytype", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:directParent",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:KycLegalEntity",
        "rdfs:range": {
            "@type": "ows:Class",
            "owl:unionOf": ["ebwv:LimitedLiabilityCompany", "ebwv:Partnership"]
        },
        "rdfs:label": "direct parent",
        "rdfs:comment": {
            "@value": "<div>the direct parent company of the focus legal entity</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/directparent", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:discrepancyReportNumber",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:TransparencyRegisterExtract",
        "rdfs:range": "xsd:string",
        "rdfs:label": "discrepancy report number",
        "rdfs:comment": {
            "@value": "<div>the transaction number of the discrepancy report (Unstimmigkeitsmeldung) at the transparency register</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/discrepancyreportnumber", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:dom10",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": {
            "@type": "owl:Class",
            "owl:unionOf": ["ebwv:ShareInFocus", "ebwv:BeneficialOwnership"]
        },
        "rdfs:range": {
            "@type": "ows:Class",
            "owl:unionOf": ["ebwv:ShareVotingPair", "ebwv:BeneficialOwnershipVariant"]
        },
        "rdfs:label": "domination 10% method",
        "rdfs:comment": {
            "@value": "<div>determined under the domination (Beherrschung) method with a 10 percent threshold (Grenze) - a holding is counted only along a chain in which controlling influence of at least 10 percent exists at every level, so that control passes through the chain to the focus entity</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/dom10", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:dom25",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": {
            "@type": "owl:Class",
            "owl:unionOf": ["ebwv:ShareInFocus", "ebwv:BeneficialOwnership"]
        },
        "rdfs:range": {
            "@type": "ows:Class",
            "owl:unionOf": ["ebwv:ShareVotingPair", "ebwv:BeneficialOwnershipVariant"]
        },
        "rdfs:label": "domination 25% method",
        "rdfs:comment": {
            "@value": "<div>determined under the domination (Beherrschung) method with a 25 percent threshold (Grenze) - a holding is counted only along a chain in which controlling influence of at least 25 percent exists at every level, so that control passes through the chain to the focus entity</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/dom25", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:domicile",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": {
            "@type": "owl:Class",
            "owl:unionOf": ["ebwv:NaturalPerson", "ebwv:KycLegalEntity"]
        },
        "rdfs:range": "ebwv:Address",
        "rdfs:label": "domicile",
        "rdfs:comment": {
            "@value": "<div>At its core, a domicile address refers to the place where an individual has their fixed, permanent home and principal establishment, and to which they intend to return whenever they are absent. This is not merely a physical location but a legal concept that carries substantial weight in various legal and administrative contexts. For businesses, a domicile address is a registered address where the company is officially established and recognized by the authorities.</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/domicile", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:duration",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:WorkAssignment",
        "rdfs:range": "ebwv:PeriodOfTime",
        "rdfs:label": "duration",
        "rdfs:comment": {
            "@value": "<div>a temporal length representing how long an activity, status, validity period, assignment, mandate, process, event, or other time-bound condition lasts</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/duration", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:employee",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:EconomicOperator",
        "rdfs:range": "ebwv:NaturalPerson",
        "rdfs:label": "employee",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/employee", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:employer",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": {
            "@type": "owl:Class",
            "owl:unionOf": ["ebwv:A1Certificate", "ebwv:PostedWorkerNotification", "ebwv:SocialSecurityContribution"]
        },
        "rdfs:range": "ebwv:EconomicOperator",
        "rdfs:label": "employer",
        "rdfs:comment": {
            "@value": "<div>a party that engages a person to perform work under an employment relationship, with associated rights, duties, reporting obligations, or liabilities</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/employer", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:endDate",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": {
            "@type": "owl:Class",
            "owl:unionOf": ["ebwv:PeriodOfTime", "ebwv:Company"]
        },
        "rdfs:range": "xsd:date",
        "rdfs:label": "end date of period of time",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/endDate", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:entryDate",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:LegalRepresentative",
        "rdfs:range": "xsd:date",
        "rdfs:label": "entry date",
        "rdfs:comment": {
            "@value": "<div>the date on which the representative took up the function</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/entrydate", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:equityHolder",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": {
            "@type": "owl:Class",
            "owl:unionOf": ["ebwv:KycLegalEntity", "ebwv:EquityHolder"]
        },
        "rdfs:range": "ebwv:EquityHolder",
        "rdfs:label": "equity holder",
        "rdfs:comment": {
            "@value": "<div>Any individual or entity that holds an ownership stake in a business. This includes public or private stockholders, sole proprietors, LLC members, and partnership owners. Not all equity holders own formal stock shares (for example, owners of a sole proprietorship or a general partnership).</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/equityholder", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:evidenceSource",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:EvidenceData",
        "rdfs:range": "xsd:string",
        "rdfs:label": "evidence source",
        "rdfs:comment": {
            "@value": "<div>the source used to verify the information</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/evidencesource", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:exchange",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:StockExchangeListing",
        "rdfs:range": "ebwv:StockExchange",
        "rdfs:label": "exchange",
        "rdfs:comment": {
            "@value": "<div>the stock exchange on which the legal entity is listed</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/exchange", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:exchangeCountry",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:StockExchange",
        "rdfs:range": "ebwv:CountryCode",
        "rdfs:label": "exchange country",
        "rdfs:comment": {
            "@value": "<div>the country of the stock exchange</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/exchangecountry", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:exchangeName",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:StockExchange",
        "rdfs:range": "xsd:string",
        "rdfs:label": "exchange name",
        "rdfs:comment": {
            "@value": "<div>the name of the stock exchange</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/exchangename", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:exitDate",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:LegalRepresentative",
        "rdfs:range": "xsd:date",
        "rdfs:label": "exit date",
        "rdfs:comment": {
            "@value": "<div>the date on which the representative left the function</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/exitdate", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:familyName",
        "@type": ["rdf:Property", "owl:DatatypeProperty"],
        "rdfs:domain": "ebwv:NaturalPerson",
        "rdfs:range": "xsd:string",
        "rdfs:label": "family name",
        "rdfs:comment": {
            "@value": "<div>the hereditary surname of a family</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/familyname", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
        "@id": "ebwv:fictitiousBeneficialOwner",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:BeneficialOwnershipVariant",
        "rdfs:range": "ebwv:BeneficialOwner",
        "rdfs:label": "fictitious beneficial owner",
        "rdfs:comment": {
            "@value": "<div>a fictitious (notional) beneficial owner (fiktiver wirtschaftlich Berechtigter) - where, after exhausting all available means, no natural person can be identified as beneficial owner by capital, voting rights or other control, the legal representatives, managing partners or managing directors of the focus legal entity are deemed to be the beneficial owners (section 3(2) sentence 5 GwG)</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
        },
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/fictitiousbeneficialowner", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
