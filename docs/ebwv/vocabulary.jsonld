        "rdfs:label": "lei registration status",
        "rdfs:isDefinedBy": ["https://sanastot.suomi.fi/en/terminology/webuild/concept/leiregistrationstatus", "https://w3id.org/ebwv#"],
        "vs:term_status": "stable"
    }, {
