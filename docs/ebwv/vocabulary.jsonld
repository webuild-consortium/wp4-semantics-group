    }, {
        "@id": "ebwv:shareInFocusTotal",
        "@type": ["rdf:Property", "owl:ObjectProperty"],
        "rdfs:domain": "ebwv:Shareholder",
        "rdfs:range": "ebwv:ShareInFocus",
        "rdfs:label": "share in focus total",
