        "rdfs:domain": "ebwv:SocialSecurityContribution",
        "rdfs:range": "xsd:integer",
        "rdfs:label": "staff average",
        "rdfs:comment": {
            "@value": "<div>The average number of staff associated with the employer for the period or reference data used in a social security contribution attestation.</div>",
            "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
