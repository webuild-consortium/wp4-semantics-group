@prefix ebwv: <https://w3id.org/ebwv#> .
@prefix ebwsm: <https://w3id.org/ebwv/semantic-model#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@base <https://w3id.org/ebwv/semantic-model> .

<https://w3id.org/ebwv/semantic-model> rdf:type owl:Ontology ;
    owl:imports <http://www.w3.org/ns/prov#>,
        <https://w3id.org/ebwv/semantic-model/imports/dcterms-classes/2026-11-23> ;
    rdfs:comment "PROV-O is imported through the ontology IRI http://www.w3.org/ns/prov# recognised by Protege for the pinned 2013-04-30 local document. Its historical duplicate ontology headers cause a version-IRI import to load the file without joining the active import closure in the observed Protege session. The catalogue and manifest pin the same approved local copy, which removes only the duplicate annotation-property declarations for prov:wasRevisionOf and prov:specializationOf, retaining both as object properties. The original source and exact correction are recorded under semantics/imports. No class or property alignment between the extension and PROV-O is implied by the import."@en-GB ;
    rdfs:comment "The local Dublin Core class module is imported through the same catalogue so that all 22 dcterms classes and their eight mutual subclass relations are visible from this single working ontology. The module preserves source definitions and class IRIs but is a documented class-only OWL projection, not the full DCMI RDF schema. The unchanged source, exact projection and checksums are recorded under semantics/imports/dcterms. RDF metamodel statements and the source property definitions are outside this module. Importing it establishes no alignment with PROV-O."@en-GB ;
    rdfs:comment "Joint draft of the WEBUILD semantic model extension. Existing EBWV terms retain their published IRIs; new model terms use the ebwsm namespace. This Turtle file and the separate SHACL profile files are the authoritative sources for the extension. Meaningful domain branches are developed individually without a custom common root class. The referenced EBWV revision is a reuse baseline, not an OWL import: full import remains pending resolution of the upstream Turtle syntax error and validation of the complete dependency graph."@en-GB ;
    dcterms:source <https://github.com/webuild-consortium/wp4-semantics-group/blob/c34c0f810c1ba4155360a36c590c81f0ccd41c43/docs/ebwv/vocabulary.ttl> .

skos:prefLabel rdf:type owl:AnnotationProperty .
skos:altLabel rdf:type owl:AnnotationProperty .
dcterms:source rdf:type owl:AnnotationProperty .

# Definition annotations for the jointly developed model.
ebwsm:taxonomicDefinition rdf:type owl:AnnotationProperty ;
    skos:prefLabel "Taxonomic definition"@en-GB ;
    ebwsm:taxonomicDefinition "An annotation property that associates a term with its taxonomic definition, naming its meaningful superclass or superproperty and distinguishing characteristics, or with a base definition for a class without a meaningful superclass or a property without a meaningful superproperty."@en-GB .

ebwsm:legalDefinition rdf:type owl:AnnotationProperty ;
    skos:prefLabel "Legal definition"@en-GB ;
    ebwsm:taxonomicDefinition "An annotation property that associates a term with an optional definition quoted verbatim from relevant legislation or regulations."@en-GB .

ebwsm:businessDefinition rdf:type owl:AnnotationProperty ;
    skos:prefLabel "Business definition"@en-GB ;
    ebwsm:taxonomicDefinition "An annotation property that associates a term with an optional definition in everyday language."@en-GB .

# Local display label and source link for the imported Dublin Core interval.
# Its class declaration, definition and superclass come from the import.
dcterms:PeriodOfTime skos:prefLabel "Period of time"@en-GB ;
    dcterms:source <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/PeriodOfTime> .

# Reviewed augmentation of the existing EBWV Agent term. Its IRI is preserved;
# the declaration is for OWL tooling and does not load the upstream vocabulary.
ebwv:Agent rdf:type owl:Class ;
    rdfs:subClassOf dcterms:Agent ;
    skos:prefLabel "Agent"@en-GB ;
    ebwsm:taxonomicDefinition "An agent is a Dublin Core agent that can act, or be recognised as acting, as a social or legal actor within a business or legal process."@en-GB ;
    rdfs:comment "The adopted scope covers natural persons, organisations and other social or legal actors in business or legal processes. Inclusion of software agents requires a separate modelling decision. Classification as an Agent does not by itself assert a mandate or a representation right. The subclass axiom expresses the connection to the broader Dublin Core class; it does not assert class equivalence. The scope in this comment is explanatory and is not encoded as an additional OWL restriction."@en-GB ;
    dcterms:source <https://sanastot.suomi.fi/en/terminology/webuild/concept/concept-41>,
        <http://purl.org/dc/terms/Agent> .

# New extension classes with approved base definitions. No artificial named
# superclass is introduced solely to provide a taxonomic definition.
ebwsm:Role rdf:type owl:Class ;
    skos:prefLabel "Role"@en-GB ;
    ebwsm:taxonomicDefinition "A role is a context-dependent capacity that an entity can fulfil when participating in an activity, event, relationship, or situation."@en-GB ;
    rdfs:comment "A role is distinct from its player and from the time-bound fulfilment of that role. The player need not be an Agent; other entities may also fulfil roles. A role may exist without currently being fulfilled. In the adopted pattern the context belongs to the role, while the time interval qualifies the particular fulfilment. Having a role does not by itself establish authority to represent another party. The OJA reference informs this meaning without importing its FunctionalEntity hierarchy or SHACL requirements."@en-GB ;
    dcterms:source <https://w3id.org/ebwv/ebio#Role> .

ebwsm:RoleFulfillment rdf:type owl:Class ;
    skos:prefLabel "Role fulfilment"@en-GB ;
    ebwsm:taxonomicDefinition "A role fulfilment is the participation of a particular entity in a particular role during one continuous time interval."@en-GB ;
    rdfs:comment "The agreed conceptual pattern associates a fulfilment with one player, one role and one continuous interval represented by dcterms:PeriodOfTime. The context is obtained through the role rather than recorded a second time on the fulfilment. A later separate period of fulfilment is represented by a distinct fulfilment; an ended fulfilment remains a historical fact. The interval may have boundaries that are not yet known or explicitly recorded. Link properties, class-level OWL restrictions and the representation of interval boundaries remain to be agreed individually; the prose description alone does not enforce those relations or counts."@en-GB ;
    dcterms:source <https://www.w3.org/TR/swbp-n-aryRelations/> .
