<https://example.org/webuild/ontology> rdf:type owl:Ontology .

skos:prefLabel rdf:type owl:AnnotationProperty .
skos:altLabel rdf:type owl:AnnotationProperty .
dcterms:source rdf:type owl:AnnotationProperty .

# Definition annotations for the jointly developed model.
:taxonomicDefinition rdf:type owl:AnnotationProperty ;
    skos:prefLabel "Taxonomic definition"@en-GB ;
    :taxonomicDefinition "An annotation property that associates a term with its taxonomic definition, naming its meaningful superclass or superproperty and distinguishing characteristics, or with a base definition for a class without a meaningful superclass or a property without a meaningful superproperty."@en-GB .

:legalDefinition rdf:type owl:AnnotationProperty ;
    skos:prefLabel "Legal definition"@en-GB ;
    :taxonomicDefinition "An annotation property that associates a term with an optional definition quoted verbatim from relevant legislation or regulations."@en-GB .

:businessDefinition rdf:type owl:AnnotationProperty ;
    skos:prefLabel "Business definition"@en-GB ;
    :taxonomicDefinition "An annotation property that associates a term with an optional definition in everyday language."@en-GB .

