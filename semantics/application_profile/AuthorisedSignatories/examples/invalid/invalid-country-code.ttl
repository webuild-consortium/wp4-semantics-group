# Synthetic data for testing the Authorised Signatories draft.
@prefix ex: <https://example.org/fixtures/authorised-signatories/> .
@prefix ebwv: <https://w3id.org/ebwv#> .
@prefix ebwsm: <https://w3id.org/ebwv/semantic-model#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:attestation a ebwsm:AuthorizedSignatories ;
    ebwsm:hasLegalEntity ex:representedEntity ;
    ebwsm:hasAuthorizedPerson ex:signatory .

ex:representedEntity a ebwv:LegalEntity ;
    ebwsm:hasLegalPerson [
        a ebwv:LegalPerson ;
        ebwv:legalName "Example Registers Ltd" ;
        ebwv:legalForm "Limited company"
    ] ;
    ebwsm:hasLegalEntityIdentifier [
        a ebwv:LegalEntityIdentifier ;
        ebwsm:euid "EXAMPLE.000001"
    ] .

ex:signatory a ebwsm:AuthorizedPerson ;
    ebwsm:hasNaturalPerson [
        a ebwv:NaturalPerson ;
        ebwv:givenName "Alex" ;
        ebwv:familyName "Example" ;
        ebwv:dateOfBirth "1985-04-12"^^xsd:date
    ] ;
    ebwsm:hasSignatoryRole [
        a ebwsm:SignatoryRole ;
        ebwsm:representationType [ skos:notation "SOLE" ; skos:prefLabel "Sole"@en-GB ]
    ] ;
    ebwsm:hasBirthPlace [
        a ebwsm:Place ;
        ebwsm:locality "Example Borough" ;
        ebwsm:hasCountry ex:exampleCountry
    ] ;
    ebwsm:hasCitizenshipCountry [ skos:notation "NL" ; skos:prefLabel "Netherlands"@en-GB ] .

ex:exampleCountry skos:notation "NLD" ;
    skos:prefLabel "Netherlands"@en-GB .
