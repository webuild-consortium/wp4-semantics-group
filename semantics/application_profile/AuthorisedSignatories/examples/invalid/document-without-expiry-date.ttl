# Synthetic data for testing the Authorised Signatories draft.
@prefix ex: <https://example.org/fixtures/authorised-signatories/> .
@prefix ebwv: <https://w3id.org/ebwv#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:attestation a ebwv:AuthorizedSignatories ;
    ebwv:hasLegalEntity ex:representedEntity ;
    ebwv:hasAuthorizedPerson ex:signatory, ex:secondSignatory .

ex:representedEntity a ebwv:LegalEntity ;
    ebwv:hasLegalPerson [
        a ebwv:LegalPerson ;
        ebwv:legalName "Example Registers Ltd" ;
        ebwv:legalForm "Limited company"
    ] ;
    ebwv:hasLegalEntityIdentifier [
        a ebwv:LegalEntityIdentifier ;
        ebwv:euid "EXAMPLE.000001" ;
        ebwv:lei "00000000000000000000" ;
        ebwv:taxIdentifier "EXAMPLE-TAX-01"
    ] .

ex:signatory a ebwv:AuthorizedPerson ;
    ebwv:hasNaturalPerson [
        a ebwv:NaturalPerson ;
        ebwv:givenName "Alex" ;
        ebwv:familyName "Example" ;
        ebwv:dateOfBirth "1985-04-12"^^xsd:date
    ] ;
    ebwv:hasSignatoryRole [
        a ebwv:SignatoryRole ;
        ebwv:roleName "Director" ;
        ebwv:representationType ex:jointRepresentation
    ] ;
    ebwv:hasBirthPlace [
        a ebwv:Place ;
        ebwv:locality "Example Borough" ;
        ebwv:hasCountry ex:exampleCountry ;
        ebwv:hasRegion [ skos:notation "SYNTHETIC_REGION" ; skos:prefLabel "Example region"@en-GB ]
    ] ;
    ebwv:hasCitizenshipCountry ex:exampleCountry ;
    ebwv:hasIdentifyingDocument ex:identityDocument .

ex:secondSignatory a ebwv:AuthorizedPerson ;
    ebwv:hasNaturalPerson [
        a ebwv:NaturalPerson ;
        ebwv:givenName "Sam" ;
        ebwv:familyName "Sample" ;
        ebwv:dateOfBirth "1981-06-17"^^xsd:date
    ] ;
    ebwv:hasSignatoryRole [
        a ebwv:SignatoryRole ;
        ebwv:representationType ex:jointRepresentation
    ] ;
    ebwv:hasBirthPlace [
        a ebwv:Place ;
        ebwv:locality "Sample Town" ;
        ebwv:hasCountry ex:exampleCountry
    ] ;
    ebwv:hasCitizenshipCountry ex:exampleCountry .

ex:jointRepresentation skos:notation "JOINT" ;
    skos:prefLabel "Joint"@en-GB .

ex:identityDocument a ebwv:IdentifyingDocument ;
    ebwv:documentNumber "EXAMPLE-DOC-01" ;
    ebwv:documentType [ skos:notation "SYNTHETIC_ID" ; skos:prefLabel "Sample identity document"@en-GB ] ;
    ebwv:issuingCountry ex:exampleCountry .

ex:exampleCountry skos:notation "NLD" ;
    skos:prefLabel "Netherlands"@en-GB .
