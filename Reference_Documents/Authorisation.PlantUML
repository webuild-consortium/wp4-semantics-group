@startuml
title General Authorisation Model

'#############################################
'#              Classes                      #
'#############################################

class AssignmentRule {
 +name: string
 +operator: [AND, OR, NOT, NULL]
 +hasSubrule:
 +authorisee:
 +jointType: ENUM [Alone, All, Majority,
 At Least x of y]
 +requiredNumberOfAuthorisees: Integer
 +totalNumberOfGranteesInRule: Integer
}

class "AssignmentRule\n<size:11><color:gray><i>Alias1</i></color></size>" as AssignmentRule_

class Authorisation {
 +dct:identifier: uri
 *dct:title: Literal
 *entityConcerned:
 *dct:temporal:
 *hasLegalBasisIn:
 *authorisationRule:
 +hasSupportingInvolvementOf:
 +status: ENUM [active, inactive]
 *dateOfIssue: date
 +type: Skos Concept
 +replaces:
 +delegable: [Y/N]
 *hasRule:
 +isDocumentedIn: uri
 +hasScope:
}

class "Authorisation\n<size:11><color:gray><i>Alias1</i></color></size>" as Authorisation_

class AuthorisationRule {
 +name: string
 +operator: [AND, OR, NOT, NULL]
 hasSubrule:
 *authoriser:
}

class "AuthorisationRule\n<size:11><color:gray><i>Alias1</i></color></size>" as AuthorisationRule_

class Authority {

}

class By'Law {
 *hasApplicableLaw:
}

class CodeListReference {
 *listIdentifier: string
 *listVersion: string
 *entryCode: string
 +label: string
 +uri: uri
}

class IdentificationDocument {
 *number: string
 *name: string
 +type: CodeListReference
}

class "IdentificationDocument\n<size:11><color:gray><i>Alias1</i></color></size>" as IdentificationDocument_

class Involvement {
 *involvementType: CodeListReference
 *involvementRole:
 *dct:temporal:
 *member:
 +hasPosition:
 +organisation:
}

class "Involvement\n<size:11><color:gray><i>Alias1</i></color></size>" as Involvement_

class "Involvement\n<size:11><color:gray><i>Alias2</i></color></size>" as Involvement__

class "Involvement\n<size:11><color:gray><i>Alias3</i></color></size>" as Involvement___

class "Involvement\n<size:11><color:gray><i>Alias4</i></color></size>" as Involvement____

class Jurisdiction {
}

class Law {
 *hasJurisdiction: 
 *code: string
 *name: string
 *authority:
}

class LegalBasis {
' Legal Basis is a Role that the law or an other
' authorisation gan give.
 +hasApplicableLaw:
 +hasApplicableAuthorisation:
 +isInfluencedBy:
}

class "LegalBasis\n<size:11><color:gray><i>Alias1</i></color></size>" as LegalBasis_

class Machine {
 *id: url
 +name: string
}

class "Machine\n<size:11><color:gray><i>Alias1</i></color></size>" as Machine_

class Operator {
 +name: string
 *operation: [AND,OR, XOR, NULL]
 +hasRule:
}

class "Operator\n<size:11><color:gray><i>Alias1</i></color></size>" as Operator_

class  Organisation {
 *legalName: string
 +registryNumber: string
 *EUID: identifier
 pattern: "^[A-Z]{2}[A-Z]{3}\\.
 [a-zA-Z0-9]+\\.[a-zA-Z0-9]+$"
}

class "Organisation\n<size:11><color:gray><i>Alias1</i></color></size>" as Organisation_

class PeriodOfTime {
 +startDate: date
 +endDate: date
}

class "PeriodOfTime\n<size:11><color:gray><i>Alias1</i></color></size>" as PeriodOfTime_

class Person {
 *nameFirst: string
 *nameLast: string
 +title: string
 +dateOfBirth: date
 +placeOfBirth: CodeListReference
 +fullAdress:
 +identificationDocument:
}

class "Person\n<size:11><color:gray><i>Alias1</i></color></size>" as Person_

class "Person\n<size:11><color:gray><i>Alias2</i></color></size>" as Person__

class Position {
 *name: CodeListReference
 *inOrganisation:
 +reportsTo:
}

class "Position\n<size:11><color:gray><i>Alias1</i></color></size>" as Position_

class "Position\n<size:11><color:gray><i>Alias2</i></color></size>" as Position__

class Presidence {
 +name:
 *description: string
 *hasJurisdiction:
 *influences:
}

'class PrivateEvaluationDefinition {
' *identifier: uri
' *serviceEndpoint: uri
' *checkDefinition: uri
' *evaluatedBy:
'}

'class PrivateRestrictionResult {
' *restriction:
' *transactionIdentifier: uri
' *evaluationDefinition:
' *outcome: ENUM [satisfied, not satisfied, undetermined]
'}

class Restriction {
 +evaluationMode: ENUM [Local, Private]
 +inputDefinition: uri
 +privateEvaluationDefinition:
 *operator: [!=, <, <=, =, >=, >, AND, OR, NOT]
 +value: [Literal or CodeListReference]
 +unit: [Unit or CodeListReference]
 +hasSubrestriction:
 }
 
class "Restriction\n<size:11><color:gray><i>Alias1</i></color></size>" as Restriction_

class "Restriction\n<size:11><color:gray><i>Alias2</i></color></size>" as Restriction__

class Role {
 *name: CodeListReference
 *dct:temporal:
}

class "Role\n<size:11><color:gray><i>Alias1</i></color></size>" as Role_

class "Role\n<size:11><color:gray><i>Alias2</i></color></size>" as Role__

class "Role\n<size:11><color:gray><i>Alias3</i></color></size>" as _Role

class Rule {
 *isApplicableWhithin:
 *isDerivedFrom:
 +hasPart:
}

class "Rule\n<size:11><color:gray><i>Alias1</i></color></size>" as Rule_

class Scope {
 *title: string
 +hasRestriction:[operator in subproperty]
}

class Unit {
 *exponent: RestrictionValue
 *unit: CodeListReference
 }

class "Unit\n<size:11><color:gray><i>Alias1</i></color></size>" as Unit_

class Entity {
 *mandatory
 +optional
}

'#############################################
'#              Code lists                   #
'#############################################

class "CodeList:eService\n<size:11><color:gray><i>Allowed eService codes based on service provider.</i></color></size>" as eService {
  <font:monospaced><color:gray>code   definition</color></font>
  --
  <font:monospaced>2026.Q2  stating 2026 Q3 VAT</font>
  <font:monospaced>2026     stating 2026 revenue</font>
  <font:monospaced>ALL      state all taxex</font>
}

class "CodeList:identificationDocumentType\n<size:11><color:gray><i>Document types aligned with ICAO Doc 9303 MRTD categories.</i></color></size>" as identificationDocumentType {
  <font:monospaced><color:gray>code      definition</color></font>
  --
  <font:monospaced>PASSPORT  Machine readable passport</font>
  <font:monospaced>ID_CARD   Machine readable official travel document</font>
  <font:monospaced>VISA      Machine readable visa</font>
  <font:monospaced>EMERGENCY Emergency travel document</font>
}

class "CodeList:involvementType\n<size:11><color:gray><i>Involvement types per context.</i></color></size>" as involvementType {
  <font:monospaced><color:gray>code  definition</color></font>
  --
  <font:monospaced>01    Board Appointment</font>
  <font:monospaced>02    Employment</font>
  <font:monospaced>03    Freelancer Engagement</font>
  <font:monospaced>04    Contractor Engagement</font>
  <font:monospaced>05    Subcontracting</font>
  <font:monospaced>06    Service Agreement</font>
}

class "CodeList:ISO4217:20215\n<size:11><color:gray><i>Allowed currency values.</i></color></size>" as ISO421720215 {
  <font:monospaced><color:gray>code  definition</color></font>
  --
  <font:monospaced>EUR   Euro</font>
  <font:monospaced>USD   United States Dollar</font>
  <font:monospaced>NOK   Norwegian krone</font>
  <font:monospaced>GBP   Pound sterling</font>
}

class "CodeList:ISO80000Unit\n<size:11><color:gray><i>Scientific unit symbols based on ISO/IEC 80000.</i></color></size>" as ISO80000Unit {
  <font:monospaced><color:gray>symbol  definition</color></font>
  --
  <font:monospaced>m       metre</font>
  <font:monospaced>s       second</font>
  <font:monospaced>kg      kilogram</font>
  <font:monospaced>N       newton</font>
  <font:monospaced>Pa      pascal</font>
  <font:monospaced>J       joule</font>
  <font:monospaced>W       watt</font>
}

class "CodeList:NACE\n<size:11><color:gray><i>Allowed economic activity codes based on NACE.</i></color></size>" as NACE {
  <font:monospaced><color:gray>code   definition</color></font>
  --
  <font:monospaced>01.11  Growing of cereals, leguminous crops and oil seeds</font>
  <font:monospaced>62.01  Computer programming activities</font>
  <font:monospaced>64.19  Other monetary intermediation</font>
}

class "CodeList:SpacialExtent\n<size:11><color:gray><i>Allowed regions codes based on\n<size:11><color:gray><i>several ISO's or online published lists.</i></color></size>" as SpacialExtent {
  <font:monospaced><color:gray>code   definition</color></font>
  --
  <font:monospaced>NL  Netherlands (ISO3166-1 alpha2)</font>
  <font:monospaced>FR  Friesland (GIS standard)</font>
}

class "DataType:RestrictionValue\n<size:11><color:gray><i>Allowed numeric value types.</i></color></size>" as RestrictionValue{
  <font:monospaced><color:gray>type      example  definition</color></font>
  --
  <font:monospaced>integer   -2       whole number</font>
  <font:monospaced>decimal   3.14     exact decimal value</font>
  <font:monospaced>rational  1/3      exact fraction</font>
  <font:monospaced>string    Oslo     exact fraction</font>
}

'#############################################
'#             Relations                     #
'#############################################

AssignmentRule::authorisee "1" -right-> "0..n" Involvement_ #line:DarkRed;text:DarkRed
AssignmentRule::operator "1" -up-> "1" Operator_ #line:DarkRed;text:DarkRed
AssignmentRule::hasSubrule "1" -up-> "1" AssignmentRule_ #line:DarkRed;text:DarkRed
'

Authorisation::authorisationRule "1" -left-> "1..n" AuthorisationRule #line:DarkRed;text:White :_____
Authorisation::hasLegalBasisIn "1" -up-> "1..n" LegalBasis_ #line:DarkRed;text:DarkRed
Authorisation::hasScope "0..1" -down-> "1..n" Scope #line:DarkRed;text:DarkRed
Authorisation::isDocumentedIn "0..1" -down-> "1..n" Document #line:DarkRed;text:DarkRed
Authorisation::hasRule "1" -right-> "1" AssignmentRule #line:DarkRed;text:White :_____
Authorisation::temporal "1" -up-> "1" PeriodOfTime #line:DarkRed;text:White :_____
Authorisation::entityConcerned "1" -up-> "1..n" Involvement__ #line:DarkRed;text:White :_____
Authorisation::hasSupportingInvolvementOf "0..1" -up-> "1..n" Involvement___ #line:DarkRed;text:White :_____

AuthorisationRule::hasSubrule "1" -up-> "1..n" AuthorisationRule_ #line:DarkRed;text:DarkRed
AuthorisationRule::authoriser "1" -left-> "1..n" Involvement #line:DarkRed;text:DarkRed

By'Law::hasApplicableLaw "1" --> "1..n" Law::code #line:DarkRed;text:DarkRed

CodeListReference::uri "1" ..> "1" eService::code
CodeListReference::uri "1" ..> "1" identificationDocumentType::code
CodeListReference::uri "1" ..> "1" ISO421720215::code
CodeListReference::uri "1" ..> "1" ISO80000Unit::symbol
CodeListReference::uri "1" ..> "1" NACE::code
CodeListReference::uri "1" ..> "1" RestrictionValue::code
CodeListReference::uri "1" ..> "1" SpacialExtent::code
CodeListReference::uri "1" ..> "1" involvementType

CodeListReference::listIdentifier "1" <-left- "1" Involvement____ #line:DarkRed;text:DarkRed
CodeListReference::listIdentifier "1" <-left- "1" IdentificationDocument_ #line:DarkRed;text:DarkRed
CodeListReference::listIdentifier "1" <-right- "1" Person__ #line:DarkRed;text:DarkRed
CodeListReference::listIdentifier "1" <-right- "1" Restriction__ #line:DarkRed;text:DarkRed
CodeListReference::listIdentifier "1" <-left- "1" Role__ #line:DarkRed;text:DarkRed
CodeListReference::listIdentifier "1" <-left- "1" Unit_ #line:DarkRed;text:DarkRed
'CodeListReference::listIdentifier "1" <-left- "1" Involvement____ #line:DarkRed;text:DarkRed
'CodeListReference::listIdentifier "1" <-left- "1" Involvement____ #line:DarkRed;text:DarkRed

Involvement::involvementRole "1" -left-> "1" Role #line:DarkRed;text:DarkRed 
Involvement::dct "1" -left-> "0..1" PeriodOfTime_ #line:DarkRed;text:DarkRed
Involvement::hasPosition "1" -down-> "0..1" Position #line:DarkRed;text:DarkRed
Involvement::member "1" -down-> "0..1" Person  #line:DarkRed;text:DarkRed
Involvement::member "1" -down-> "0..1" Machine  #line:DarkRed;text:DarkRed
Involvement::organisation "1" -down-> "0..1" Organisation  #line:DarkRed;text:DarkRed
Involvement_ "1" -down-> "0..1" Position__ #line:DarkRed;text:DarkRed
Involvement_ "1" -down-> "0..1" Person_  #line:DarkRed;text:DarkRed
Involvement_ "1" -down-> "0..1" Machine_  #line:DarkRed;text:DarkRed
Involvement_ "1" -down-> "0..1" Organisation_  #line:DarkRed;text:DarkRed

Law  <|-- By'Law #line:DarkRed;text:White :_____
Law::authority "1" --> "1" Authority #line:DarkRed;text:White :__________
Law::hasJurisdiction "1" -up-> "1" Jurisdiction #line:DarkRed;text:White :_____
Law "1" <-up- "1" Rule::isApplicableWhithin #line:DarkRed;text:White :_____

LegalBasis -up-|> _Role #line:DarkRed;text:Darkred
LegalBasis::hasApplicableLaw "1" --> "0..n" Law #line:DarkRed;text:Darkred
LegalBasis::isInfluencedBy "1" --> "0..n" Presidence #line:DarkRed;text:Darkred
LegalBasis::hasApplicableAuthorisation "1"  -left-> "0..n" Authorisation_ #line:DarkRed;text:White :_____

Operator::hasRule -- AuthorisationRule::operator

Person::identificationDocument "1" -down-> "1" IdentificationDocument::number

Position::inOrganisation "1" -left-> "1" Organisation #line:DarkRed;text:DarkRed
Position::reportsTo "1" --> "1" Position_ #line:DarkRed;text:DarkRed

Presidence::hasJurisdiction "1" --> "1" Jurisdiction #line:DarkRed;text:Darkred

'PrivateEvaluationDefinition::evaluatedBy "0..n" -left-> "1" Organisation__ #line:DarkRed;text:DarkRed
'PrivateRestrictionResult::restriction "0..n" --> "1" Restriction #line:DarkRed;text:DarkRed
'PrivateRestrictionResult::evaluationDefinition "0..n" --> "1" PrivateEvaluationDefinition #line:DarkRed;text:DarkRed

'Restriction::privateEvaluationDefinition "0..n" --> "0..1" PrivateEvaluationDefinition #line:DarkRed;text:DarkRed
Restriction::hasSubrestriction "0..n" -left-> "0..n" Restriction_ #line:DarkRed;text:DarkRed
Restriction::unit "0..n" --> "0..n" Unit #line:DarkRed;text:DarkRed


Rule::isDerivedFrom "1" --> "1..n" LegalBasis #line:DarkRed;text:Darkred
Rule::hasPart "0..1" --> "1..n" Rule_ #line:DarkRed;text:Darkred

Scope::hasRestriction "0..n" -down-> "0..n" Restriction #line:DarkRed;text:DarkRed

'#############################################
'#                  Layout                   #
'#############################################

'AssignmentRule -down-> Document #line:White
Authority -right- By'Law #line:White
RestrictionValue -down- ISO80000Unit #line:White;text:White :_____
eService -down- identificationDocumentType #line:White;text:White :_____
Machine -right- Person #line:White
Rule -right- _Role #line:White
LegalBasis -right- Rule_ #line:White
Organisation -left- Unit #line:White
Restriction -down- CodeListReference #line:White
AuthorisationRule -left- Involvement #line:White
Organisation -down- Restriction #line:White

'#############################################
'#             Coloring                      #
'#############################################

class AssignmentRule #LightYellow;line:DarkRed;text:DarkRed
class Authorisation #LightYellow;line:DarkRed;text:DarkRed
class AuthorisationRule #LightYellow;line:DarkRed;text:DarkRed
class Authority #LightYellow;line:DarkRed;text:DarkRed
class By'Law #LightYellow;line:DarkRed;text:DarkRed
class CodeListReference #LightYellow;line:DarkRed;text:DarkRed
class Document #LightYellow;line:DarkRed;text:DarkRed
class EconomicOperator #LightYellow;line:DarkRed;text:DarkRed
class Entity #LightYellow;line:DarkRed;text:DarkRed
class IdentificationDocument #LightYellow;line:DarkRed;text:DarkRed
class Involvement #LightYellow;line:DarkRed;text:DarkRed
class Jurisdiction  #LightYellow;line:DarkRed;text:DarkRed
class Law #LightYellow;line:DarkRed;text:DarkRed
class LegalBasis #LightYellow;line:DarkRed;text:DarkRed
class Machine #LightYellow;line:DarkRed;text:DarkRed
class Organisation #LightYellow;line:DarkRed;text:DarkRed
class Operator #LightYellow;line:DarkRed;text:DarkRed
class PeriodOfTime #LightYellow;line:DarkRed;text:DarkRed
class Person #LightYellow;line:DarkRed;text:DarkRed
class Position #LightYellow;line:DarkRed;text:DarkRed
class Presidence #LightYellow;line:DarkRed;text:DarkRed
class Restriction #LightYellow;line:DarkRed;text:DarkRed
class PrivateEvaluationDefinition #LightYellow;line:DarkRed;text:DarkRed
class PrivateRestrictionResult #LightYellow;line:DarkRed;text:DarkRed
class Role #LightYellow;line:DarkRed;text:DarkRed
class Rule #LightYellow;line:DarkRed;text:DarkRed
class Scope #LightYellow;line:DarkRed;text:DarkRed
class Unit #LightYellow;line:DarkRed;text:DarkRed

class eService #CEEED0;line:285F17;text:285F17
class identificationDocumentType #CEEED0;line:285F17;text:285F17
class involvementType #CEEED0;line:285F17;text:285F17
class ISO421720215 #CEEED0;line:285F17;text:285F17
class ISO80000Unit #CEEED0;line:285F17;text:285F17
class NACE #CEEED0;line:285F17;text:285F17
class RestrictionValue #CEEED0;line:285F17;text:285F17
class SpacialExtent #CEEED0;line:285F17;text:285F17

hide circle

@enduml